<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>كشف حساب - <%= client.name %></title><%- include('document-styles') %></head><body>
<main class="document">
  <header class="document-header"><div class="brand"><img class="brand-logo" src="<%= logoDataUri %>" alt="الشعار"><div><h1 class="brand-title">نظام حسابات</h1><p class="brand-subtitle">إدارة المبيعات والحسابات والمخزون</p></div></div><div class="document-meta"><span class="document-kind">كشف حساب عميل</span><h2 class="document-title"><%= client.name %></h2><p class="document-date">حتى <%= printDate %></p></div></header>
  <h2 class="report-heading">ملخص الحساب</h2><p class="report-description">حركة المشتريات والمدفوعات مرتبة زمنيًا مع الرصيد بعد كل معاملة.</p>
  <section class="info-grid"><div class="info-card"><h3>بيانات العميل</h3><div class="info-row"><span class="info-label">الاسم</span><span class="info-value"><%= client.name %></span></div><div class="info-row"><span class="info-label">الهاتف</span><span class="info-value ltr"><%= toEnglishDigits(client.phone || '-') %></span></div><div class="info-row"><span class="info-label">العنوان / الملاحظات</span><span class="info-value"><%= client.address || client.notes || '-' %></span></div></div><div class="info-card"><h3>نطاق التقرير</h3><div class="info-row"><span class="info-label">من</span><span class="info-value"><%= firstTxDate %></span></div><div class="info-row"><span class="info-label">إلى</span><span class="info-value"><%= lastTxDate %></span></div><div class="info-row"><span class="info-label">عدد العمليات</span><span class="info-value"><%= invoices.length %> معاملة</span></div></div></section>
  <section class="stats-grid"><div class="stat-card warning"><small>إجمالي المشتريات</small><strong class="money"><%= formatCurrency(totalPurchases) %></strong></div><div class="stat-card success"><small>إجمالي المدفوعات</small><strong class="money"><%= formatCurrency(totalPayments) %></strong></div><div class="stat-card <%= currentBalance > 0 ? 'danger' : 'success' %>"><small>الرصيد المستحق</small><strong class="money"><%= formatCurrency(currentBalance) %></strong></div></section>
  <h3 class="section-title">سجل المعاملات</h3><div class="table-frame"><table><thead><tr><th>التاريخ</th><th>رقم المستند</th><th>النوع</th><th>البيان</th><th>العميل النهائي</th><th class="money">المبلغ</th><th class="money">الرصيد</th></tr></thead><tbody>
  <% if (!invoices.length) { %><tr><td colspan="7" class="empty-state">لا توجد معاملات مسجلة لهذا العميل</td></tr><% } %>
  <% invoices.forEach(invoice=>{ const decrease=invoice.type==='payment'||invoice.balanceEffect==='decrease'; const klass=invoice.type==='purchase'?'purchase':(invoice.type==='opening_balance'?'opening':(invoice.type==='adjustment'?'adjustment':'payment')); const label=invoice.type==='purchase'?'شراء':(invoice.type==='payment'?'دفعة':(invoice.type==='opening_balance'?'رصيد افتتاحي':'تسوية')); %>
    <tr><td><%= formatDate(invoice.date) %></td><td><span class="ltr"><%= invoice.invoiceCode || ('#'+invoice.id) %></span></td><td><span class="badge <%= klass %>"><%= label %></span></td><td><%= invoice.details || '-' %><% if(invoice.items&&invoice.items.length){ %><div class="item-detail"><% invoice.items.forEach(item=>{ %>• <%= item.item ? item.item.name : 'صنف' %> — <%= item.quantity %> <%= item.itemUnit ? item.itemUnit.name : '' %><br><% }); %></div><% } %></td><td><%= invoice.endClientName || '-' %></td><td class="money <%= decrease ? 'text-success' : '' %>"><%= decrease ? '−' : '' %><%= formatCurrency(invoice.amount) %></td><td class="money <%= invoice.runningBalance > 0 ? 'text-danger' : 'text-success' %>"><%= formatCurrency(invoice.runningBalance) %></td></tr>
  <% }); %></tbody></table></div>
  <div class="summary-grid"><div class="note-box"><strong>ملاحظة محاسبية</strong>الرصيد الموجب يمثل مبلغًا مستحقًا في ذمة العميل، والرصيد السالب يمثل مبلغًا لصالحه.</div><div class="totals-box"><div class="total-row"><span>إجمالي المشتريات</span><strong class="money"><%= formatCurrency(totalPurchases) %></strong></div><div class="total-row"><span>إجمالي المدفوعات</span><strong class="money"><%= formatCurrency(totalPayments) %></strong></div><div class="total-row grand"><span>الرصيد الختامي</span><span class="money"><%= formatCurrency(currentBalance) %></span></div></div></div>
  <div class="signatures"><div class="signature">توقيع العميل</div><div class="signature">اعتماد الحسابات</div></div>
  <footer class="document-footer"><span>كشف حساب صادر من نظام حسابات</span><span>تاريخ التقرير: <%= printDate %></span></footer>
</main></body></html>
