<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>قائمة العملاء</title><%- include('document-styles') %></head><body>
<main class="document">
  <header class="document-header"><div class="brand"><img class="brand-logo" src="<%= logoDataUri %>" alt="الشعار"><div><h1 class="brand-title">نظام حسابات</h1><p class="brand-subtitle">إدارة المبيعات والحسابات والمخزون</p></div></div><div class="document-meta"><span class="document-kind">تقرير العملاء</span><h2 class="document-title">قائمة العملاء</h2><p class="document-date">تاريخ التقرير: <%= printDate %></p></div></header>
  <h2 class="report-heading">نظرة عامة على أرصدة العملاء</h2><p class="report-description">ملخص جاهز للطباعة والمتابعة، مرتب حسب اسم العميل.</p>
  <section class="stats-grid"><div class="stat-card"><small>إجمالي العملاء</small><strong><%= clients.length %></strong></div><div class="stat-card danger"><small>إجمالي الديون المستحقة</small><strong class="money"><%= formatCurrency(totalDebt) %></strong></div><div class="stat-card success"><small>عملاء رصيدهم مسدد أو دائن</small><strong><%= clearClientsCount %></strong></div></section>
  <h3 class="section-title">تفاصيل العملاء</h3><div class="table-frame"><table><thead><tr><th class="center">#</th><th>اسم العميل</th><th>رقم الهاتف</th><th>آخر معاملة</th><th class="money">الرصيد الحالي</th><th>الحالة</th></tr></thead><tbody>
  <% if (!clients.length) { %><tr><td colspan="6" class="empty-state">لا يوجد عملاء مسجلون</td></tr><% } %>
  <% clients.forEach((client,index)=>{ %><tr><td class="center"><%= index+1 %></td><td><strong><%= client.name %></strong></td><td><span class="ltr"><%= client.phone || '-' %></span></td><td><%= formatDate(client.updatedAt || client.createdAt) %></td><td class="money <%= client.balance > 0 ? 'text-danger' : 'text-success' %>"><%= formatCurrency(client.balance) %></td><td><span class="badge <%= client.balance > 0 ? 'purchase' : 'payment' %>"><%= client.balance > 0 ? 'مستحق' : (client.balance < 0 ? 'له رصيد' : 'مسدد') %></span></td></tr><% }); %>
  </tbody></table></div>
  <div class="note-box" style="margin-top:16px;min-height:0"><strong>طريقة قراءة التقرير</strong>الرصيد الموجب مبلغ مستحق على العميل، والرصيد السالب مبلغ لصالح العميل.</div>
  <footer class="document-footer"><span>تقرير العملاء — نظام حسابات</span><span>تم الإنشاء في <%= printDate %></span></footer>
</main></body></html>
