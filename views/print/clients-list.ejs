<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8">
    <title>قائمة العملاء</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Tahoma, 'Arial', 'Cairo', 'Tajawal', sans-serif; background: #ffffff; color: #141b2b; direction: rtl; text-align: right; padding: 24px; font-size: 13px; line-height: 1.5; }
        .container { max-width: 900px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #006840; padding-bottom: 16px; margin-bottom: 20px; }
        .brand-title { font-size: 22px; font-weight: 800; color: #006840; }
        .brand-subtitle { font-size: 12px; color: #585f6c; margin-top: 2px; }
        .doc-meta { text-align: left; font-size: 12px; color: #585f6c; }
        .doc-title-badge { background: #006840; color: #ffffff; font-size: 14px; font-weight: 700; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 6px; }
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; }
        .stat-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; text-align: center; }
        .stat-label { font-size: 11px; color: #64748b; margin-bottom: 4px; }
        .stat-val { font-size: 15px; font-weight: 800; color: #006840; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
        th { background: #006840; color: #ffffff; padding: 10px 12px; font-weight: 700; text-align: right; border: 1px solid #006840; }
        td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; border-x: 1px solid #f1f5f9; color: #334155; }
        tr:nth-child(even) { background-color: #f8fafc; }
        .text-debt { color: #ba1a1a; font-weight: 700; }
        .text-clear { color: #006840; font-weight: 700; }
        .footer { margin-top: 30px; text-align: center; font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div>
                <div class="brand-title">نظام حسابات</div>
                <div class="brand-subtitle">تقرير قائمة العملاء والأرصدة الحالية</div>
            </div>
            <div class="doc-meta">
                <div class="doc-title-badge">قائمة العملاء</div>
                <div>تاريخ التقرير: <%= printDate %></div>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">إجمالي عدد العملاء</div>
                <div class="stat-val"><%= clients.length %> عميل</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">إجمالي الديون المستحقة</div>
                <div class="stat-val text-debt"><%= formatCurrency(totalDebt) %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">العملاء الخاليين من الديون</div>
                <div class="stat-val text-clear"><%= clearClientsCount %> عميل</div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 30%;">اسم العميل</th>
                    <th style="width: 20%;">رقم الهاتف</th>
                    <th style="width: 25%;">الرصيد الحالي</th>
                    <th style="width: 20%;">تاريخ الإضافة</th>
                </tr>
            </thead>
            <tbody>
                <% clients.forEach((c, idx) => { %>
                    <tr>
                        <td><%= idx + 1 %></td>
                        <td style="font-weight: 700; color: #0f172a;"><%= c.name %></td>
                        <td dir="ltr" style="text-align: right;"><%= c.phone || '-' %></td>
                        <td class="<%= c.balance > 0 ? 'text-debt' : 'text-clear' %>">
                            <%= c.balance > 0 ? ('عليه ' + formatCurrency(c.balance)) : (c.balance < 0 ? ('له ' + formatCurrency(Math.abs(c.balance))) : 'متسدد بالكامل') %>
                        </td>
                        <td><%= formatDate(c.createdAt) %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="footer">
            تم استخراج التقرير آلياً من نظام حسابات بتاريخ <%= printDate %>
        </div>
    </div>
</body>
</html>
