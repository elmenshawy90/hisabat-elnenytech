<style>
  @font-face { font-family:'Hisabat'; src:url('data:font/ttf;base64,<%= fontDataBase64 %>') format('truetype'); font-weight:400 500; }
  @font-face { font-family:'Hisabat'; src:url('data:font/ttf;base64,<%= boldFontDataBase64 %>') format('truetype'); font-weight:600 800; }
  :root { --brand:#006840;--brand-dark:#064f35;--brand-soft:#e8f3ee;--gold:#d9ad55;--ink:#17211d;--muted:#718078;--line:#dce5e0;--surface:#f8faf9;--danger:#a33131;--danger-soft:#fff1f0;--success:#087d51;--success-soft:#e8f5ef;--warning:#9a5e0a;--warning-soft:#fff4de; }
  *{box-sizing:border-box}html,body{margin:0;padding:0}body{direction:rtl;color:var(--ink);background:#e7ece9;font-family:'Hisabat',Tahoma,Arial,sans-serif;font-size:12px;line-height:1.55;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .document{position:relative;width:min(900px,calc(100% - 32px));min-height:1120px;margin:24px auto;padding:38px 42px 30px;overflow:hidden;background:#fff;box-shadow:0 14px 42px rgba(19,49,37,.14)}
  .document::before{position:absolute;inset:0 0 auto;height:7px;content:'';background:linear-gradient(90deg,var(--gold) 0 20%,var(--brand) 20% 100%)}
  .toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;width:min(900px,calc(100% - 32px));margin:20px auto 0;padding:10px 14px;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 5px 18px rgba(19,49,37,.08)}.toolbar-actions{display:flex;gap:8px}.toolbar button{padding:8px 14px;font:inherit;font-weight:700;cursor:pointer;border:0;border-radius:8px}.toolbar .primary{color:#fff;background:var(--brand)}.toolbar .secondary{color:var(--ink);background:var(--surface);border:1px solid var(--line)}
  .document-header{display:flex;align-items:flex-start;justify-content:space-between;gap:28px;padding-bottom:20px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:14px;min-width:0}.brand-logo{width:72px;height:72px;flex:0 0 72px;object-fit:contain}.brand-title{margin:0 0 3px;color:var(--brand-dark);font-size:22px;font-weight:800}.brand-subtitle{margin:0;color:var(--muted);font-size:11px}.document-meta{min-width:225px;text-align:left}.document-kind{display:inline-block;padding:6px 12px;color:var(--brand);background:var(--brand-soft);border-radius:7px;font-weight:700;font-size:11px}.document-title{margin:8px 0 2px;color:var(--ink);font-size:22px;font-weight:800}.document-date{margin:0;color:var(--muted);font-size:11px}
  .report-heading{margin:20px 0 2px;font-size:20px;font-weight:800}.report-description{margin:0 0 14px;color:var(--muted);font-size:11px}.section-title{display:flex;align-items:center;gap:8px;margin:20px 0 9px;color:var(--brand-dark);font-size:13px;font-weight:800}.section-title::before{width:4px;height:16px;content:'';background:var(--gold);border-radius:3px}
  .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.info-card{padding:13px 15px;background:var(--surface);border:1px solid var(--line);border-radius:11px}.info-card h3{margin:0 0 8px;color:var(--brand);font-size:12px;font-weight:800}.info-row{display:flex;justify-content:space-between;gap:14px;padding:3px 0}.info-label{color:var(--muted)}.info-value{font-weight:700;text-align:left}
  .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin:16px 0}.stat-card{padding:12px 13px;background:#fff;border:1px solid var(--line);border-radius:11px}.stat-card small{display:block;margin-bottom:5px;color:var(--muted);font-size:10px}.stat-card strong{display:block;font-size:16px;font-weight:800}.stat-card.warning{color:var(--warning);background:#fff9ed}.stat-card.success{color:var(--success);background:var(--success-soft)}.stat-card.danger{color:var(--danger);background:var(--danger-soft)}
  .table-frame{overflow:hidden;border:1px solid var(--line);border-radius:11px}table{width:100%;border-collapse:collapse;font-size:10.5px}thead{display:table-header-group}tr{break-inside:avoid;page-break-inside:avoid}th{padding:9px 8px;color:#fff;background:var(--brand);text-align:right;font-weight:700}td{padding:9px 8px;border-bottom:1px solid #e6ece9;vertical-align:middle}tbody tr:nth-child(even){background:var(--surface)}tbody tr:last-child td{border-bottom:0}.center{text-align:center}.money{direction:ltr;text-align:left;unicode-bidi:isolate;font-weight:700;white-space:nowrap}.ltr{direction:ltr;unicode-bidi:isolate;display:inline-block}.text-danger{color:var(--danger)}.text-success{color:var(--success)}
  .badge{display:inline-block;padding:3px 8px;border-radius:999px;font-size:9px;font-weight:800;white-space:nowrap}.badge.purchase{color:var(--warning);background:var(--warning-soft)}.badge.payment,.badge.adjustment{color:var(--success);background:var(--success-soft)}.badge.opening{color:#315a89;background:#eaf2fb}
  .summary-grid{display:grid;grid-template-columns:1fr 285px;gap:14px;margin-top:16px;break-inside:avoid}.note-box{min-height:100px;padding:13px;color:#637068;background:#fbfcfb;border:1px dashed #ccd8d2;border-radius:11px}.note-box strong{display:block;margin-bottom:5px;color:#36443d}.totals-box{padding:11px 14px;background:var(--surface);border:1px solid #cddbd4;border-radius:11px}.total-row{display:flex;justify-content:space-between;gap:12px;padding:5px 0;border-bottom:1px solid #e1e9e5}.total-row:last-child{border-bottom:0}.total-row.grand{padding-top:8px;color:var(--brand);font-size:15px;font-weight:800}.total-row.due{color:var(--danger);font-weight:800}.empty-state{padding:22px;color:var(--muted);text-align:center}
  .signatures{display:grid;grid-template-columns:1fr 1fr;gap:55px;margin:36px 0 18px;break-inside:avoid}.signature{padding-top:8px;color:var(--muted);text-align:center;border-top:1px solid #aebbb4}.document-footer{display:flex;justify-content:space-between;gap:15px;margin-top:22px;padding-top:10px;color:#89958f;border-top:1px solid var(--line);font-size:9.5px}.item-detail{margin-top:3px;color:var(--muted);font-size:9px}
  @media screen and (max-width:720px){.document{width:calc(100% - 16px);margin:8px;padding:28px 20px 24px}.toolbar{width:calc(100% - 16px);margin:8px}.document-header,.toolbar{align-items:stretch;flex-direction:column}.document-meta{min-width:0;text-align:right}.info-grid,.stats-grid,.summary-grid{grid-template-columns:1fr}.table-frame{overflow-x:auto}table{min-width:650px}}
  @media print{@page{size:A4;margin:10mm}body{background:#fff}.no-print{display:none!important}.document{width:100%;min-height:0;margin:0;padding:0;box-shadow:none;overflow:visible}.document::before{top:-10mm}.report-summary{margin-top:9px}.report-summary .note-box{min-height:70px;padding:9px 12px}.report-summary .totals-box{padding:7px 12px}.report-summary .total-row{padding:3px 0}}
</style>
