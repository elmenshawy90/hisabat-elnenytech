<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>سجل الفواتير</title><%- include('document-styles') %></head><body>
<main class="document">
  <header class="document-header"><div class="brand"><img class="brand-logo" src="<%= logoDataUri %>" alt="الشعار"><div><h1 class="brand-title">نظام حسابات</h1><p class="brand-subtitle">إدارة المبيعات والحسابات والمخزون</p></div></div><div class="document-meta"><span class="document-kind">تقرير مالي</span><h2 class="document-title">سجل الفواتير</h2><p class="document-date">تاريخ التقرير: <%= printDate %></p></div></header>
  <h2 class="report-heading">ملخص حركة الفواتير</h2><p class="report-description">المشتريات والمدفوعات والتسويات المسجلة في النظام.</p>
  <section class="stats-grid"><div class="stat-card warning"><small>إجمالي المشتريات</small><strong class="money"><%= formatCurrency(totalPurchases) %></strong></div><div class="stat-card success"><small>إجمالي المدفوعات</small><strong class="money"><%= formatCurrency(totalPayments) %></strong></div><div class="stat-card"><small>عدد المعاملات</small><strong><%= invoices.length %></strong></div></section>
  <h3 class="section-title">الفواتير والمعاملات</h3><div class="table-frame"><table><thead><tr><th>التاريخ</th><th>رقم المستند</th><th>العميل</th><th>النوع</th><th>التفاصيل</th><th class="money">المبلغ</th></tr></thead><tbody>
  <% if (!invoices.length) { %><tr><td colspan="6" class="empty-state">لا توجد فواتير أو معاملات</td></tr><% } %>
  <% invoices.forEach(invoice=>{ const klass=invoice.type==='purchase'?'purchase':(invoice.type==='opening_balance'?'opening':(invoice.type==='adjustment'?'adjustment':'payment')); const label=invoice.type==='purchase'?'شراء':(invoice.type==='payment'?'دفعة':(invoice.type==='opening_balance'?'رصيد افتتاحي':'تسوية')); %><tr><td><%= formatDate(invoice.date) %></td><td><span class="ltr"><%= invoice.invoiceCode || ('#'+invoice.id) %></span></td><td><strong><%= invoice.clientName %></strong></td><td><span class="badge <%= klass %>"><%= label %></span></td><td><%= invoice.details || '-' %></td><td class="money <%= invoice.type==='payment' || invoice.balanceEffect==='decrease' ? 'text-success' : '' %>"><%= invoice.type==='payment' || invoice.balanceEffect==='decrease' ? '−' : '' %><%= formatCurrency(invoice.amount) %></td></tr><% }); %>
  </tbody></table></div>
  <div class="summary-grid report-summary"><div class="note-box"><strong>معلومات التقرير</strong>يعرض التقرير كل المعاملات المسجلة، مع تمييز المشتريات والمدفوعات والتسويات بالألوان.</div><div class="totals-box"><div class="total-row"><span>إجمالي المشتريات</span><strong class="money"><%= formatCurrency(totalPurchases) %></strong></div><div class="total-row"><span>إجمالي المدفوعات</span><strong class="money"><%= formatCurrency(totalPayments) %></strong></div><div class="total-row grand"><span>صافي الحركة</span><span class="money"><%= formatCurrency(totalPurchases-totalPayments) %></span></div></div></div>
  <footer class="document-footer"><span>سجل الفواتير — نظام حسابات</span><span>تم الإنشاء في <%= printDate %></span></footer>
</main></body></html>
