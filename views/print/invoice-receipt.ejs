<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>فاتورة <%= invoice.invoiceCode || invoice.id %></title><%- include('document-styles') %></head><body>
<% const items=invoice.items||[]; const services=invoice.services||[]; const itemsTotal=items.reduce((sum,item)=>sum+(Number(item.lineTotal)||0),0); const servicesTotal=services.reduce((sum,item)=>sum+(Number(item.price)||0),0); const remaining=Math.max(0,(Number(invoice.amount)||0)-(Number(invoice.paidAmount)||0)); %>
<main class="document">
  <header class="document-header"><div class="brand"><img class="brand-logo" src="<%= logoDataUri %>" alt="الشعار"><div><h1 class="brand-title">نظام حسابات</h1><p class="brand-subtitle">إدارة المبيعات والحسابات والمخزون</p></div></div><div class="document-meta"><span class="document-kind"><%= invoice.type==='purchase'?'فاتورة مبيعات':(invoice.type==='payment'?'إيصال سداد':'مستند حساب') %></span><h2 class="document-title"><span class="ltr"><%= invoice.invoiceCode || ('#'+invoice.id) %></span></h2><p class="document-date">تاريخ الإصدار: <%= formatDate(invoice.date) %></p></div></header>
  <h3 class="section-title">بيانات الفاتورة</h3><section class="info-grid"><div class="info-card"><h3>بيانات العميل</h3><div class="info-row"><span class="info-label">اسم العميل</span><span class="info-value"><%= invoice.clientName %></span></div><div class="info-row"><span class="info-label">رقم الهاتف</span><span class="info-value ltr"><%= invoice.clientPhone || '-' %></span></div><div class="info-row"><span class="info-label">عنوان التوصيل</span><span class="info-value"><%= invoice.address || '-' %></span></div></div><div class="info-card"><h3>بيانات المعاملة</h3><div class="info-row"><span class="info-label">نوع المعاملة</span><span class="info-value"><%= invoice.type==='purchase'?'فاتورة شراء':(invoice.type==='payment'?'سداد دفعة':(invoice.type==='opening_balance'?'رصيد افتتاحي':'تسوية رصيد')) %></span></div><div class="info-row"><span class="info-label">طريقة الدفع</span><span class="info-value"><%= invoice.paymentMethod==='transfer'?'تحويل بنكي':'كاش / نقدي' %></span></div><div class="info-row"><span class="info-label">العميل النهائي</span><span class="info-value"><%= invoice.endClientName || '-' %></span></div></div></section>
  <% if(items.length){ %><h3 class="section-title">بنود الفاتورة</h3><div class="table-frame"><table><thead><tr><th class="center">الكمية</th><th>الوحدة</th><th>الصنف</th><th class="money">سعر الوحدة</th><th class="money">الإجمالي</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td class="center"><%= item.quantity %></td><td><%= item.itemUnit ? item.itemUnit.name : '-' %></td><td><strong><%= item.item ? item.item.name : 'صنف' %></strong></td><td class="money"><%= formatCurrency(item.unitPrice) %></td><td class="money"><%= formatCurrency(item.lineTotal) %></td></tr><% }); %></tbody></table></div><% } else { %><h3 class="section-title">بيان المعاملة</h3><div class="table-frame"><table><thead><tr><th>البيان</th><th class="money">المبلغ</th></tr></thead><tbody><tr><td><%= invoice.details || 'معاملة مالية' %></td><td class="money"><%= formatCurrency(invoice.amount) %></td></tr></tbody></table></div><% } %>
  <% if(services.length){ %><h3 class="section-title">خدمات إضافية</h3><div class="table-frame"><table><thead><tr><th>الخدمة</th><th class="money">القيمة</th></tr></thead><tbody><% services.forEach(service=>{ %><tr><td><strong><%= service.name %></strong></td><td class="money"><%= formatCurrency(service.price) %></td></tr><% }); %></tbody></table></div><% } %>
  <section class="summary-grid"><div class="note-box"><strong>ملاحظات</strong><%= invoice.notes || (invoice.details && invoice.details!=='-' ? invoice.details : 'لا توجد ملاحظات إضافية') %></div><div class="totals-box"><% if(items.length){ %><div class="total-row"><span>مجموع البنود</span><strong class="money"><%= formatCurrency(itemsTotal) %></strong></div><% } %><% if(servicesTotal>0){ %><div class="total-row"><span>الخدمات الإضافية</span><strong class="money"><%= formatCurrency(servicesTotal) %></strong></div><% } %><% if(invoice.discountAmount>0){ %><div class="total-row"><span>الخصم</span><strong class="money">−<%= formatCurrency(invoice.discountAmount) %></strong></div><% } %><div class="total-row grand"><span>الإجمالي المستحق</span><span class="money"><%= formatCurrency(invoice.amount) %></span></div><% if(invoice.paidAmount>0){ %><div class="total-row"><span>المدفوع</span><strong class="money"><%= formatCurrency(invoice.paidAmount) %></strong></div><div class="total-row due"><span>المتبقي</span><span class="money"><%= formatCurrency(remaining) %></span></div><% } %></div></section>
  <div class="signatures"><div class="signature">توقيع المستلم</div><div class="signature">توقيع المسؤول</div></div><footer class="document-footer"><span>تم إنشاء المستند إلكترونيًا بواسطة نظام حسابات</span><span>رقم المستند: <span class="ltr"><%= invoice.invoiceCode || invoice.id %></span></span></footer>
</main></body></html>
