}

async function submitItemForm(e) {
    e.preventDefault();
    const itemId = document.getElementById('itemModalId').value;
    const submitBtn = document.getElementById('submitItemBtn');
    const name = document.getElementById('itemName').value.trim();
    const notes = document.getElementById('itemNotes').value.trim();
    const priceVal = document.getElementById('itemDefaultPrice') ? document.getElementById('itemDefaultPrice').value.trim() : '';
    const defaultSellingPrice = priceVal !== '' && !isNaN(parseFloat(priceVal)) ? parseFloat(priceVal) : null;

    const rows = Array.from(document.querySelectorAll('#unitsRowsContainer .unit-row'));
    if (rows.length === 0) {
        showToast('يجب إدخال وحدة قياس واحدة على الأقل', 'warning');
        return;
    }

    const unitsPayload = [];
    const readUnitName = (row) => {
        const el = row.querySelector('.unit-name-input');
        const raw = el ? String(el.value || '').trim() : '';
        return raw === '__new__' ? '' : raw;
    };
    const baseUnitName = readUnitName(rows[0]);

    for (let idx = 0; idx < rows.length; idx++) {
        const row = rows[idx];
        const uId = row.dataset.unitId ? parseInt(row.dataset.unitId) : undefined;
        const uName = readUnitName(row);
        if (!uName) {
            showToast(`اختر اسم الوحدة للصف رقم ${idx + 1} من الكتالوج`, 'warning');
            return;
        }
        const radio = row.querySelector('.base-unit-radio');
        const isBase = radio ? radio.checked : (idx === 0);

        if (isBase) {
            unitsPayload.push({
                id: uId,
                name: uName,
                isBaseUnit: true,
                conversionRate: 1.0
            });
        } else {
            const select = row.querySelector('.unit-relative-select');
            const qtyInput = row.querySelector('.unit-qty-input');
            const targetIdx = select ? parseInt(select.value) || 0 : 0;
            const targetRow = rows[targetIdx];
            const targetName = targetRow ? readUnitName(targetRow) : baseUnitName;
            const userQty = parseFloat(qtyInput.value) || 0;

            // User entered: "1 [reference] = userQty [current unit]"
            // Backend expects relativeQuantity as the OLD meaning (fraction of reference)
            // So we invert: relativeQuantity = 1 / userQty
            const relQty = userQty > 0 ? (1 / userQty) : 0;

            unitsPayload.push({
                id: uId,
                name: uName,
                isBaseUnit: false,
                relativeToName: targetName,
                relativeToIndex: targetIdx,
                relativeQuantity: relQty
            });
        }
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري الحفظ...</span>';

    try {
        const isEdit = Boolean(itemId);
        const url = isEdit ? `/api/items/${itemId}` : '/api/items';
        const method = isEdit ? 'PUT' : 'POST';

        const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, notes, units: unitsPayload, defaultSellingPrice })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في حفظ بيانات الصنف');

        closeItemModal();
        showToast(isEdit ? 'تم تحديث بيانات الصنف بنجاح ✓' : `تم إضافة الصنف "${data.name}" بنجاح ✓`, 'success');
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في حفظ الصنف', 'error');
    } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span> <span>حفظ الصنف</span>';
    }
}

// ─── Restock Modal Logic ─────────────────────────────────────────
function openRestockModal(itemId) {
    const item = allItemsData.find(i => i.id === itemId);
    if (!item) return;

    currentRestockItemId = itemId;
    document.getElementById('restockItemName').textContent = item.name;

    const select = document.getElementById('restockUnitSelect');
    select.innerHTML = (item.units || []).map(u => {
        const rate = Number(u.conversionRate);
        const invertedRate = rate > 0 ? Number((1 / rate).toFixed(4)) : 0;
        return `<option value="${u.id}">${u.name} ${u.isBaseUnit ? '(الوحدة الأساسية)' : `(1 ${item.baseUnit?.name || ''} = ${invertedRate})`}</option>`;
    }).join('');

    // تعبئة قائمة الموردين النشطين (اختياري)
    const supplierSelect = document.getElementById('restockSupplierSelect');
    if (supplierSelect) {
        supplierSelect.innerHTML = '<option value="">-- بدون مورد محدد --</option>';
        fetch('/api/suppliers?activeOnly=true')
            .then(r => r.json())
            .then(json => {
                const list = json.data || [];
                list.forEach(s => {
                    supplierSelect.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                });
            })
            .catch(err => console.error('فشل جلب الموردين:', err));
    }

    document.getElementById('restockForm').reset();
    const modal = document.getElementById('restockModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeRestockModal() {
    const modal = document.getElementById('restockModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    currentRestockItemId = null;
}

async function submitRestock(e) {
    e.preventDefault();
    if (!currentRestockItemId) return;

    const submitBtn = document.getElementById('submitRestockBtn');
    const unitId = document.getElementById('restockUnitSelect').value;
    const quantity = document.getElementById('restockQuantity').value;
    const notes = document.getElementById('restockNotes').value;
    const supplierSel = document.getElementById('restockSupplierSelect');
    const supplierId = supplierSel && supplierSel.value ? supplierSel.value : undefined;
    const costEl = document.getElementById('restockTotalCost');
    const totalCost = costEl && costEl.value !== '' ? costEl.value : undefined;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري التوريد...</span>';

    try {
        const res = await fetch(`/api/items/${currentRestockItemId}/restock`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quantity, unitId, notes, supplierId, totalCost })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في إضافة التوريد');

        closeRestockModal();
        showToast((data && data.message ? data.message : 'تم توريد المخزون بنجاح') + ' ✓', 'success');
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في توريد المخزون', 'error');
    } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span> <span>حفظ التوريد</span>';
    }
}

// ─── Stock Log Modal Logic ───────────────────────────────────────
async function openStockLogModal(itemId) {
    const item = allItemsData.find(i => i.id === itemId);
    if (!item) return;

    document.getElementById('stockLogItemName').textContent = item.name;
    const tableBody = document.getElementById('stockLogTableBody');
    const emptyEl = document.getElementById('stockLogEmpty');

    tableBody.innerHTML = '<tr><td colspan="6" class="py-md text-center text-secondary">جاري تحميل حركة المخزون...</td></tr>';
    emptyEl.classList.add('hidden');

    const modal = document.getElementById('stockLogModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    try {
        const res = await fetch(`/api/items/${itemId}`);
        const data = await res.json();

        if (!res.ok) throw new Error(data.error || 'فشل في جلب سجل الحركة');

        const logs = data.stockLogs || [];
        const baseUnitName = data.baseUnit ? data.baseUnit.name : '';

        if (logs.length === 0) {
            tableBody.innerHTML = '';
            emptyEl.classList.remove('hidden');
            return;
        }

        const stockChangeTypeLabels = {
            'restock': 'توريد (شراء)',
            'sale': 'خصم بسبب بيع',
            'adjustment': 'تصحيح يدوي'
        };

        tableBody.innerHTML = logs.map(log => {
            let typeBadge = '';
            if (log.changeType === 'restock') {
                typeBadge = `<span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-bold text-[11px]">${stockChangeTypeLabels['restock']}</span>`;
            } else if (log.changeType === 'sale') {
                typeBadge = `<span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-bold text-[11px]">${stockChangeTypeLabels['sale']}</span>`;
            } else {
                typeBadge = `<span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px]">${stockChangeTypeLabels[log.changeType] || 'تصحيح يدوي'}</span>`;
            }

            const qtyVal = Number(log.quantityBase) || 0;
            const qtySign = qtyVal > 0 ? '+' : '';

            return `
                <tr class="hover:bg-surface-container-high/50">
                    <td class="px-md py-sm font-mono text-secondary">${formatDate(log.createdAt)}</td>
                    <td class="px-md py-sm">${typeBadge}</td>
                    <td class="px-md py-sm font-bold text-on-surface dir-ltr inline-block">${qtySign}${qtyVal} ${baseUnitName}</td>
                    <td class="px-md py-sm font-bold text-primary dir-ltr inline-block">${log.balanceAfter} ${baseUnitName}</td>
                    <td class="px-md py-sm font-bold text-on-surface">${log.supplier ? log.supplier.name : '-'}</td>
                    <td class="px-md py-sm text-secondary">${log.notes || '-'}</td>
                </tr>
            `;
        }).join('');

    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في جلب سجل الحركة', 'error');
    }
}

function closeStockLogModal() {
    const modal = document.getElementById('stockLogModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
}

// ─── Soft Delete / Toggle Active Logic ────────────────────────────
function promptToggleActive(itemId, willDeactivate) {
    const item = allItemsData.find(i => i.id === itemId);
    if (!item) return;

    pendingToggleItemId = itemId;
    const titleEl = document.getElementById('confirmModalTitle');
    const textEl = document.getElementById('confirmModalText');
    const btnText = document.getElementById('confirmToggleBtnText');
    const iconEl = document.getElementById('confirmModalIcon');
    const btn = document.getElementById('confirmToggleBtn');

    if (willDeactivate) {
        titleEl.textContent = `تعطيل الصنف "${item.name}"`;
        textEl.textContent = 'هل تريد تعطيل هذا الصنف؟ لن يظهر في قوائم الاختيار الجديدة، لكن سجله التاريخي سيبقى محفوظًا.';
        btnText.textContent = 'تأكيد التعطيل';
        iconEl.textContent = 'warning';
        btn.className = 'px-lg py-sm rounded-full bg-amber-600 text-white font-label-md hover:opacity-90 transition-opacity flex items-center gap-1 shadow-sm font-bold';
    } else {
        titleEl.textContent = `إعادة تفعيل الصنف "${item.name}"`;
        textEl.textContent = 'هل تريد إعادة تفعيل هذا الصنف ليظهر مجدداً في قوائم الاختيار المعاملات الجديدة؟';
        btnText.textContent = 'إعادة التفعيل';
        iconEl.textContent = 'restore';
        btn.className = 'px-lg py-sm rounded-full bg-green-600 text-white font-label-md hover:opacity-90 transition-opacity flex items-center gap-1 shadow-sm font-bold';
    }

    const modal = document.getElementById('confirmToggleModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeConfirmToggleModal() {
    const modal = document.getElementById('confirmToggleModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    pendingToggleItemId = null;
}

async function executeToggleActive() {
    if (!pendingToggleItemId) return;

    const confirmBtn = document.getElementById('confirmToggleBtn');
    const origBtnHtml = confirmBtn ? confirmBtn.innerHTML : '';
    if (confirmBtn) {
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري التنفيذ...</span>';
    }

    try {
        const res = await fetch(`/api/items/${pendingToggleItemId}`, {
            method: 'DELETE'
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في تغيير حالة الصنف');

        closeConfirmToggleModal();
        showToast(data.message || 'تم تحديث حالة الصنف بنجاح', 'success');
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تغيير حالة الصنف', 'error');
    } finally {
        if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = origBtnHtml;
        }
    }
}
</script>
</body>
</html>
