<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>سجل الديون - كتالوج الأصناف</title>
<meta name="description" content="إدارة كتالوج الأصناف ومخزون مواد البناء والوحدات الهرمية"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="js/tailwind-config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link href="css/styles.css" rel="stylesheet"/>
</head>
<body class="bg-background text-on-surface overflow-hidden max-w-[100vw]">
<!-- Shell Container -->
<div class="flex h-screen w-full">
<%- include('partials/aside', { active: 'items' }) %>
<!-- Main Content Area -->
<main class="flex-1 min-w-0 flex flex-col md:mr-64 h-full relative">

<!-- Page Canvas -->
<div class="flex-1 overflow-y-auto p-container-margin pb-24 md:pb-xl md:p-xl custom-scrollbar">
<%- include('partials/header', { title: 'الأصناف' }) %>

<!-- Content Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-md mb-xl">
    <div class="flex flex-col">
        <h2 class="font-headline-md text-headline-md text-on-surface font-bold">كتالوج الأصناف والمخزون</h2>
        <p class="font-body-md text-body-md text-secondary">إدارة الأصناف، وحدات القياس الهرمية التراكمية، وتوريد المخزون</p>
    </div>
    <div class="flex flex-wrap items-center gap-xs sm:gap-sm">
        <button onclick="openAddItemModal()" class="px-md py-sm bg-primary hover:bg-primary-container text-white rounded-full flex items-center justify-center gap-xs font-bold text-sm shadow-sm transition-all active:scale-95 cursor-pointer">
            <span class="material-symbols-outlined text-xl">add_box</span>
            <span>صنف جديد</span>
        </button>
    </div>
</div>

<!-- Stats Row -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-md mb-xl">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm">
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-secondary">إجمالي الأصناف</span>
            <span class="font-headline-md text-headline-md text-primary font-bold" id="statTotalItems">--</span>
        </div>
        <div class="w-12 h-12 rounded-lg bg-primary-fixed flex items-center justify-center text-on-primary-fixed">
            <span class="material-symbols-outlined">inventory_2</span>
        </div>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm">
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-secondary">أصناف بالمخزون</span>
            <span class="font-headline-md text-headline-md text-green-600 font-bold" id="statInStock">--</span>
        </div>
        <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            <span class="material-symbols-outlined">warehouse</span>
        </div>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm">
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-secondary">أصناف بها عجز/صفر</span>
            <span class="font-headline-md text-headline-md text-tertiary font-bold" id="statZeroStock">--</span>
        </div>
        <div class="w-12 h-12 rounded-lg bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed">
            <span class="material-symbols-outlined">warning</span>
        </div>
    </div>
</div>

<!-- Search & Controls Bar -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md mb-md shadow-sm flex flex-col md:flex-row items-center justify-between gap-md">
    <div class="relative w-full md:flex-1">
        <span class="material-symbols-outlined absolute right-md top-1/2 -translate-y-1/2 text-outline">search</span>
        <input class="w-full h-12 pr-12 pl-md rounded-xl bg-background border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none font-body-md text-body-md transition-all" placeholder="البحث باسم الصنف..." type="text" id="searchInput" oninput="debounceSearch()"/>
    </div>
    
    <!-- Show Inactive Toggle -->
    <label class="flex items-center gap-xs cursor-pointer select-none border border-outline-variant/70 bg-surface px-md py-sm rounded-xl hover:bg-surface-container transition-colors shrink-0">
        <input type="checkbox" id="showInactiveToggle" onchange="loadItems()" class="w-4 h-4 text-primary rounded border-outline focus:ring-primary" />
        <span class="text-xs font-bold text-on-surface">إظهار الأصناف المعطّلة</span>
    </label>
</div>

<!-- Items Table Container -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-2xl shadow-sm overflow-hidden mb-xl">
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant text-secondary font-label-md text-xs">
                    <th class="px-md py-md font-bold">اسم الصنف</th>
                    <th class="px-md py-md font-bold">الوحدة الأساسية</th>
                    <th class="px-md py-md font-bold">الوحدات المعرفة</th>
                    <th class="px-md py-md font-bold">رصيد المخزون الحالي</th>
                    <th class="px-md py-md font-bold text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody id="itemsTableBody" class="divide-y divide-outline-variant/60 font-body-md text-sm">
                <!-- Loaded via JS -->
            </tbody>
        </table>
    </div>
    <!-- Loading / Empty State -->
    <div id="itemsLoading" class="py-xl text-center text-secondary">
        <div class="flex flex-col items-center justify-center gap-sm">
            <div class="w-8 h-8 border-3 border-outline-variant border-t-primary rounded-full animate-spin"></div>
            <span>جاري تحميل الأصناف...</span>
        </div>
    </div>
    <div id="itemsEmpty" class="hidden py-xl text-center text-secondary space-y-xs">
        <span class="material-symbols-outlined text-4xl text-outline">inventory_2</span>
        <p class="font-bold">لا يوجد أصناف مسجلة</p>
        <p class="text-xs">اضغط على زر "صنف جديد" لإضافة أول صنف في الكتالوج.</p>
    </div>
</div>

</div>
</main>
</div>

<!-- Item Form Modal (Unified for Add & Edit) -->
<div class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/50 p-4" id="itemModal">
    <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-2xl p-lg space-y-md border border-outline-variant/60 max-h-[90vh] overflow-y-auto custom-scrollbar">
        <div class="flex items-center justify-between border-b border-outline-variant/60 pb-sm">
            <div class="flex items-center gap-sm text-primary">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl" id="itemModalIcon">add_box</span>
                </div>
                <h3 class="font-headline-sm font-bold text-on-surface" id="itemModalTitle">إضافة صنف جديد</h3>
            </div>
            <button type="button" onclick="closeItemModal()" class="text-secondary hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        
        <form id="itemForm" onsubmit="submitItemForm(event)" class="space-y-md">
            <input type="hidden" id="itemModalId" value="" />

            <div class="space-y-xs">
                <label class="block text-xs font-bold text-on-surface-variant">اسم الصنف <span class="text-error">*</span></label>
                <input type="text" id="itemName" required class="w-full h-11 px-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none text-right font-bold text-on-surface" placeholder="مثال: أسمنت مسيرة، حديد تسليح..." />
            </div>

            <div class="space-y-xs">
                <label class="block text-xs font-bold text-on-surface-variant">ملاحظات (اختياري)</label>
                <input type="text" id="itemNotes" class="w-full h-11 px-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none text-right text-on-surface" placeholder="أي تفاصيل أو مواصفات إضافية..." />
            </div>

            <div class="space-y-xs">
                <label class="block text-xs font-bold text-on-surface-variant">سعر البيع الافتراضي (بالوحدة الأساسية) (اختياري)</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline text-sm">payments</span>
                    <input type="number" step="any" min="0" id="itemDefaultPrice" class="w-full h-11 pr-9 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none text-right font-bold text-on-surface" placeholder="مثال: 150.00" />
                </div>
            </div>

            <!-- Stock Log Warning Banner when editing items with stock logs -->
            <div id="stockProtectedWarning" class="hidden bg-amber-500/10 border border-amber-500/30 text-amber-800 rounded-xl p-sm text-xs font-medium space-y-1">
                <div class="flex items-center gap-1 font-bold text-amber-900">
                    <span class="material-symbols-outlined text-base">lock</span>
                    <span>الوحدات القديمة مقفولة لحماية حركات المخزون</span>
                </div>
                <p>لا يمكن تعديل أو حذف الوحدات المستخدمة بالفعل في حركات مخزون سابقة حتى لا تتأثر الحسابات التاريخية. يمكنك إضافة وحدات جديدة فقط.</p>
            </div>

            <!-- Units Builder Section -->
            <div class="border border-outline-variant/80 rounded-xl p-md bg-surface-container-lowest space-y-sm">
                <div class="flex items-center justify-between border-b border-outline-variant/40 pb-xs">
                    <div>
                        <h4 class="font-bold text-sm text-on-surface">وحدات القياس الهرمية والنسبية</h4>
                        <p class="text-[11px] text-secondary">يمكنك تحديد أي صف كـ "الوحد الأساسية" وإجراء علاقات نسبية بين أي وحدتين بسهولة.</p>
                    </div>
                    <button type="button" onclick="addUnitRow()" class="px-sm py-1 bg-primary/10 hover:bg-primary text-primary hover:text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
                        <span class="material-symbols-outlined text-sm">add</span>
                        <span>إضافة وحدة</span>
                    </button>
                </div>

                <div id="unitsRowsContainer" class="space-y-xs pt-xs">
                    <!-- Dynamic unit rows rendered via JS -->
                </div>
            </div>

            <div class="flex items-center justify-end gap-sm pt-md border-t border-outline-variant/60">
                <button type="button" onclick="closeItemModal()" class="px-lg py-sm rounded-full border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors">إلغاء</button>
                <button type="submit" id="submitItemBtn" class="px-lg py-sm rounded-full bg-primary text-on-primary font-label-md hover:opacity-90 transition-opacity flex items-center gap-1 shadow-sm font-bold">
                    <span class="material-symbols-outlined text-sm">check</span>
                    <span>حفظ الصنف</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Restock Modal -->
<div class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/50 p-4" id="restockModal">
    <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-md p-lg space-y-md border border-outline-variant/60">
        <div class="flex items-center justify-between border-b border-outline-variant/60 pb-sm">
            <div class="flex items-center gap-sm text-green-700">
                <div class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">warehouse</span>
                </div>
                <h3 class="font-headline-sm font-bold text-on-surface">توريد مخزون جديد</h3>
            </div>
            <button type="button" onclick="closeRestockModal()" class="text-secondary hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form id="restockForm" onsubmit="submitRestock(event)" class="space-y-md">
            <p class="text-sm font-bold text-on-surface">
                الصنف: <span id="restockItemName" class="text-primary underline"></span>
            </p>

            <div class="space-y-xs">
                <label class="block text-xs font-bold text-on-surface-variant">اختيار الوحدة المُدخلة <span class="text-error">*</span></label>
                <select id="restockUnitSelect" required class="w-full h-11 px-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary outline-none text-right font-bold text-on-surface cursor-pointer">
                    <!-- Populated dynamically -->
                </select>
            </div>

            <div class="space-y-xs">
                <label class="block text-xs font-bold text-on-surface-variant">الكمية الموردة <span class="text-error">*</span></label>
                <input type="number" step="any" min="0.001" id="restockQuantity" required class="w-full h-11 px-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary outline-none text-right font-bold text-on-surface dir-ltr" placeholder="0.00" />
            </div>

            <div class="space-y-xs">
                <label class="block text-xs font-bold text-on-surface-variant">ملاحظات التوريد (اختياري)</label>
                <input type="text" id="restockNotes" class="w-full h-11 px-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary outline-none text-right text-on-surface" placeholder="اسم المورد، رقم الإذن..." />
            </div>

            <div class="flex items-center justify-end gap-sm pt-md border-t border-outline-variant/60">
                <button type="button" onclick="closeRestockModal()" class="px-lg py-sm rounded-full border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors">إلغاء</button>
                <button type="submit" id="submitRestockBtn" class="px-lg py-sm rounded-full bg-green-700 text-white font-label-md hover:opacity-90 transition-opacity flex items-center gap-1 shadow-sm font-bold">
                    <span class="material-symbols-outlined text-sm">check</span>
                    <span>حفظ التوريد</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Stock Log Modal -->
<div class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/50 p-4" id="stockLogModal">
    <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-3xl p-lg space-y-md border border-outline-variant/60 max-h-[85vh] flex flex-col">
        <div class="flex items-center justify-between border-b border-outline-variant/60 pb-sm shrink-0">
            <div class="flex items-center gap-sm text-primary">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">history</span>
                </div>
                <div>
                    <h3 class="font-headline-sm font-bold text-on-surface">سجل حركة المخزون</h3>
                    <p class="text-xs text-secondary">الصنف: <strong id="stockLogItemName" class="text-primary"></strong></p>
                </div>
            </div>
            <button type="button" onclick="closeStockLogModal()" class="text-secondary hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="overflow-y-auto custom-scrollbar flex-1 border border-outline-variant/60 rounded-xl">
            <table class="w-full text-right border-collapse text-xs">
                <thead class="sticky top-0 bg-surface-container-low border-b border-outline-variant text-secondary">
                    <tr>
                        <th class="px-md py-sm font-bold">التاريخ</th>
                        <th class="px-md py-sm font-bold">نوع الحركة</th>
                        <th class="px-md py-sm font-bold">الكمية (بالوحدة الأساسية)</th>
                        <th class="px-md py-sm font-bold">الرصيد بعدها</th>
                        <th class="px-md py-sm font-bold">ملاحظات</th>
                    </tr>
                </thead>
                <tbody id="stockLogTableBody" class="divide-y divide-outline-variant/40 font-body-md">
                    <!-- Logs populated via JS -->
                </tbody>
            </table>
            <div id="stockLogEmpty" class="hidden py-lg text-center text-secondary">
                لا توجد حركات مخزون مسجلة لهذا الصنف بعد.
            </div>
        </div>

        <div class="flex items-center justify-end pt-sm border-t border-outline-variant/60 shrink-0">
            <button type="button" onclick="closeStockLogModal()" class="px-lg py-sm rounded-full border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors">إغلاق</button>
        </div>
    </div>
</div>

<!-- Confirm Toggle Active Modal -->
<div class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/50 p-4" id="confirmToggleModal">
    <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-md p-lg space-y-md border border-outline-variant/60">
        <div class="flex items-center gap-sm text-amber-600 border-b border-outline-variant/60 pb-sm">
            <div class="w-10 h-10 rounded-full bg-amber-500/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl" id="confirmModalIcon">warning</span>
            </div>
            <h3 class="font-headline-sm font-bold text-on-surface" id="confirmModalTitle">تأكيد تعطيل الصنف</h3>
        </div>

        <p class="font-body-md text-on-surface text-sm leading-relaxed" id="confirmModalText">
            هل تريد تعطيل هذا الصنف؟ لن يظهر في قوائم الاختيار الجديدة، لكن سجله التاريخي سيبقى محفوظًا.
        </p>

        <div class="flex items-center justify-end gap-sm pt-md border-t border-outline-variant/60">
            <button type="button" onclick="closeConfirmToggleModal()" class="px-lg py-sm rounded-full border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors">إلغاء</button>
            <button type="button" id="confirmToggleBtn" onclick="executeToggleActive()" class="px-lg py-sm rounded-full bg-amber-600 text-white font-label-md hover:opacity-90 transition-opacity flex items-center gap-1 shadow-sm font-bold">
                <span class="material-symbols-outlined text-sm">check</span>
                <span id="confirmToggleBtnText">تأكيد التعطيل</span>
            </button>
        </div>
    </div>
</div>

<%- include('partials/bottom-nav', { active: 'items' }) %>
<script src="/js/shared-ui.js"></script>
<script>
let allItemsData = [];
let activeSearchTimeout = null;
let currentRestockItemId = null;
let pendingToggleItemId = null;
let currentItemHasStockLogs = false;

// Initialize Page
document.addEventListener('DOMContentLoaded', () => {
    checkAuth();
    loadItems();
});

function debounceSearch() {
    clearTimeout(activeSearchTimeout);
    activeSearchTimeout = setTimeout(() => {
        loadItems();
    }, 300);
}

async function loadItems() {
    const tableBody = document.getElementById('itemsTableBody');
    const loadingEl = document.getElementById('itemsLoading');
    const emptyEl = document.getElementById('itemsEmpty');
    const searchVal = document.getElementById('searchInput').value.trim();
    const showInactive = document.getElementById('showInactiveToggle').checked;

    loadingEl.classList.remove('hidden');
    emptyEl.classList.add('hidden');

    try {
        let url = `/api/items?includeInactive=${showInactive}`;
        if (searchVal) {
            url += `&search=${encodeURIComponent(searchVal)}`;
        }

        const res = await fetch(url);
        const json = await res.json();

        if (!res.ok) throw new Error(json.error || 'فشل في جلب الأصناف');

        allItemsData = json.data || [];

        updateStats(allItemsData);

        if (allItemsData.length === 0) {
            tableBody.innerHTML = '';
            loadingEl.classList.add('hidden');
            emptyEl.classList.remove('hidden');
            return;
        }

        tableBody.innerHTML = allItemsData.map(item => {
            const baseUnitName = item.baseUnit ? item.baseUnit.name : 'غير محددة';
            const isActive = item.isActive !== false;
            
            const unitsBadges = (item.units || []).map(u => {
                if (u.isBaseUnit) {
                    return `<span class="bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold text-[11px]">${u.name} (أساسية)</span>`;
                }
                const formattedRate = Number(u.conversionRate) < 1 ? u.conversionRate.toFixed(4) : u.conversionRate;
                return `<span class="bg-surface-container text-secondary px-2 py-0.5 rounded-full font-bold text-[11px]">${u.name} (${formattedRate} ${baseUnitName})</span>`;
            }).join(' ');

            const stockNum = Number(item.currentStock) || 0;
            const stockColorClass = stockNum > 0 ? 'text-green-600 font-bold' : (stockNum < 0 ? 'text-error font-bold' : 'text-secondary font-bold');
            
            const rowClass = isActive 
                ? 'hover:bg-primary/5 transition-colors' 
                : 'bg-surface-container-low/60 opacity-70 hover:opacity-100 transition-opacity';

            return `
                <tr class="${rowClass}">
                    <td class="px-md py-md">
                        <div class="flex flex-col">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-on-surface text-base">${item.name}</span>
                                ${!isActive ? `<span class="bg-slate-200 text-slate-700 font-bold px-2 py-0.5 rounded-full text-[10px]">معطّل</span>` : ''}
                            </div>
                            ${item.notes ? `<span class="text-xs text-secondary">${item.notes}</span>` : ''}
                        </div>
                    </td>
                    <td class="px-md py-md">
                        <span class="px-2 py-1 bg-primary-container text-on-primary-container rounded-lg font-bold text-xs">${baseUnitName}</span>
                    </td>
                    <td class="px-md py-md">
                        <div class="flex flex-wrap gap-1">
                            ${unitsBadges}
                        </div>
                    </td>
                    <td class="px-md py-md">
                        <span class="text-base dir-ltr inline-block ${stockColorClass}">${formatCurrency(stockNum).replace(' ج.م', '')} ${baseUnitName}</span>
                    </td>
                    <td class="px-md py-md">
                        <div class="flex items-center justify-center gap-1 flex-wrap">
                            ${isActive ? `
                                <button type="button" onclick="openRestockModal(${item.id})" class="px-2.5 py-1 bg-green-700 hover:bg-green-800 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1 shadow-xs cursor-pointer" title="توريد مخزون">
                                    <span class="material-symbols-outlined text-sm">warehouse</span>
                                    <span>توريد</span>
                                </button>
                            ` : ''}
                            <button type="button" onclick="openStockLogModal(${item.id})" class="px-2.5 py-1 bg-surface-container hover:bg-primary/10 text-secondary hover:text-primary rounded-lg text-xs font-bold transition-all flex items-center gap-1 cursor-pointer" title="عرض السجل">
                                <span class="material-symbols-outlined text-sm">history</span>
                                <span>السجل</span>
                            </button>
                            <button type="button" onclick="openEditItemModal(${item.id})" class="px-2.5 py-1 border border-outline-variant hover:bg-surface-container text-secondary rounded-lg text-xs font-bold transition-all cursor-pointer" title="تعديل">
                                <span class="material-symbols-outlined text-sm">edit</span>
                            </button>
                            ${isActive ? `
                                <button type="button" onclick="promptToggleActive(${item.id}, true)" class="px-2.5 py-1 border border-amber-500/40 text-amber-700 hover:bg-amber-500/10 rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="تعطيل الصنف">
                                    <span class="material-symbols-outlined text-sm">block</span>
                                    <span>تعطيل</span>
                                </button>
                            ` : `
                                <button type="button" onclick="promptToggleActive(${item.id}, false)" class="px-2.5 py-1 bg-green-600 hover:bg-green-700 text-white rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="إعادة تفعيل الصنف">
                                    <span class="material-symbols-outlined text-sm">restore</span>
                                    <span>تفعيل</span>
                                </button>
                            `}
                        </div>
                    </td>
                </tr>
            `;
        }).join('');

        loadingEl.classList.add('hidden');
    } catch (err) {
        console.error(err);
        loadingEl.classList.add('hidden');
        showToast(err.message || 'فشل في تحميل بيانات الأصناف', 'error');
    }
}

function updateStats(items) {
    document.getElementById('statTotalItems').textContent = items.length;
    const inStock = items.filter(i => (Number(i.currentStock) || 0) > 0).length;
    const zeroStock = items.filter(i => (Number(i.currentStock) || 0) <= 0).length;
    document.getElementById('statInStock').textContent = inStock;
    document.getElementById('statZeroStock').textContent = zeroStock;
}

// ─── Dynamic Relative Units Builder Logic ─────────────────────────────
function renderUnitsBuilder(units = [], isProtected = false) {
    const container = document.getElementById('unitsRowsContainer');
    container.innerHTML = '';

    if (!units || units.length === 0) {
        // Default initial 2 rows for fresh creation: Row 0 ("كيلو"), Row 1 ("شكارة")
        units = [
            { name: '', isBaseUnit: true, conversionRate: 1.0 },
            { name: '', isBaseUnit: false, conversionRate: 50.0 }
        ];
    }

    units.forEach((u, idx) => {
        appendUnitRowToDOM(u, idx, isProtected);
    });

    updateAllRelativeDropdownsAndPreviews();
}

