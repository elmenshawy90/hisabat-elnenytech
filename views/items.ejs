function openRestockModal(itemId) {
    const item = allItemsData.find(i => i.id === itemId);
    if (!item) return;

    currentRestockItemId = itemId;
    document.getElementById('restockItemName').textContent = item.name;

    const select = document.getElementById('restockUnitSelect');
    select.innerHTML = (item.units || []).map(u => {
        const formattedRate = Number(u.conversionRate) < 1 ? u.conversionRate.toFixed(4) : u.conversionRate;
        return `<option value="${u.id}">${u.name} ${u.isBaseUnit ? '(الوحدة الأساسية)' : `(${formattedRate} ${item.baseUnit?.name || ''})`}</option>`;
    }).join('');

    document.getElementById('restockForm').reset();
    const modal = document.getElementById('restockModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeRestockModal() {
    const modal = document.getElementById('restockModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    currentRestockItemId = null;
}

async function submitRestock(e) {
    e.preventDefault();
    if (!currentRestockItemId) return;

    const submitBtn = document.getElementById('submitRestockBtn');
    const unitId = document.getElementById('restockUnitSelect').value;
    const quantity = document.getElementById('restockQuantity').value;
    const notes = document.getElementById('restockNotes').value;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري التوريد...</span>';

    try {
        const res = await fetch(`/api/items/${currentRestockItemId}/restock`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quantity, unitId, notes })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في إضافة التوريد');

        closeRestockModal();
        showToast('تم توريد المخزون بنجاح ✓', 'success');
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في توريد المخزون', 'error');
    } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span> <span>حفظ التوريد</span>';
    }
}

// ─── Stock Log Modal Logic ───────────────────────────────────────
async function openStockLogModal(itemId) {
    const item = allItemsData.find(i => i.id === itemId);
    if (!item) return;

    document.getElementById('stockLogItemName').textContent = item.name;
    const tableBody = document.getElementById('stockLogTableBody');
    const emptyEl = document.getElementById('stockLogEmpty');

    tableBody.innerHTML = '<tr><td colspan="5" class="py-md text-center text-secondary">جاري تحميل حركة المخزون...</td></tr>';
    emptyEl.classList.add('hidden');

    const modal = document.getElementById('stockLogModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    try {
        const res = await fetch(`/api/items/${itemId}`);
        const data = await res.json();

        if (!res.ok) throw new Error(data.error || 'فشل في جلب سجل الحركة');

        const logs = data.stockLogs || [];
        const baseUnitName = data.baseUnit ? data.baseUnit.name : '';

        if (logs.length === 0) {
            tableBody.innerHTML = '';
            emptyEl.classList.remove('hidden');
            return;
        }

        tableBody.innerHTML = logs.map(log => {
            let typeBadge = '';
            if (log.changeType === 'restock') {
                typeBadge = '<span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-bold text-[11px]">توريد +</span>';
            } else if (log.changeType === 'sale') {
                typeBadge = '<span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-bold text-[11px]">خصم مبيعات -</span>';
            } else {
                typeBadge = '<span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px]">تصحيح</span>';
            }

            const qtyVal = Number(log.quantityBase) || 0;
            const qtySign = qtyVal > 0 ? '+' : '';

            return `
                <tr class="hover:bg-surface-container-high/50">
                    <td class="px-md py-sm font-mono text-secondary">${formatDate(log.createdAt)}</td>
                    <td class="px-md py-sm">${typeBadge}</td>
                    <td class="px-md py-sm font-bold text-on-surface dir-ltr inline-block">${qtySign}${qtyVal} ${baseUnitName}</td>
                    <td class="px-md py-sm font-bold text-primary dir-ltr inline-block">${log.balanceAfter} ${baseUnitName}</td>
                    <td class="px-md py-sm text-secondary">${log.notes || '-'}</td>
                </tr>
            `;
        }).join('');

    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في جلب سجل الحركة', 'error');
    }
}

function closeStockLogModal() {
    const modal = document.getElementById('stockLogModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
}

// ─── Soft Delete / Toggle Active Logic ────────────────────────────
function promptToggleActive(itemId, willDeactivate) {
    const item = allItemsData.find(i => i.id === itemId);
    if (!item) return;

    pendingToggleItemId = itemId;
    const titleEl = document.getElementById('confirmModalTitle');
    const textEl = document.getElementById('confirmModalText');
    const btnText = document.getElementById('confirmToggleBtnText');
    const iconEl = document.getElementById('confirmModalIcon');
    const btn = document.getElementById('confirmToggleBtn');

    if (willDeactivate) {
        titleEl.textContent = `تعطيل الصنف "${item.name}"`;
        textEl.textContent = 'هل تريد تعطيل هذا الصنف؟ لن يظهر في قوائم الاختيار الجديدة، لكن سجله التاريخي سيبقى محفوظًا.';
        btnText.textContent = 'تأكيد التعطيل';
        iconEl.textContent = 'warning';
        btn.className = 'px-lg py-sm rounded-full bg-amber-600 text-white font-label-md hover:opacity-90 transition-opacity flex items-center gap-1 shadow-sm font-bold';
    } else {
        titleEl.textContent = `إعادة تفعيل الصنف "${item.name}"`;
        textEl.textContent = 'هل تريد إعادة تفعيل هذا الصنف ليظهر مجدداً في قوائم الاختيار المعاملات الجديدة؟';
        btnText.textContent = 'إعادة التفعيل';
        iconEl.textContent = 'restore';
        btn.className = 'px-lg py-sm rounded-full bg-green-600 text-white font-label-md hover:opacity-90 transition-opacity flex items-center gap-1 shadow-sm font-bold';
    }

    const modal = document.getElementById('confirmToggleModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeConfirmToggleModal() {
    const modal = document.getElementById('confirmToggleModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    pendingToggleItemId = null;
}

async function executeToggleActive() {
    if (!pendingToggleItemId) return;

    const confirmBtn = document.getElementById('confirmToggleBtn');
    confirmBtn.disabled = true;

    try {
        const res = await fetch(`/api/items/${pendingToggleItemId}`, {
            method: 'DELETE'
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في تغيير حالة الصنف');

        closeConfirmToggleModal();
        showToast(data.message || 'تم تحديث حالة الصنف بنجاح', 'success');
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تغيير حالة الصنف', 'error');
    } finally {
        confirmBtn.disabled = false;
    }
}
</script>
</body>
</html>
