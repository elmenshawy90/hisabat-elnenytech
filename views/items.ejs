<%- include('partials/bottom-nav', { active: 'items' }) %>
<script src="/js/shared-ui.js"></script>
<script>
let allItemsData = [];
let activeSearchTimeout = null;
let currentRestockItemId = null;
let pendingToggleItemId = null;
let currentItemHasStockLogs = false;

// Initialize Page
document.addEventListener('DOMContentLoaded', () => {
    checkAuth();
    loadItems();
    loadMasterUnits();
});

function debounceSearch() {
    clearTimeout(activeSearchTimeout);
    activeSearchTimeout = setTimeout(() => {
        loadItems();
    }, 300);
}

const LOW_STOCK_THRESHOLD = 10;
let activeItemFilter = null; // null, 'all', or 'lowStock'

function toggleItemsFilter(filterType) {
    if (activeItemFilter === filterType) {
        activeItemFilter = null;
    } else {
        activeItemFilter = filterType;
    }
    updateItemsFilterUI();
    renderItemsTable();
}

function updateItemsFilterUI() {
    const cardAll = document.getElementById('cardFilterAllItems');
    const cardLow = document.getElementById('cardFilterLowStock');
    if (!cardAll || !cardLow) return;

    if (activeItemFilter === 'all') {
        cardAll.className = "bg-primary/5 border-2 border-primary rounded-xl p-md flex items-center justify-between shadow-md cursor-pointer transition-all select-none group ring-2 ring-primary/20";
        cardLow.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-tertiary/60 opacity-60 transition-all select-none group";
    } else if (activeItemFilter === 'lowStock') {
        cardAll.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-primary/60 opacity-60 transition-all select-none group";
        cardLow.className = "bg-tertiary-fixed/20 border-2 border-tertiary rounded-xl p-md flex items-center justify-between shadow-md cursor-pointer transition-all select-none group ring-2 ring-tertiary/20";
    } else {
        cardAll.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-primary/60 transition-all select-none group";
        cardLow.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-tertiary/60 transition-all select-none group";
    }
}

async function loadItems() {
    const loadingEl = document.getElementById('itemsLoading');
    const searchVal = document.getElementById('searchInput').value.trim();
    const showInactive = document.getElementById('showInactiveToggle').checked;

    loadingEl.classList.remove('hidden');

    try {
        let url = `/api/items?includeInactive=${showInactive}`;
        if (searchVal) {
            url += `&search=${encodeURIComponent(searchVal)}`;
        }

        const res = await fetch(url);
        const json = await res.json();

        if (!res.ok) throw new Error(json.error || 'فشل في جلب الأصناف');

        allItemsData = json.data || [];

        updateStats(allItemsData);
        renderItemsTable();
        loadingEl.classList.add('hidden');
    } catch (err) {
        console.error(err);
        loadingEl.classList.add('hidden');
        showToast(err.message || 'فشل في تحميل بيانات الأصناف', 'error');
    }
}

function renderItemsTable() {
    const tableBody = document.getElementById('itemsTableBody');
    const emptyEl = document.getElementById('itemsEmpty');
    if (!tableBody) return;

    let itemsToRender = [...allItemsData];
    if (activeItemFilter === 'all') {
        itemsToRender = itemsToRender.filter(item => item.isActive !== false);
    } else if (activeItemFilter === 'lowStock') {
        itemsToRender = itemsToRender.filter(item => (Number(item.currentStock) || 0) < LOW_STOCK_THRESHOLD);
    }

    if (itemsToRender.length === 0) {
        tableBody.innerHTML = '';
        if (emptyEl) emptyEl.classList.remove('hidden');
        return;
    }
    if (emptyEl) emptyEl.classList.add('hidden');

    tableBody.innerHTML = itemsToRender.map(item => {
        const baseUnitName = item.baseUnit ? item.baseUnit.name : 'غير محددة';
        const isActive = item.isActive !== false;
        
        const unitsBadges = (item.units || []).map(u => {
            if (u.isBaseUnit) {
                return `<span class="bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold text-[11px]">${u.name} (أساسية)</span>`;
            }
            const rate = Number(u.conversionRate);
            // Show inverted: "1 base = X this unit"
            const invertedRate = rate > 0 ? (1 / rate) : 0;
            const formattedInverted = Number(invertedRate.toFixed(4));
            return `<span class="bg-surface-container text-secondary px-2 py-0.5 rounded-full font-bold text-[11px]">${u.name} (1 ${baseUnitName} = ${formattedInverted})</span>`;
        }).join(' ');

        const stockNum = Number(item.currentStock) || 0;
        const stockColorClass = stockNum > 0 ? 'text-green-600 font-bold' : (stockNum < 0 ? 'text-error font-bold' : 'text-secondary font-bold');
        
        const rowClass = isActive 
            ? 'hover:bg-primary/5 transition-colors' 
            : 'bg-surface-container-low/60 opacity-70 hover:opacity-100 transition-opacity';

        return `
            <tr class="${rowClass}">
                <td class="px-md py-md">
                    <div class="flex flex-col">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-on-surface text-base">${item.name}</span>
                            ${!isActive ? `<span class="bg-slate-200 text-slate-700 font-bold px-2 py-0.5 rounded-full text-[10px]">معطّل</span>` : ''}
                        </div>
                        ${item.notes ? `<span class="text-xs text-secondary">${item.notes}</span>` : ''}
                    </div>
                </td>
                <td class="px-md py-md">
                    <span class="px-2 py-1 bg-primary-container text-on-primary-container rounded-lg font-bold text-xs">${baseUnitName}</span>
                </td>
                <td class="px-md py-md">
                    <div class="flex flex-wrap gap-1">
                        ${unitsBadges}
                    </div>
                </td>
                <td class="px-md py-md">
                    <span class="text-base dir-ltr inline-block ${stockColorClass}">${formatCurrency(stockNum).replace(' ج.م', '')} ${baseUnitName}</span>
                </td>
                <td class="px-md py-md">
                    <div class="flex items-center justify-center gap-1 flex-wrap">
                        ${isActive ? `
                            <button type="button" onclick="openRestockModal(${item.id})" class="px-2.5 py-1 bg-green-700 hover:bg-green-800 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1 shadow-xs cursor-pointer" title="توريد مخزون">
                                <span class="material-symbols-outlined text-sm">warehouse</span>
                                <span>توريد</span>
                            </button>
                        ` : ''}
                        <button type="button" onclick="openStockLogModal(${item.id})" class="px-2.5 py-1 bg-surface-container hover:bg-primary/10 text-secondary hover:text-primary rounded-lg text-xs font-bold transition-all flex items-center gap-1 cursor-pointer" title="عرض السجل">
                            <span class="material-symbols-outlined text-sm">history</span>
                            <span>السجل</span>
                        </button>
                        <button type="button" onclick="openEditItemModal(${item.id})" class="px-2.5 py-1 border border-outline-variant hover:bg-surface-container text-secondary rounded-lg text-xs font-bold transition-all cursor-pointer" title="تعديل">
                            <span class="material-symbols-outlined text-sm">edit</span>
                        </button>
                        ${isActive ? `
                            <button type="button" onclick="promptToggleActive(${item.id}, true)" class="px-2.5 py-1 border border-amber-500/40 text-amber-700 hover:bg-amber-500/10 rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="تعطيل الصنف">
                                <span class="material-symbols-outlined text-sm">block</span>
                                <span>تعطيل</span>
                            </button>
                        ` : `
                            <button type="button" onclick="promptToggleActive(${item.id}, false)" class="px-2.5 py-1 bg-green-600 hover:bg-green-700 text-white rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="إعادة تفعيل الصنف">
                                <span class="material-symbols-outlined text-sm">restore</span>
                                <span>تفعيل</span>
                            </button>
                        `}
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

function updateStats(items) {
    const activeItems = items.filter(i => i.isActive !== false);
    const lowStockItems = items.filter(i => i.isActive !== false && (Number(i.currentStock) || 0) < LOW_STOCK_THRESHOLD);

    const totalEl = document.getElementById('statTotalItems');
    if (totalEl) totalEl.textContent = activeItems.length;

    const lowStockEl = document.getElementById('statLowStock');
    if (lowStockEl) lowStockEl.textContent = lowStockItems.length;

    const tabCount = document.getElementById('tabItemsCount');
    if (tabCount) tabCount.textContent = activeItems.length;
}

// ─── Dynamic Relative Units Builder Logic ─────────────────────────────
function renderUnitsBuilder(units = [], isProtected = false) {
    const container = document.getElementById('unitsRowsContainer');
    container.innerHTML = '';

    if (!units || units.length === 0) {
        units = [
            { name: '', isBaseUnit: true, conversionRate: 1.0 },
            { name: '', isBaseUnit: false, conversionRate: 1.0 }
        ];
    }

    // Sort: base unit always first visually
    const sorted = [...units];
    sorted.sort((a, b) => (b.isBaseUnit ? 1 : 0) - (a.isBaseUnit ? 1 : 0));

    sorted.forEach((u, idx) => {
        appendUnitRowToDOM(u, idx, isProtected);
    });

    updateAllRelativeDropdownsAndPreviews();
}

function appendUnitRowToDOM(unitObj = {}, idx, isProtected = false) {
    const container = document.getElementById('unitsRowsContainer');
    const isBase = Boolean(unitObj.isBaseUnit);
    const rowId = `unit_row_${idx}_${Date.now()}`;
    const isRowProtected = isProtected && Boolean(unitObj.id);

    const row = document.createElement('div');
    row.className = 'unit-row space-y-xs bg-surface p-xs rounded-xl border border-outline-variant/60';
    row.dataset.unitId = unitObj.id || '';
    row.id = rowId;

    row.innerHTML = `
        <div class="flex items-center gap-xs flex-wrap sm:flex-nowrap">
            <!-- Unit Name Select (من كتالوج الوحدات الرئيسي) -->
            <div class="flex-1 min-w-[120px]">
                <label class="block text-[11px] font-bold text-secondary mb-1">اسم الوحدة <span class="text-error">*</span></label>
                <select ${isRowProtected ? 'disabled' : ''} class="unit-name-input w-full h-9 px-sm rounded-md bg-surface-container-low border border-outline-variant text-xs font-bold text-right focus:border-primary outline-none cursor-pointer" required onchange="onUnitNameSelectChanged(this)">
                </select>
            </div>

            <!-- Base Unit Radio Selector -->
            <div class="w-28 flex flex-col justify-end">
                <label class="block text-[11px] font-bold text-secondary mb-1">نوع الوحدة</label>
                <label class="flex items-center justify-center gap-1.5 h-9 px-xs rounded-md bg-surface-container-low border border-outline-variant/60 cursor-pointer select-none">
                    <input type="radio" name="baseUnitRadio" ${isRowProtected ? 'disabled' : ''} class="base-unit-radio w-4 h-4 text-primary focus:ring-primary cursor-pointer" ${isBase ? 'checked' : ''} onchange="onUnitFormChanged()" />
                    <span class="text-xs font-bold text-on-surface">أساسية</span>
                </label>
            </div>

            <!-- Relative Controls Container (Hidden when selected as Base Unit) -->
            <div class="relative-controls-container flex items-center gap-xs flex-1 min-w-[200px]">
                <div class="w-36">
                    <label class="block text-[11px] font-bold text-secondary mb-1">بالنسبة لـ</label>
                    <select ${isRowProtected ? 'disabled' : ''} class="unit-relative-select w-full h-9 px-xs rounded-md bg-surface-container-low border border-outline-variant text-xs font-bold text-right outline-none cursor-pointer" onchange="onUnitFormChanged()">
                        <!-- Options filled dynamically -->
                    </select>
                </div>

                <div class="w-28">
                    <label class="unit-qty-label block text-[11px] font-bold text-secondary mb-1">الكمية</label>
                    <input type="number" step="any" min="0.000001" value="${unitObj._displayQty || ''}" ${isRowProtected ? 'readonly' : ''} class="unit-qty-input w-full h-9 px-sm rounded-md bg-surface-container-low border border-outline-variant text-xs font-bold text-center dir-ltr focus:border-primary outline-none" placeholder="مثال: 20" oninput="onUnitFormChanged()" />
                </div>
            </div>

            <!-- Base Unit Badge Display (Shown when selected as Base Unit) -->
            <div class="base-unit-badge-container hidden w-full sm:w-auto pt-4 shrink-0">
                <span class="text-[11px] font-bold text-primary bg-primary/10 px-3 py-1.5 rounded-md block text-center border border-primary/20">
                    ⭐ الوحدة الأساسية للمخزون
                </span>
            </div>

            <!-- Delete Row Button -->
            <div class="w-8 shrink-0 pt-4">
                ${!isRowProtected ? `
                    <button type="button" onclick="removeUnitRow('${rowId}')" class="w-8 h-8 flex items-center justify-center text-error hover:bg-error/10 rounded-md transition-colors shrink-0 cursor-pointer" title="حذف الوحدة">
                        <span class="material-symbols-outlined text-base">delete</span>
                    </button>
                ` : ''}
            </div>
        </div>

        <!-- Live Calculation Preview (hidden for base unit) -->
        <div class="unit-preview-text text-[11px] font-medium text-primary bg-primary/5 px-sm py-1 rounded-md border border-primary/10">
            جاري حساب معامل التحويل...
        </div>
    `;

    container.appendChild(row);

    // تعبئة قائمة الوحدات الرئيسية مع الحفاظ على القيمة الحالية (مهم للأصناف القديمة قبل الربط)
    const nameSelect = row.querySelector('.unit-name-input');
    if (nameSelect) {
        nameSelect.innerHTML = buildMasterUnitNameOptions(unitObj.name || '');
        nameSelect.dataset.prev = nameSelect.value;
    }
}

function addUnitRow() {
    const container = document.getElementById('unitsRowsContainer');
    const currentRowsCount = container.querySelectorAll('.unit-row').length;
    appendUnitRowToDOM({}, currentRowsCount, false);
    updateAllRelativeDropdownsAndPreviews();
}

function removeUnitRow(rowId) {
    const container = document.getElementById('unitsRowsContainer');
    const rows = container.querySelectorAll('.unit-row');
    if (rows.length <= 1) {
        showToast('يجب الاحتفاظ بوحدة قياس واحدة على الأقل', 'warning');
        return;
    }

    const row = document.getElementById(rowId);
    if (row) row.remove();
    updateAllRelativeDropdownsAndPreviews();
}

function onUnitFormChanged() {
    updateAllRelativeDropdownsAndPreviews();
}

function updateAllRelativeDropdownsAndPreviews() {
    const container = document.getElementById('unitsRowsContainer');
    const rows = Array.from(container.querySelectorAll('.unit-row'));
    if (rows.length === 0) return;

    // Find index of row selected via baseUnitRadio
    let baseRowIndex = rows.findIndex(row => {
        const radio = row.querySelector('.base-unit-radio');
        return radio && radio.checked;
    });

    if (baseRowIndex < 0) {
        baseRowIndex = 0;
        const firstRadio = rows[0]?.querySelector('.base-unit-radio');
        if (firstRadio) firstRadio.checked = true;
    }

    // Re-sort DOM: move base unit row to top visually
    const baseRow = rows[baseRowIndex];
    if (baseRow && baseRow !== container.firstElementChild) {
        container.insertBefore(baseRow, container.firstElementChild);
        // Re-read rows after DOM reorder
        return updateAllRelativeDropdownsAndPreviews();
    }

    const N = rows.length;

    // Collect unit names for all rows (selects now — '__new__' means "not chosen yet")
    const unitNames = rows.map((row, idx) => {
        const nameInput = row.querySelector('.unit-name-input');
        const raw = nameInput ? String(nameInput.value || '').trim() : '';
        return raw === '__new__' ? '' : raw;
    });

    // Step 1: Calculate raw reference value for each row
    // NEW LOGIC: User enters "1 [reference] = X [current unit]" (inverted)
    // So rawRef = (1/X) * targetData.ref  (because current unit is SMALLER)
    const rawRefMap = new Map();

    rows.forEach((row, idx) => {
        const unitName = unitNames[idx] || `وحدة ${idx + 1}`;

        if (idx === baseRowIndex) {
            rawRefMap.set(idx, { name: unitName, ref: 1.0 });
        } else {
            const select = row.querySelector('.unit-relative-select');
            const qtyInput = row.querySelector('.unit-qty-input');
            const targetIdx = select ? parseInt(select.value) : -1;
            const targetData = (targetIdx >= 0 && rawRefMap.has(targetIdx)) ? rawRefMap.get(targetIdx) : null;
            const qty = qtyInput ? parseFloat(qtyInput.value) || 0 : 0;

            if (qty > 0 && targetData) {
                // User entered: "1 [reference] = qty [current unit]"
                // So 1 current unit = (1/qty) reference units
                const rawRef = (1 / qty) * targetData.ref;
                rawRefMap.set(idx, { name: unitName, ref: rawRef });
            } else {
                rawRefMap.set(idx, { name: unitName, ref: 0 });
            }
        }
    });

    // Selected Base Unit raw reference value:
    const baseRawRef = rawRefMap.get(baseRowIndex)?.ref || 1.0;
    const baseUnitName = rawRefMap.get(baseRowIndex)?.name || 'الوحدة الأساسية';

    // Step 2: Render UI state, dropdown options & live previews for each row
    rows.forEach((row, idx) => {
        const isBase = idx === baseRowIndex;

        const baseBadgeContainer = row.querySelector('.base-unit-badge-container');
        const relativeControlsContainer = row.querySelector('.relative-controls-container');
        const select = row.querySelector('.unit-relative-select');
        const previewEl = row.querySelector('.unit-preview-text');
        const qtyLabel = row.querySelector('.unit-qty-label');

        if (isBase) {
            if (baseBadgeContainer) baseBadgeContainer.classList.remove('hidden');
            if (relativeControlsContainer) relativeControlsContainer.classList.add('hidden');
            // Hide preview box completely for base unit (Problem 2 fix)
            if (previewEl) previewEl.classList.add('hidden');
        } else {
            if (baseBadgeContainer) baseBadgeContainer.classList.add('hidden');
            if (relativeControlsContainer) relativeControlsContainer.classList.remove('hidden');
            if (previewEl) previewEl.classList.remove('hidden');

            const currentSelectedVal = select ? select.value : '';

            // Re-populate relativeTo dropdown: only show units with actual names (non-empty), excluding self
            if (select) {
                let optionsHTML = '';
                for (let otherIdx = 0; otherIdx < N; otherIdx++) {
                    if (otherIdx === idx) continue; // Skip self
                    const otherName = unitNames[otherIdx];
                    if (!otherName) continue; // Skip units without a name
                    const displayName = otherName || `وحدة ${otherIdx + 1}`;
                    optionsHTML += `<option value="${otherIdx}" ${String(otherIdx) === String(currentSelectedVal) ? 'selected' : ''}>${displayName}</option>`;
                }
                select.innerHTML = optionsHTML;
            }

            // Update quantity label dynamically: "كام [current] في كل 1 [reference]؟"
            const currentUnitName = unitNames[idx] || 'الوحدة الحالية';
            const selectedRefIdx = select ? parseInt(select.value) : -1;
            const selectedRefName = (selectedRefIdx >= 0 && unitNames[selectedRefIdx]) ? unitNames[selectedRefIdx] : 'المرجع';
            if (qtyLabel) {
                qtyLabel.textContent = `كام ${currentUnitName} في 1 ${selectedRefName}؟`;
            }

            const currentRawRef = rawRefMap.get(idx)?.ref || 0;
            const conversionRate = currentRawRef / baseRawRef;
            const unitName = rawRefMap.get(idx)?.name || `وحدة ${idx + 1}`;
            const qtyInput = row.querySelector('.unit-qty-input');
            const userQty = qtyInput ? parseFloat(qtyInput.value) || 0 : 0;

            if (previewEl) {
                if (userQty > 0 && currentRawRef > 0 && baseRawRef > 0) {
                    // Show "1 [reference] = X [current unit]" (natural direction)
                    previewEl.innerHTML = `✓ 1 <strong>${selectedRefName}</strong> = <strong class="text-primary underline dir-ltr inline-block">${userQty}</strong> ${unitName} — (معامل التحويل للأساسية: <span class="dir-ltr inline-block">${Number(conversionRate.toFixed(6))}</span>)`;
                } else {
                    previewEl.innerHTML = `أدخل الكمية لربط هذه الوحدة`;
                }
            }
        }
    });
}

// ─── Shared Units Catalog (الوحدات الرئيسية) ─────────────────────
let allUnitsData = [];
let unitsLoaded = false;
let currentItemsTab = 'items';
let pendingQuickAddSelect = null;
let currentMapUnitId = null;

function switchItemsTab(tab) {
    currentItemsTab = tab;
    const btnItems = document.getElementById('tabBtnItems');
    const btnUnits = document.getElementById('tabBtnUnits');
    const searchBar = document.getElementById('itemsSearchBar');
    const tableContainer = document.getElementById('itemsTableContainer');
    const unitsSection = document.getElementById('unitsSection');

    const activeCls = 'flex-1 md:flex-initial px-lg py-2 rounded-lg text-sm font-bold transition-all flex items-center justify-center gap-1 cursor-pointer bg-primary text-white shadow-sm';
    const idleCls = 'flex-1 md:flex-initial px-lg py-2 rounded-lg text-sm font-bold transition-all flex items-center justify-center gap-1 cursor-pointer text-secondary hover:bg-surface-container';

    if (tab === 'units') {
        if (btnUnits) btnUnits.className = activeCls;
        if (btnItems) btnItems.className = idleCls;
        if (searchBar) searchBar.classList.add('hidden');
        if (tableContainer) tableContainer.classList.add('hidden');
        if (unitsSection) unitsSection.classList.remove('hidden');
        loadMasterUnits();
    } else {
        if (btnItems) btnItems.className = activeCls;
        if (btnUnits) btnUnits.className = idleCls;
        if (searchBar) searchBar.classList.remove('hidden');
        if (tableContainer) tableContainer.classList.remove('hidden');
        if (unitsSection) unitsSection.classList.add('hidden');
    }
}

async function loadMasterUnits() {
    const loadingEl = document.getElementById('unitsLoading');
    if (loadingEl) loadingEl.classList.remove('hidden');
    try {
        const res = await fetch('/api/units');
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'فشل في جلب الوحدات');
        allUnitsData = json.data || [];
        unitsLoaded = true;
        const tabCount = document.getElementById('tabUnitsCount');
        if (tabCount) tabCount.textContent = allUnitsData.filter(u => u.isActive !== false).length;
        renderUnitsTable();
        refreshAllUnitNameSelects();
    } catch (err) {
        console.error(err);
        // تنبيه مرئي فقط داخل تبويب الوحدات (حتى لا يزعج مستخدم الأصناف قبل تطبيق الترحيل)
        if (currentItemsTab === 'units') showToast(err.message || 'فشل في تحميل الوحدات', 'error');
    } finally {
        if (loadingEl) loadingEl.classList.add('hidden');
    }
}

function renderUnitsTable() {
    const tableBody = document.getElementById('unitsTableBody');
    const emptyEl = document.getElementById('unitsEmpty');
    if (!tableBody) return;

    if (!allUnitsData || allUnitsData.length === 0) {
        tableBody.innerHTML = '';
        if (emptyEl) emptyEl.classList.remove('hidden');
        return;
    }
    if (emptyEl) emptyEl.classList.add('hidden');

    tableBody.innerHTML = allUnitsData.map(unit => {
        const isActive = unit.isActive !== false;
        const items = unit.items || [];
        const itemsBadges = items.length > 0
            ? items.map(it => `<span class="bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold text-[11px]">${it.name}</span>`).join(' ')
            : '<span class="text-secondary text-xs">غير مرتبطة بأي صنف بعد</span>';
        const rowClass = isActive ? 'hover:bg-primary/5 transition-colors' : 'bg-surface-container-low/60 opacity-70 hover:opacity-100 transition-opacity';
        return `
            <tr class="${rowClass}">
                <td class="px-md py-md">
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-on-surface text-base">${unit.name}</span>
                        ${!isActive ? `<span class="bg-slate-200 text-slate-700 font-bold px-2 py-0.5 rounded-full text-[10px]">معطّلة</span>` : ''}
                    </div>
                </td>
                <td class="px-md py-md">
                    <span class="px-2 py-1 rounded-lg font-bold text-xs ${isActive ? 'bg-green-500/10 text-green-700' : 'bg-slate-200 text-slate-600'}">${isActive ? 'نشطة' : 'معطّلة'}</span>
                </td>
                <td class="px-md py-md">
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-secondary">${unit.itemsCount} ${unit.itemsCount === 1 ? 'صنف' : 'أصناف'}</span>
                        <div class="flex flex-wrap gap-1">${itemsBadges}</div>
                    </div>
                </td>
                <td class="px-md py-md">
                    <div class="flex items-center justify-center gap-1 flex-wrap">
                        ${isActive ? `
                            <button type="button" onclick="openMapModal(${unit.id})" class="px-2.5 py-1 bg-primary hover:bg-primary-container text-white rounded-lg text-xs font-bold transition-all flex items-center gap-1 shadow-xs cursor-pointer" title="ربط بأصناف">
                                <span class="material-symbols-outlined text-sm">link</span>
                                <span>ربط بأصناف</span>
                            </button>
                        ` : ''}
                        <button type="button" onclick="openUnitModal(${unit.id})" class="px-2.5 py-1 border border-outline-variant hover:bg-surface-container text-secondary rounded-lg text-xs font-bold transition-all cursor-pointer" title="تعديل الاسم">
                            <span class="material-symbols-outlined text-sm">edit</span>
                        </button>
                        ${isActive ? `
                            <button type="button" onclick="toggleUnitActive(${unit.id}, true)" class="px-2.5 py-1 border border-amber-500/40 text-amber-700 hover:bg-amber-500/10 rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="تعطيل الوحدة">
                                <span class="material-symbols-outlined text-sm">block</span>
                                <span>تعطيل</span>
                            </button>
                        ` : `
                            <button type="button" onclick="toggleUnitActive(${unit.id}, false)" class="px-2.5 py-1 bg-green-600 hover:bg-green-700 text-white rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="إعادة تفعيل الوحدة">
                                <span class="material-symbols-outlined text-sm">restore</span>
                                <span>تفعيل</span>
                            </button>
                        `}
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

// خيارات أسماء الوحدات لصفوف نموذج الصنف — من الكتالوج الرئيسي أولًا
function buildMasterUnitNameOptions(selectedName) {
    const sel = selectedName ? String(selectedName).trim() : '';
    const active = (allUnitsData || []).filter(u => u.isActive !== false);
    let html = '<option value="">-- اختر الوحدة --</option>';
    const seen = new Set();
    active.forEach(u => {
        seen.add(String(u.name).trim());
        const isSel = sel === String(u.name).trim() ? 'selected' : '';
        html += `<option value="${u.name}" ${isSel}>${u.name}</option>`;
    });
    // قيمة قديمة غير موجودة في الكتالوج (قبل البناء) — اعرضها كخيار للحفاظ عليها
    if (sel && !seen.has(sel)) {
        html += `<option value="${sel}" selected>${sel} (غير مربوطة بالكتالوج)</option>`;
    }
    html += `<option value="__new__">＋ وحدة جديدة...</option>`;
    return html;
}

function refreshAllUnitNameSelects() {
    document.querySelectorAll('#unitsRowsContainer .unit-name-input').forEach(sel => {
        if (sel.tagName !== 'SELECT' || sel.disabled) return;
        const cur = sel.value && sel.value !== '__new__' ? sel.value : (sel.dataset.prev || '');
        sel.innerHTML = buildMasterUnitNameOptions(cur);
        sel.dataset.prev = sel.value;
    });
}

function onUnitNameSelectChanged(sel) {
    if (!sel || sel.disabled) return;
    if (sel.value === '__new__') {
        // أعد القيمة السابقة وافتح نافذة إضافة سريعة
        sel.value = sel.dataset.prev || '';
        pendingQuickAddSelect = sel;
        openUnitModal(null, true);
        return;
    }
    sel.dataset.prev = sel.value;
    onUnitFormChanged();
}

function openUnitModal(unitId = null, quickAdd = false) {
    document.getElementById('unitModalId').value = unitId || '';
    document.getElementById('unitModalTitle').textContent = unitId ? 'تعديل اسم الوحدة' : 'إضافة وحدة جديدة';
    document.getElementById('unitModalIcon').textContent = unitId ? 'edit' : 'straighten';
    const nameInput = document.getElementById('unitName');
    if (unitId) {
        const unit = allUnitsData.find(u => String(u.id) === String(unitId));
        nameInput.value = unit ? unit.name : '';
    } else {
        nameInput.value = '';
    }
    if (!quickAdd) pendingQuickAddSelect = null;
    const modal = document.getElementById('unitModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    nameInput.focus();
}

function closeUnitModal() {
    const modal = document.getElementById('unitModal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
    pendingQuickAddSelect = null;
}

async function submitUnitForm(e) {
    e.preventDefault();
    const unitId = document.getElementById('unitModalId').value;
    const name = document.getElementById('unitName').value.trim();
    const submitBtn = document.getElementById('submitUnitBtn');
    if (!name) {
        showToast('الرجاء إدخال اسم الوحدة', 'warning');
        return;
    }

    submitBtn.disabled = true;
    try {
        const isEdit = Boolean(unitId);
        const res = await fetch(isEdit ? `/api/units/${unitId}` : '/api/units', {
            method: isEdit ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في حفظ الوحدة');

        const quickSel = pendingQuickAddSelect;
        closeUnitModal();
        showToast(isEdit ? 'تم تحديث اسم الوحدة في كل الأصناف المرتبطة ✓' : `تم إضافة الوحدة "${data.name}" ✓`, 'success');
        await loadMasterUnits();
        loadItems();
        if (quickSel && quickSel.isConnected) {
            quickSel.innerHTML = buildMasterUnitNameOptions(data.name);
            quickSel.value = data.name;
            quickSel.dataset.prev = data.name;
            onUnitFormChanged();
        }
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في حفظ الوحدة', 'error');
    } finally {
        submitBtn.disabled = false;
    }
}

async function toggleUnitActive(unitId, isCurrentlyActive) {
    try {
        const res = await fetch(`/api/units/${unitId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في تغيير حالة الوحدة');
        showToast(data.message, 'success');
        await loadMasterUnits();
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تغيير حالة الوحدة', 'error');
    }
}

// ─── ربط الوحدة بأصناف ──────────────────────────────────────────
function openMapModal(unitId) {
    const unit = allUnitsData.find(u => String(u.id) === String(unitId));
    if (!unit) return;
    currentMapUnitId = unitId;
    document.getElementById('mapUnitName').textContent = unit.name;
    document.getElementById('mapConversionRate').value = '1';
    document.getElementById('mapItemsSearch').value = '';
    renderMapItemsList();
    const modal = document.getElementById('unitMapModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeMapModal() {
    const modal = document.getElementById('unitMapModal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
    currentMapUnitId = null;
}

function renderMapItemsList() {
    const listEl = document.getElementById('mapItemsList');
    if (!listEl || !currentMapUnitId) return;
    const unit = allUnitsData.find(u => String(u.id) === String(currentMapUnitId));
    const searchVal = (document.getElementById('mapItemsSearch').value || '').trim();

    let items = (allItemsData || []).filter(i => i.isActive !== false);
    if (searchVal) {
        items = items.filter(i => (i.name || '').includes(searchVal));
    }

    if (items.length === 0) {
        listEl.innerHTML = '<div class="p-md text-center text-xs text-secondary">لا توجد أصناف مطابقة — أضف الصنف أولًا من تبويب الأصناف.</div>';
        return;
    }

    listEl.innerHTML = items.map(item => {
        const linkedUnit = (item.units || []).find(u => (u.unitId && String(u.unitId) === String(currentMapUnitId)) || u.name === unit.name);
        const linked = Boolean(linkedUnit);
        return `
            <label class="flex items-center justify-between gap-sm px-md py-2.5 hover:bg-primary/5 transition-colors ${linked ? 'opacity-70' : 'cursor-pointer'}">
                <span class="flex items-center gap-sm">
                    <input type="checkbox" value="${item.id}" ${linked ? 'checked disabled' : ''} class="map-item-checkbox w-4 h-4 text-primary rounded border-outline focus:ring-primary ${linked ? '' : 'cursor-pointer'}" />
                    <span class="font-bold text-sm text-on-surface">${item.name}</span>
                </span>
                ${linked ? `
                    <span class="flex items-center gap-1">
                        <span class="text-[11px] font-bold text-green-700 bg-green-500/10 px-2 py-0.5 rounded-full">مرتبطة ✓</span>
                        <button type="button" onclick="unmapUnitFromItem(event, ${item.id})" class="text-[11px] font-bold text-error hover:bg-error/10 px-2 py-0.5 rounded-full transition-colors cursor-pointer" title="فك الربط">فك</button>
                    </span>
                ` : `<span class="text-[11px] text-secondary">${(item.units || []).length} وحدات</span>`}
            </label>
        `;
    }).join('');
}

async function submitMap() {
    if (!currentMapUnitId) return;
    const checked = Array.from(document.querySelectorAll('.map-item-checkbox:checked:not(:disabled)')).map(c => parseInt(c.value));
    if (checked.length === 0) {
        showToast('اختر صنفًا واحدًا على الأقل للربط', 'warning');
        return;
    }
    const rateVal = document.getElementById('mapConversionRate').value;
    const submitBtn = document.getElementById('submitMapBtn');
    submitBtn.disabled = true;
    try {
        const res = await fetch(`/api/units/${currentMapUnitId}/map`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemIds: checked, conversionRate: rateVal ? parseFloat(rateVal) : 1 })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في الربط');
        showToast(data.message, 'success');
        closeMapModal();
        await loadMasterUnits();
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في الربط', 'error');
    } finally {
        submitBtn.disabled = false;
    }
}

async function unmapUnitFromItem(e, itemId) {
    if (e) e.preventDefault();
    if (!currentMapUnitId) return;
    if (!confirm('هل تريد فك ربط هذه الوحدة عن الصنف؟')) return;
    try {
        const res = await fetch(`/api/units/${currentMapUnitId}/items/${itemId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في فك الربط');
        showToast(data.message, 'success');
        await loadMasterUnits();
        loadItems();
        renderMapItemsList();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في فك الربط', 'error');
    }
}

// ─── Open Item Form (Add / Edit) ────────────────────────────────
