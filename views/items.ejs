function addUnitRow() {
    const container = document.getElementById('unitsRowsContainer');
    const currentRowsCount = container.querySelectorAll('.unit-row').length;
    appendUnitRowToDOM({}, currentRowsCount, false);
    updateAllRelativeDropdownsAndPreviews();
}

function removeUnitRow(rowId) {
    const container = document.getElementById('unitsRowsContainer');
    const rows = container.querySelectorAll('.unit-row');
    if (rows.length <= 1) {
        showToast('يجب الاحتفاظ بوحدة قياس واحدة على الأقل', 'warning');
        return;
    }

    const row = document.getElementById(rowId);
    if (row) row.remove();
    updateAllRelativeDropdownsAndPreviews();
}

function onUnitFormChanged() {
    updateAllRelativeDropdownsAndPreviews();
}

function updateAllRelativeDropdownsAndPreviews() {
    const rows = Array.from(document.querySelectorAll('#unitsRowsContainer .unit-row'));
    if (rows.length === 0) return;

    // Find index of row selected via baseUnitRadio
    let baseRowIndex = rows.findIndex(row => {
        const radio = row.querySelector('.base-unit-radio');
        return radio && radio.checked;
    });

    if (baseRowIndex < 0) {
        baseRowIndex = 0;
        const firstRadio = rows[0]?.querySelector('.base-unit-radio');
        if (firstRadio) firstRadio.checked = true;
    }

    // Step 1: Calculate raw reference value for each row
    const rawRefMap = new Map();
    const N = rows.length;

    rows.forEach((row, idx) => {
        const nameInput = row.querySelector('.unit-name-input');
        const unitName = nameInput ? nameInput.value.trim() || `وحدة ${idx + 1}` : `وحدة ${idx + 1}`;

        if (idx === 0) {
            rawRefMap.set(0, { name: unitName, ref: 1.0 });
        } else {
            const select = row.querySelector('.unit-relative-select');
            const qtyInput = row.querySelector('.unit-qty-input');
            const targetIdx = select ? parseInt(select.value) || 0 : 0;
            const targetData = rawRefMap.get(targetIdx) || { name: 'الوحدة 1', ref: 1.0 };
            const qty = qtyInput ? parseFloat(qtyInput.value) || 0 : 0;

            const rawRef = qty * targetData.ref;
            rawRefMap.set(idx, { name: unitName, ref: rawRef });
        }
    });

    // Selected Base Unit raw reference value:
    const baseRawRef = rawRefMap.get(baseRowIndex)?.ref || 1.0;
    const baseUnitName = rawRefMap.get(baseRowIndex)?.name || 'الوحدة الأساسية';

    // Step 2: Render UI state, dropdown options & live previews for each row
    rows.forEach((row, idx) => {
        const isBase = idx === baseRowIndex;

        const baseBadgeContainer = row.querySelector('.base-unit-badge-container');
        const relativeControlsContainer = row.querySelector('.relative-controls-container');
        const select = row.querySelector('.unit-relative-select');
        const previewEl = row.querySelector('.unit-preview-text');

        if (isBase) {
            if (baseBadgeContainer) baseBadgeContainer.classList.remove('hidden');
            if (relativeControlsContainer) relativeControlsContainer.classList.add('hidden');
            if (previewEl) {
                previewEl.innerHTML = `<span class="text-primary font-bold">⭐ الوحدة المرجعية الأساسية لتتبع المخزون (1.0)</span>`;
            }
        } else {
            if (baseBadgeContainer) baseBadgeContainer.classList.add('hidden');
            if (relativeControlsContainer) relativeControlsContainer.classList.remove('hidden');

            const currentSelectedVal = select ? select.value : '';

            // Re-populate relativeTo dropdown with all other unit options in the form (except itself)
            if (select) {
                let optionsHTML = '';
                for (let otherIdx = 0; otherIdx < N; otherIdx++) {
                    if (otherIdx === idx) continue; // Skip self
                    const otherData = rawRefMap.get(otherIdx);
                    const otherName = otherData ? otherData.name : `وحدة ${otherIdx + 1}`;
                    optionsHTML += `<option value="${otherIdx}" ${String(otherIdx) === String(currentSelectedVal) ? 'selected' : ''}>${otherName}</option>`;
                }
                select.innerHTML = optionsHTML;
            }

            const currentRawRef = rawRefMap.get(idx)?.ref || 0;
            const conversionRate = currentRawRef / baseRawRef;
            const unitName = rawRefMap.get(idx)?.name || `وحدة ${idx + 1}`;

            if (previewEl) {
                if (currentRawRef > 0 && baseRawRef > 0) {
                    const formattedRate = Number(conversionRate) < 1 ? Number(conversionRate.toFixed(4)) : conversionRate;
                    previewEl.innerHTML = `يعني 1 <strong>${unitName}</strong> = <strong class="text-primary underline dir-ltr inline-block">${formattedRate}</strong> ${baseUnitName}`;
                } else {
                    previewEl.innerHTML = `أدخل الكمية لربط هذه الوحدة بالتعبير النسبة`;
                }
            }
        }
    });
}

// ─── Open Item Form (Add / Edit) ────────────────────────────────
function openAddItemModal() {
    currentItemHasStockLogs = false;
    document.getElementById('itemModalId').value = '';
    document.getElementById('itemModalTitle').textContent = 'إضافة صنف جديد';
    document.getElementById('itemModalIcon').textContent = 'add_box';
    document.getElementById('itemName').value = '';
    document.getElementById('itemNotes').value = '';
    const defPriceInput = document.getElementById('itemDefaultPrice');
    if (defPriceInput) defPriceInput.value = '';
    document.getElementById('stockProtectedWarning').classList.add('hidden');

    renderUnitsBuilder([], false);

    const modal = document.getElementById('itemModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    document.getElementById('itemName').focus();
}

async function openEditItemModal(itemId) {
    try {
        const res = await fetch(`/api/items/${itemId}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في جلب بيانات الصنف');

        currentItemHasStockLogs = Boolean(data.hasStockLogs);

        document.getElementById('itemModalId').value = data.id;
        document.getElementById('itemModalTitle').textContent = `تعديل الصنف "${data.name}"`;
        document.getElementById('itemModalIcon').textContent = 'edit';
        document.getElementById('itemName').value = data.name;
        document.getElementById('itemNotes').value = data.notes || '';
        const defPriceInput = document.getElementById('itemDefaultPrice');
        if (defPriceInput) {
            defPriceInput.value = data.defaultSellingPrice !== undefined && data.defaultSellingPrice !== null ? data.defaultSellingPrice : '';
        }

        const warningEl = document.getElementById('stockProtectedWarning');
        if (currentItemHasStockLogs) {
            warningEl.classList.remove('hidden');
        } else {
            warningEl.classList.add('hidden');
        }

        renderUnitsBuilder(data.units || [], currentItemHasStockLogs);

        const modal = document.getElementById('itemModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في جلب بيانات الصنف للتعديل', 'error');
    }
}

function closeItemModal() {
    const modal = document.getElementById('itemModal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
    document.body.style.overflow = '';
}

async function submitItemForm(e) {
    e.preventDefault();
    const itemId = document.getElementById('itemModalId').value;
    const submitBtn = document.getElementById('submitItemBtn');
    const name = document.getElementById('itemName').value.trim();
    const notes = document.getElementById('itemNotes').value.trim();
    const priceVal = document.getElementById('itemDefaultPrice') ? document.getElementById('itemDefaultPrice').value.trim() : '';
    const defaultSellingPrice = priceVal !== '' && !isNaN(parseFloat(priceVal)) ? parseFloat(priceVal) : null;

    const rows = Array.from(document.querySelectorAll('#unitsRowsContainer .unit-row'));
    if (rows.length === 0) {
        showToast('يجب إدخال وحدة قياس واحدة على الأقل', 'warning');
        return;
    }

    const unitsPayload = [];
    const baseUnitName = rows[0].querySelector('.unit-name-input').value.trim();

    rows.forEach((row, idx) => {
        const uId = row.dataset.unitId ? parseInt(row.dataset.unitId) : undefined;
        const uName = row.querySelector('.unit-name-input').value.trim();
        const radio = row.querySelector('.base-unit-radio');
        const isBase = radio ? radio.checked : (idx === 0);

        if (isBase) {
            unitsPayload.push({
                id: uId,
                name: uName,
                isBaseUnit: true,
                conversionRate: 1.0
            });
        } else {
            const select = row.querySelector('.unit-relative-select');
            const qtyInput = row.querySelector('.unit-qty-input');
            const targetIdx = select ? parseInt(select.value) || 0 : 0;
            const targetRow = rows[targetIdx];
            const targetName = targetRow ? targetRow.querySelector('.unit-name-input').value.trim() : baseUnitName;
            const relQty = parseFloat(qtyInput.value) || 0;

            unitsPayload.push({
                id: uId,
                name: uName,
                isBaseUnit: false,
                relativeToName: targetName,
                relativeToIndex: targetIdx,
                relativeQuantity: relQty
            });
        }
    });

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري الحفظ...</span>';

    try {
        const isEdit = Boolean(itemId);
        const url = isEdit ? `/api/items/${itemId}` : '/api/items';
        const method = isEdit ? 'PUT' : 'POST';

        const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, notes, units: unitsPayload, defaultSellingPrice })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في حفظ بيانات الصنف');

        closeItemModal();
        showToast(isEdit ? 'تم تحديث بيانات الصنف بنجاح ✓' : `تم إضافة الصنف "${data.name}" بنجاح ✓`, 'success');
        loadItems();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في حفظ الصنف', 'error');
    } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span> <span>حفظ الصنف</span>';
    }
}

