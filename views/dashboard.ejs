<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>سجل الديون - لوحة القيادة</title>
<meta name="description" content="لوحة القيادة الرئيسية لنظام سجل الديون - إدارة مواد البناء"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="js/tailwind-config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link href="css/styles.css" rel="stylesheet"/>
</head>
<body class="bg-background text-on-surface min-h-screen overflow-x-hidden">
<!-- Main Navigation Wrapper -->
<div class="flex flex-col md:flex-row min-h-screen">
<%- include('partials/aside', { active: 'dashboard' }) %>
<!-- Main Content Area -->
<main class="flex-grow min-w-0 md:mr-64 p-container-margin pb-24 md:pb-container-margin transition-all">
<%- include('partials/header', { title: 'سجل الديون' }) %>
<!-- Dashboard Content -->
<div class="max-w-7xl mx-auto space-y-lg pb-24 md:pb-xl">
<!-- Page Header (Desktop) -->
<div class="hidden md:flex justify-between items-end mb-xl">
<div class="text-right">
<h1 class="text-3xl font-bold text-on-surface">مرحباً بك في لوحة القيادة</h1>
<p class="text-secondary mt-1">نظرة عامة على الحالة المالية للشركة اليوم</p>
</div>
<a href="/new-invoice" class="bg-primary hover:bg-primary-container text-white px-md py-sm md:px-lg md:py-md rounded-full flex items-center gap-sm transition-all shadow-md active:scale-95 font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm">
<span class="material-symbols-outlined text-xl md:text-2xl">add</span>
<span>إضافة فاتورة جديدة</span>
</a>
</div>
<!-- Summary Cards Bento Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-md">
<!-- Total Customers -->
<div class="bg-white p-md rounded-lg border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
<div class="flex justify-between items-start mb-sm">
<div class="p-base bg-secondary-container rounded-lg text-on-secondary-container">
<span class="material-symbols-outlined">group</span>
</div>
</div>
<p class="text-secondary text-sm">إجمالي العملاء</p>
<h3 class="text-2xl font-bold text-on-surface" id="statTotalClients">--</h3>
</div>
<!-- Outstanding Balance -->
<div class="bg-white p-md rounded-lg border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
<div class="flex justify-between items-start mb-sm">
<div class="p-base bg-primary-container/10 rounded-lg text-primary">
<span class="material-symbols-outlined">account_balance_wallet</span>
</div>
</div>
<p class="text-secondary text-sm">المستحقات القائمة</p>
<h3 class="text-2xl font-bold text-on-surface" id="statOutstanding">--</h3>
</div>
<!-- Late Customers -->
<div class="bg-white p-md rounded-lg border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
<div class="flex justify-between items-start mb-sm">
<div class="p-base bg-error-container/10 rounded-lg text-error">
<span class="material-symbols-outlined">timer_off</span>
</div>
<span class="text-[10px] text-error font-bold">حرج</span>
</div>
<p class="text-secondary text-sm">عملاء متأخرون</p>
<h3 class="text-2xl font-bold text-on-surface" id="statLateClients">--</h3>
</div>
<!-- Today's Transactions -->
<div class="bg-white p-md rounded-lg border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
<div class="flex justify-between items-start mb-sm">
<div class="p-base bg-tertiary-container/10 rounded-lg text-tertiary">
<span class="material-symbols-outlined">receipt_long</span>
</div>
<span class="text-[10px] text-primary font-bold">نشط</span>
</div>
<p class="text-secondary text-sm">معاملات اليوم</p>
<h3 class="text-2xl font-bold text-on-surface" id="statTodayTx">--</h3>
</div>
</div>

<!-- Charts Section and Top Debtors -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-lg mb-lg">
    <!-- Chart (Main Column) -->
    <div class="lg:col-span-2 bg-white p-md rounded-lg border border-outline-variant shadow-sm h-[350px] relative w-full">
        <canvas id="monthlyChart" class="w-full h-full"></canvas>
    </div>
    
    <!-- Top Debtors Sidebar -->
    <div class="space-y-md h-[350px]">
        <div class="bg-white rounded-lg border border-outline-variant shadow-sm overflow-hidden flex flex-col h-full">
            <div class="px-md py-sm border-b border-outline-variant bg-surface-container-low flex justify-between items-center">
                <h4 class="font-bold text-on-surface">أكبر المدينين</h4>
                <span class="material-symbols-outlined text-secondary text-[20px]">warning</span>
            </div>
            <div class="p-md space-y-md flex-grow overflow-y-auto custom-scrollbar" id="topDebtors">
                <div class="p-xl text-center text-secondary">جاري التحميل...</div>
            </div>
            <div class="p-md pt-0 border-t border-outline-variant mt-auto">
                <a href="/clients" class="w-full py-sm mt-md border-2 border-primary text-primary font-bold rounded-lg hover:bg-primary hover:text-white transition-all flex items-center justify-center gap-sm">
                    <span>عرض جميع العملاء</span>
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions Table -->
<div class="grid grid-cols-1 gap-lg">
    <div class="space-y-md">
        <div class="bg-white rounded-lg border border-outline-variant shadow-sm overflow-hidden">
            <div class="flex justify-between items-center px-md py-sm border-b border-outline-variant">
                <h4 class="font-bold text-on-surface">أحدث المعاملات</h4>
                <a href="/new-invoice" class="text-primary text-sm font-medium hover:underline">عرض الكل</a>
            </div>
            <div class="overflow-x-auto w-full">
                <table class="w-full text-right border-collapse whitespace-nowrap">
                    <thead class="bg-surface-container-low text-secondary text-[12px] uppercase">
                        <tr>
                            <th class="px-md py-sm font-medium">العميل</th>
                            <th class="px-md py-sm font-medium">نوع المعاملة</th>
                            <th class="px-md py-sm font-medium text-left">المبلغ</th>
                            <th class="px-md py-sm font-medium">التاريخ</th>
                            <th class="px-md py-sm font-medium">الحالة</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30" id="recentTransactions">
                        <tr><td colspan="5" class="p-xl text-center text-secondary">جاري التحميل...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Overdue Clients Alert Section -->
<div class="grid grid-cols-1 gap-lg">
    <div class="space-y-md">
        <div class="bg-white rounded-lg border border-error/30 shadow-sm overflow-hidden">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-sm px-md py-sm border-b border-outline-variant bg-error/5">
                <div class="flex items-center gap-sm">
                    <div class="w-8 h-8 rounded-full bg-error-container/20 text-error flex items-center justify-center">
                        <span class="material-symbols-outlined text-lg">timer_off</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-on-surface flex items-center gap-2">
                            <span>عملاء متأخرون</span>
                            <span id="overdueClientsBadge" class="bg-error text-white text-[11px] px-2 py-0.5 rounded-full font-bold">0</span>
                        </h4>
                        <p class="text-[11px] text-secondary">عملاء عليهم دين قائم ولم تسجل لهم أي حركة منذ فترة التنبيه</p>
                    </div>
                </div>
                
                <!-- Threshold Setting Control -->
                <form id="overdueThresholdForm" onsubmit="updateOverdueThreshold(event)" class="flex items-center gap-xs bg-white px-sm py-1 rounded-lg border border-outline-variant text-xs shadow-2xs">
                    <label for="thresholdDaysInput" class="text-secondary font-medium whitespace-nowrap">فترة التأخير:</label>
                    <input type="number" id="thresholdDaysInput" min="1" max="365" required class="w-14 h-8 px-1 text-center font-bold border border-outline-variant rounded bg-surface-container-low focus:border-primary outline-none text-xs" />
                    <span class="text-secondary font-medium">يوم</span>
                    <button type="submit" id="saveThresholdBtn" class="px-sm py-1 bg-slate-800 hover:bg-slate-900 text-white rounded font-bold text-xs transition-all flex items-center gap-1 cursor-pointer active:scale-95">
                        <span>حفظ</span>
                    </button>
                </form>
            </div>

            <div class="overflow-x-auto w-full">
                <table class="w-full text-right border-collapse whitespace-nowrap">
                    <thead class="bg-surface-container-low text-secondary text-[12px] uppercase">
                        <tr>
                            <th class="px-md py-sm font-medium">العميل</th>
                            <th class="px-md py-sm font-medium text-left">الرصيد المستحق (الدين)</th>
                            <th class="px-md py-sm font-medium">تاريخ آخر حركة</th>
                            <th class="px-md py-sm font-medium">فترة الانقطاع</th>
                            <th class="px-md py-sm font-medium text-center">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30 text-xs" id="overdueClientsTable">
                        <tr><td colspan="5" class="p-xl text-center text-secondary">جاري التحميل...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>
</main>
<%- include('partials/bottom-nav', { active: 'dashboard' }) %>
</div>

<script src="/js/shared-ui.js"></script>
<script>
// Mobile Sidebar Toggle
const sidebar = document.getElementById('sidebar');
function toggleSidebar() {
    sidebar.classList.toggle('hidden');
    sidebar.classList.toggle('md:flex');
}

// Load dashboard data from API
async function loadDashboard() {
    const user = await checkAuth();
    if (!user) return;
    
    // Update user display names
    document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
    document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');

    try {
        const res = await fetch('/api/dashboard');
        const data = await res.json();

        // Update KPI cards
        document.getElementById('statTotalClients').textContent = data.totalClients;
        document.getElementById('statOutstanding').textContent = formatCurrency(data.outstandingBalance);
        document.getElementById('statLateClients').textContent = data.lateClients;
        document.getElementById('statTodayTx').textContent = data.todayTransactions;

        // Render overdue threshold input
        const thresholdInput = document.getElementById('thresholdDaysInput');
        if (thresholdInput && data.overdueThresholdDays) {
            thresholdInput.value = data.overdueThresholdDays;
        }

        // Render overdue count badge
        const overdueBadge = document.getElementById('overdueClientsBadge');
        if (overdueBadge) {
            overdueBadge.textContent = data.lateClients || 0;
        }

        // Render overdue clients table
        renderOverdueClients(data.overdueClients);

        // Render recent transactions
        renderRecentTransactions(data.recentTransactions);

        // Render top debtors
        renderTopDebtors(data.topDebtors);
        
        // Render Chart
        renderChart(data.chartData);
    } catch (err) {
        console.error('Failed to load dashboard:', err);
        showToast('فشل في تحميل البيانات', 'error');
    }
}

function renderChart(chartData) {
    if (!chartData || chartData.length === 0) return;
    
    const ctx = document.getElementById('monthlyChart').getContext('2d');
    
    // Group by week
    const weeks = [];
    const purchases = [];
    const payments = [];
    
    const dataMap = {};
    chartData.forEach(item => {
        const key = `${item._id.year}-${item._id.month}-${item._id.week}`;
        if (!dataMap[key]) {
            dataMap[key] = { purchase: 0, payment: 0, label: `أسبوع ${item._id.week}، شهر ${item._id.month}` };
            weeks.push(dataMap[key].label);
        }
        dataMap[key][item._id.type] = item.total;
    });
    
    weeks.forEach(w => {
        const item = Object.values(dataMap).find(d => d.label === w);
        purchases.push(item.purchase);
        payments.push(item.payment);
    });

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: weeks,
            datasets: [
                {
                    label: 'مشتريات',
                    data: purchases,
                    backgroundColor: '#1b8354', // primary-container
                },
                {
                    label: 'مدفوعات',
                    data: payments,
                    backgroundColor: '#dce2f3', // secondary-container
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: { font: { family: "'IBM Plex Sans Arabic', sans-serif" } }
                }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
}

function renderRecentTransactions(transactions) {
    const tbody = document.getElementById('recentTransactions');
    if (!transactions || transactions.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-xl text-center text-secondary">لا توجد معاملات بعد</td></tr>';
        return;
    }
    tbody.innerHTML = transactions.map(tx => {
        const initials = tx.clientName.split(' ').slice(0, 2).map(w => w[0]).join(' ');
        const isPayment = tx.type === 'payment';
        const statusBadge = isPayment
            ? '<span class="bg-green-100 text-green-700 text-[10px] font-bold px-sm py-[2px] rounded-full">تم السداد</span>'
            : tx.status === 'pending'
            ? '<span class="bg-orange-100 text-orange-700 text-[10px] font-bold px-sm py-[2px] rounded-full">قيد الانتظار</span>'
            : '<span class="bg-red-100 text-red-700 text-[10px] font-bold px-sm py-[2px] rounded-full">متأخر</span>';
        const typeIcon = isPayment
            ? '<span class="material-symbols-outlined text-[16px] text-green-600" style="font-variation-settings: \'FILL\' 1;">payments</span>'
            : '<span class="material-symbols-outlined text-[16px] text-primary">shopping_cart</span>';
        const typeName = isPayment ? 'دفعة مالية' : 'مشتريات';
        const amountClass = isPayment ? 'text-green-600' : '';

        return `
            <tr class="hover:bg-primary-container/5 transition-colors">
                <td class="px-md py-md">
                    <div class="flex items-center gap-sm">
                        <div class="w-8 h-8 rounded-full bg-surface-container-highest flex items-center justify-center text-[12px] font-bold">${initials}</div>
                        <span class="text-on-surface font-medium text-sm">${tx.clientName}</span>
                    </div>
                </td>
                <td class="px-md py-md">
                    <span class="flex items-center gap-xs text-sm text-on-surface">
                        ${typeIcon} ${typeName}
                    </span>
                </td>
                <td class="px-md py-md text-sm font-bold text-left ${amountClass}">${isPayment ? '-' : ''}${formatCurrency(tx.amount)}</td>
                <td class="px-md py-md text-sm text-secondary">${formatDate(tx.date)}</td>
                <td class="px-md py-md">${statusBadge}</td>
            </tr>
        `;
    }).join('');
}

function renderTopDebtors(debtors) {
    const container = document.getElementById('topDebtors');
    if (!debtors || debtors.length === 0) {
        container.innerHTML = '<div class="p-xl text-center text-secondary">لا يوجد مدينون</div>';
        return;
    }
    container.innerHTML = debtors.map((debtor, index) => {
        const severity = index === 0 ? { color: 'bg-red-500', text: 'حالة حرجة' }
                        : index === 1 ? { color: 'bg-red-400', text: 'تنبيه' }
                        : { color: 'bg-orange-400', text: 'متابعة' };
        return `
            <a href="/client-details?id=${debtor._id}" class="flex flex-row items-center justify-between p-sm border border-outline-variant/30 rounded-lg hover:border-primary/50 transition-colors block">
                <div class="text-right">
                    <p class="font-bold text-sm text-on-surface">${debtor.name}</p>
                    <p class="text-[10px] text-secondary">${debtor.lastTransaction ? 'آخر معاملة: ' + formatDate(debtor.lastTransaction) : (debtor.phone[0] || '')}</p>
                </div>
                <div class="text-left">
                    <p class="font-bold ${index < 2 ? 'text-error' : 'text-on-surface'} text-sm">${formatCurrency(debtor.balance)}</p>
                    <div class="flex items-center justify-end gap-xs">
                        <span class="w-2 h-2 rounded-full ${severity.color}"></span>
                        <span class="text-[10px] text-secondary">${severity.text}</span>
                    </div>
                </div>
            </a>
        `;
    }).join('');
}

function renderOverdueClients(clients) {
    const tbody = document.getElementById('overdueClientsTable');
    if (!tbody) return;

    if (!clients || clients.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-xl text-center text-green-700 font-medium">لا يوجد عملاء متأخرون حالياً ✓</td></tr>';
        return;
    }

    tbody.innerHTML = clients.map(client => {
        const initials = (client.name || '').split(' ').slice(0, 2).map(w => w[0]).join(' ');
        const days = client.daysInactive || 0;

        return `
            <tr class="hover:bg-error/5 transition-colors">
                <td class="px-md py-md">
                    <div class="flex items-center gap-sm">
                        <div class="w-8 h-8 rounded-full bg-error-container/20 text-error flex items-center justify-center text-[12px] font-bold">${initials}</div>
                        <a href="/client-details?id=${client._id || client.id}" class="text-on-surface font-bold text-sm hover:text-primary hover:underline">${client.name}</a>
                    </div>
                </td>
                <td class="px-md py-md text-sm font-bold text-left text-error">${formatCurrency(client.balance)}</td>
                <td class="px-md py-md text-sm text-secondary">${formatDate(client.lastTransactionDate)}</td>
                <td class="px-md py-md text-sm">
                    <span class="inline-flex items-center gap-1 bg-error/10 text-error px-2 py-0.5 rounded-full text-xs font-bold">
                        <span>منذ ${days} ${days === 1 ? 'يوم' : (days === 2 ? 'يومين' : (days <= 10 ? 'أيام' : 'يوم'))}</span>
                    </span>
                </td>
                <td class="px-md py-md text-center">
                    <a href="/client-details?id=${client._id || client.id}" class="px-md py-1 bg-surface-container-high hover:bg-primary hover:text-white border border-outline-variant rounded-full text-xs font-bold transition-all inline-flex items-center gap-1">
                        <span>عرض الحساب</span>
                        <span class="material-symbols-outlined text-[14px]">arrow_back</span>
                    </a>
                </td>
            </tr>
        `;
    }).join('');
}

async function updateOverdueThreshold(e) {
    e.preventDefault();
    const input = document.getElementById('thresholdDaysInput');
    const saveBtn = document.getElementById('saveThresholdBtn');
    const days = parseInt(input.value);

    if (isNaN(days) || days < 1) {
        showToast('يرجى إدخال عدد أيام صحيح أكبر من أو يساوي 1', 'warning');
        return;
    }

    const origBtnHtml = saveBtn ? saveBtn.innerHTML : 'حفظ';
    if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="material-symbols-outlined text-xs animate-spin">progress_activity</span>';
    }

    try {
        const res = await fetch('/api/dashboard/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ overdueThresholdDays: days })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'فشل في تحديث الإعدادات');

        showToast(data.message || 'تم تحديث فترة التأخير بنجاح ✓', 'success');
        await loadDashboard();
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تحديث فترة التأخير', 'error');
    } finally {
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = origBtnHtml;
        }
    }
}

// Initialize
document.addEventListener('DOMContentLoaded', loadDashboard);
</script>
</body></html>