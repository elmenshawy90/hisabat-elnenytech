<!DOCTYPE html>
<html class="light" dir="rtl" lang="ar">

<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>إضافة فاتورة جديدة | سجل الديون</title>
    <meta name="description" content="إضافة وإدارة الفواتير والمعاملات المالية" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <script src="js/tailwind-config.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <link href="css/styles.css" rel="stylesheet" />
</head>

<body class="text-on-surface bg-background min-h-screen flex max-w-[100vw] overflow-x-hidden">
    <!-- SideNavBar -->
    <%- include('partials/aside', { active: 'invoices' }) %>
        <!-- Main Canvas -->
        <main class="flex-1 min-w-0 md:mr-64 min-h-screen flex flex-col pb-24 md:pb-0">
            <!-- Content Area -->
            <div class="flex-1 p-container-margin md:p-xl max-w-5xl mx-auto w-full">
                <!-- TopNavBar (Mobile & Tablet) -->
                <%- include('partials/header', { title: 'الفواتير' }) %>
                    <!-- Page Header -->
                    <div
                        class="flex flex-col md:flex-row justify-between items-start md:items-center mb-xl gap-md mt-md">
                        <div class="text-right">
                            <h2
                                class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-xs">
                                سجل الفواتير</h2>
                            <p class="text-secondary font-body-md text-body-md">إدارة وتتبع جميع الفواتير والمعاملات
                                المالية</p>
                        </div>
                        <div class="flex gap-sm">
                            <a href="/api/export/invoices/excel"
                                class="bg-surface-container-low text-on-surface rounded-full px-md py-sm md:px-lg md:py-md font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm hover:bg-surface-container transition-colors flex flex-row items-center justify-center gap-sm shadow-sm border border-outline-variant">
                                <span class="material-symbols-outlined text-xl md:text-2xl">download</span>
                                تصدير
                            </a>
                            <button
                                class="bg-primary text-on-primary rounded-full px-md py-sm md:px-lg md:py-md font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm hover:opacity-90 transition-opacity flex flex-row items-center justify-center gap-sm shadow-sm"
                                onclick="openModal()">
                                <span class="material-symbols-outlined text-xl md:text-2xl">add</span>
                                إضافة فاتورة
                            </button>
                        </div>
                    </div>
                    <!-- Search and Filter -->
                    <div
                        class="bg-white rounded-xl border border-slate-200 shadow-sm p-md mb-lg flex flex-col md:flex-row gap-sm items-center justify-between">
                        <div class="relative flex-1 w-full text-right">
                            <span
                                class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">search</span>
                            <input
                                class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right"
                                id="searchInput" onkeyup="filterInvoices()"
                                placeholder="ابحث باسم العميل أو رقم الجوال..." type="text" />
                        </div>
                        <div class="flex items-center gap-xs w-full md:w-auto">
                            <!-- Custom Invoice Sort Dropdown -->
                            <div class="relative flex-1 md:flex-initial" id="invSortDropdownContainer">
                                <button id="invSortDropdownBtn" type="button" class="w-full md:w-auto h-12 px-md bg-surface-container-low border border-outline-variant hover:border-primary/60 focus:border-primary rounded-xl flex items-center justify-between gap-sm text-on-surface font-body-md text-sm transition-all shadow-sm active:scale-98">
                                    <div class="flex items-center gap-xs">
                                        <span class="material-symbols-outlined text-primary text-lg">sort</span>
                                        <span class="text-xs text-secondary whitespace-nowrap">الترتيب:</span>
                                        <span id="invSortSelectedLabel" class="font-bold text-on-surface text-xs whitespace-nowrap">تاريخ الفاتورة</span>
                                    </div>
                                    <span class="material-symbols-outlined text-outline text-lg transition-transform duration-200" id="invSortDropdownArrow">expand_more</span>
                                </button>
                                
                                <!-- Custom Dropdown Menu -->
                                <div id="invSortDropdownMenu" class="hidden absolute top-[calc(100%+6px)] right-0 left-0 md:left-auto md:w-48 bg-surface border border-outline-variant/80 rounded-xl shadow-xl z-50 py-1.5 overflow-hidden transition-all duration-150 transform opacity-0 scale-95 origin-top">
                                    <button type="button" onclick="selectInvSortOption('date', 'تاريخ الفاتورة')" class="inv-sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="date">
                                        <span class="flex items-center gap-xs">
                                            <span class="material-symbols-outlined text-base text-secondary">calendar_today</span>
                                            تاريخ الفاتورة
                                        </span>
                                        <span class="material-symbols-outlined text-primary text-base font-bold inv-sort-check" id="inv-check-date">check</span>
                                    </button>
                                    <button type="button" onclick="selectInvSortOption('clientName', 'اسم العميل')" class="inv-sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="clientName">
                                        <span class="flex items-center gap-xs">
                                            <span class="material-symbols-outlined text-base text-secondary">person</span>
                                            اسم العميل
                                        </span>
                                        <span class="material-symbols-outlined text-primary text-base font-bold inv-sort-check hidden" id="inv-check-clientName">check</span>
                                    </button>
                                    <button type="button" onclick="selectInvSortOption('amount', 'المبلغ')" class="inv-sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="amount">
                                        <span class="flex items-center gap-xs">
                                            <span class="material-symbols-outlined text-base text-secondary">attach_money</span>
                                            المبلغ
                                        </span>
                                        <span class="material-symbols-outlined text-primary text-base font-bold inv-sort-check hidden" id="inv-check-amount">check</span>
                                    </button>
                                    <button type="button" onclick="selectInvSortOption('createdAt', 'تاريخ الإضافة')" class="inv-sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="createdAt">
                                        <span class="flex items-center gap-xs">
                                            <span class="material-symbols-outlined text-base text-secondary">schedule</span>
                                            تاريخ الإضافة
                                        </span>
                                        <span class="material-symbols-outlined text-primary text-base font-bold inv-sort-check hidden" id="inv-check-createdAt">check</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Sort Direction Toggle Button -->
                            <button id="invSortOrderToggle" class="h-12 w-12 flex-shrink-0 flex items-center justify-center bg-surface-container-low border border-outline-variant hover:border-primary/60 rounded-xl hover:bg-primary/5 text-primary transition-all active:scale-95 shadow-sm" title="تبديل الترتيب تصاعدي / تنازلي" type="button">
                                <span class="material-symbols-outlined text-xl transition-transform duration-200" id="invSortOrderIcon">arrow_downward</span>
                            </button>
                        </div>
                    </div>
                    <!-- Invoice List (Table) -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto w-full max-w-[100vw]">
                            <table class="w-full text-right border-collapse whitespace-nowrap" dir="rtl">
                                <thead class="bg-surface-container-low border-b border-outline-variant">
                                    <tr>
                                        <th class="px-lg py-md font-label-md text-label-md text-secondary">العميل</th>
                                        <th class="px-lg py-md font-label-md text-label-md text-secondary">العميل النهائي</th>
                                        <th class="px-lg py-md font-label-md text-label-md text-secondary">المبلغ
                                            المستحق</th>
                                        <th class="px-lg py-md font-label-md text-label-md text-secondary" dir="ltr">رقم
                                            الهاتف</th>
                                        <th class="px-lg py-md font-label-md text-label-md text-secondary">تاريخ
                                            الفاتورة</th>
                                        <th class="p-md font-label-md text-on-surface-variant font-bold">التفاصيل</th>
                                        <th class="p-md font-label-md text-on-surface-variant font-bold text-center">
                                            الإجراءات
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant" id="invoiceList">
                                    <tr>
                                        <td colspan="7" class="p-xl text-center text-secondary">جاري التحميل...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- Pagination Footer -->
                        <div class="px-md py-sm border-t border-slate-200 bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-sm text-xs text-secondary" id="invoicesPaginationContainer">
                            <div class="flex items-center gap-md w-full sm:w-auto justify-between sm:justify-start">
                                <div class="flex items-center gap-xs">
                                    <span>عرض:</span>
                                    <!-- Custom Page Size Dropdown -->
                                    <div class="relative" id="invoicesPageSizeContainer">
                                        <button id="invoicesPageSizeBtn" type="button" class="h-8 px-2.5 bg-surface-container-low border border-outline-variant hover:border-primary/60 focus:border-primary rounded-lg flex items-center justify-between gap-1 text-on-surface text-xs font-bold transition-all shadow-xs active:scale-98">
                                            <span id="invoicesPageSizeLabel">10</span>
                                            <span class="material-symbols-outlined text-outline text-base transition-transform duration-200" id="invoicesPageSizeArrow">expand_less</span>
                                        </button>
                                        
                                        <!-- Dropdown Menu (opens upward) -->
                                        <div id="invoicesPageSizeMenu" class="hidden absolute bottom-[calc(100%+4px)] right-0 w-28 bg-surface border border-outline-variant/80 rounded-xl shadow-xl z-50 py-1 overflow-hidden transition-all duration-150 transform opacity-0 scale-95 origin-bottom">
                                            <button type="button" onclick="selectInvoicesPageSize(10)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                                                <span>10 سجلات</span>
                                                <span class="material-symbols-outlined text-primary text-base font-bold inv-size-check" id="inv-size-check-10">check</span>
                                            </button>
                                            <button type="button" onclick="selectInvoicesPageSize(25)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                                                <span>25 سجل</span>
                                                <span class="material-symbols-outlined text-primary text-base font-bold inv-size-check hidden" id="inv-size-check-25">check</span>
                                            </button>
                                            <button type="button" onclick="selectInvoicesPageSize(50)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                                                <span>50 سجل</span>
                                                <span class="material-symbols-outlined text-primary text-base font-bold inv-size-check hidden" id="inv-size-check-50">check</span>
                                            </button>
                                            <button type="button" onclick="selectInvoicesPageSize(100)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                                                <span>100 سجل</span>
                                                <span class="material-symbols-outlined text-primary text-base font-bold inv-size-check hidden" id="inv-size-check-100">check</span>
                                            </button>
                                        </div>
                                    </div>
                                    <span>فاتورة لكل صفحة</span>
                                </div>
                                <div class="text-secondary font-medium" id="invoicesPaginationInfo">
                                    عرض 0 - 0 من أصل 0 فاتورة
                                </div>
                            </div>
                            <div id="invoicesPaginationControls">
                                <!-- Rendered dynamically -->
                            </div>
                        </div>
                        <div class="hidden p-xl text-center text-secondary font-body-md" id="noResults">
                            لا توجد فواتير مطابقة للبحث
                        </div>
                    </div>
            </div>
            <!-- Mobile Bottom NavBar -->
            <%- include('partials/bottom-nav', { active: 'invoices' }) %>
        </main>

        <!-- Modal -->
        <div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="invoiceModal">
            <div class="bg-white rounded-xl shadow-lg w-full max-w-3xl max-h-[90vh] overflow-y-auto p-md md:p-xl">
                <div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
                    <h2 class="font-headline-md text-headline-md font-bold text-on-surface" id="modalTitle">إضافة فاتورة جديدة</h2>
                    <button class="text-secondary hover:text-on-surface" onclick="closeModal()" type="button">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <p class="text-[13px] text-secondary mb-md -mt-sm">الحقول المشار إليها بنجمة (<span
                        class="text-error font-bold">*</span>) هي حقول إجبارية</p>
                <form class="space-y-lg" id="invoiceForm" novalidate>
                    <input type="hidden" id="invoiceId">
                    <input type="hidden" id="clientId">
                    <input type="hidden" id="endClientId">

                    <!-- Client Summary Card (Hidden initially) -->
                    <div id="clientSummaryCard"
                        class="hidden bg-primary/10 border border-primary/20 rounded-xl p-md mb-md flex flex-row items-center justify-between">
                        <div class="flex flex-col gap-xs">
                            <div class="flex items-center gap-sm">
                                <span class="material-symbols-outlined text-primary text-[20px]">account_circle</span>
                                <span class="font-body-md text-on-surface font-bold">عميل موجود بالخزينة</span>
                            </div>
                            <div class="text-sm text-secondary mr-7">
                                <p>الرصيد: <span id="summaryBalance" class="font-bold dir-ltr inline-block">0</span></p>
                                <p>آخر معاملة: <span id="summaryLastTransaction">--</span></p>
                            </div>
                        </div>
                        <a href="#" id="summaryProfileLink" target="_blank"
                            class="p-sm text-primary hover:bg-primary/10 rounded-lg transition-colors flex items-center justify-center"
                            title="فتح ملف العميل">
                            <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
                        <div class="flex flex-col gap-xs relative">
                            <label class="font-label-md text-label-md text-on-surface-variant mb-xs">اسم العميل <span
                                    class="text-error">*</span></label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">person</span>
                                <input
                                    class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right"
                                    id="clientName" placeholder="مثال: أحمد محمد علي" type="text" required
                                    autocomplete="off" />
                            </div>
                            <!-- Dropdown -->
                            <div id="clientDropdown"
                                class="hidden absolute top-[72px] left-0 right-0 mt-1 bg-surface border border-outline-variant rounded-xl shadow-lg z-[110] max-h-[300px] overflow-y-auto custom-scrollbar">
                            </div>
                        </div>
                        <div class="flex flex-col gap-xs relative">
                            <label class="font-label-md text-label-md text-on-surface-variant mb-xs">اسم العميل النهائي (اختياري)</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">person_pin</span>
                                <input
                                    class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right"
                                    id="endClientName" placeholder="مثال: محمد إبراهيم (اختياري)" type="text"
                                    autocomplete="off" />
                            </div>
                            <!-- End Client Dropdown -->
                            <div id="endClientDropdown"
                                class="hidden absolute top-[72px] left-0 right-0 mt-1 bg-surface border border-outline-variant rounded-xl shadow-lg z-[110] max-h-[300px] overflow-y-auto custom-scrollbar">
                            </div>
                        </div>
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface-variant mb-xs">رقم الجوال</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">call</span>
                                <input
                                    class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right"
                                    id="mobileNumber" placeholder="01XXXXXXXXX" type="tel" />
                            </div>
                            <p id="mobileNumberError" class="hidden text-error text-[11px] mt-1 pr-1 font-bold">يجب
                                إدخال
                                أرقام فقط</p>
                        </div>
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface-variant mb-xs">تاريخ الفاتورة</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">calendar_today</span>
                                <input
                                    class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right cursor-pointer"
                                    id="invoiceDate" placeholder="اختر التاريخ" type="text" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface-variant mb-xs">المبلغ المستحق
                                (جنيه)</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">payments</span>
                                <input
                                    class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right font-bold text-primary"
                                    id="invoiceAmount" placeholder="0.00" type="number" step="0.01" />
                            </div>
                        </div>
                        <div class="md:col-span-2 flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface-variant mb-xs">عنوان التوصيل</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
                                <input
                                    class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right"
                                    id="deliveryAddress" placeholder="الحي، الشارع، رقم المبنى..." type="text" />
                            </div>
                        </div>
                        <div class="md:col-span-2 flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface-variant mb-xs">التفاصيل /
                                المشتريات</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute right-3 top-4 text-outline">inventory_2</span>
                                <textarea
                                    class="w-full pr-10 pl-md pt-3 rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right resize-none"
                                    id="invoiceDetails" placeholder="مثال: 1 طن أسمنت مقاوم، 500 حجر بلوك مقاس 20..."
                                    rows="4"></textarea>
                            </div>
                        </div>
                    </div>
                    <div
                        class="flex flex-col md:flex-row items-center gap-md pt-lg border-t border-outline-variant mt-xl">
                        <button
                            class="w-full md:w-auto min-w-[160px] bg-primary text-on-primary h-14 rounded-full font-headline-sm text-headline-sm flex items-center justify-center gap-sm hover:opacity-90 active:scale-95 transition-all"
                            type="submit">
                            <span class="material-symbols-outlined"
                                style="font-variation-settings: 'FILL' 1;">save</span>
                            <span id="submitButtonText">حفظ الفاتورة</span>
                        </button>
                        <button
                            class="w-full md:w-auto min-w-[160px] bg-white border border-outline-variant text-on-surface h-14 rounded-full font-headline-sm text-headline-sm flex items-center justify-center gap-sm hover:bg-surface-container-low active:scale-95 transition-all"
                            onclick="closeModal()" type="button">
                            إلغاء
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Transaction Details Modal -->
        <div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4"
            id="transactionDetailsModal">
            <div class="bg-surface rounded-xl shadow-lg w-full max-w-lg max-h-[90vh] overflow-y-auto p-md md:p-xl">
                <div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
                    <h2 class="font-headline-md text-headline-md font-bold text-on-surface">تفاصيل المعاملة</h2>
                    <button class="text-secondary hover:text-on-surface" onclick="closeTransactionDetails()"
                        type="button">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="space-y-md">
                    <div class="flex justify-between border-b border-outline-variant pb-xs">
                        <span class="text-secondary font-label-md">تاريخ المعاملة</span>
                        <span class="font-body-md text-on-surface font-bold" id="tdDate"></span>
                    </div>
                    <div class="flex justify-between border-b border-outline-variant pb-xs">
                        <span class="text-secondary font-label-md">العميل</span>
                        <span class="font-body-md text-on-surface font-bold" id="tdClient"></span>
                    </div>
                    <div class="flex justify-between border-b border-outline-variant pb-xs">
                        <span class="text-secondary font-label-md">العميل النهائي</span>
                        <span class="font-body-md text-on-surface font-bold" id="tdEndClient"></span>
                    </div>
                    <div class="flex justify-between border-b border-outline-variant pb-xs">
                        <span class="text-secondary font-label-md">نوع المعاملة</span>
                        <span class="font-body-md text-on-surface font-bold" id="tdType"></span>
                    </div>
                    <div class="flex justify-between border-b border-outline-variant pb-xs">
                        <span class="text-secondary font-label-md">المبلغ المستحق</span>
                        <span class="font-body-md font-bold" id="tdAmount"></span>
                    </div>
                    <div class="flex flex-col gap-xs border-b border-outline-variant pb-xs">
                        <span class="text-secondary font-label-md">عنوان التوصيل</span>
                        <span class="font-body-md text-on-surface" id="tdAddress"></span>
                    </div>
                    <div class="flex flex-col gap-xs pb-xs">
                        <span class="text-secondary font-label-md">التفاصيل / المشتريات</span>
                        <span class="font-body-md text-on-surface whitespace-pre-wrap" id="tdNotes"></span>
                    </div>
                </div>
                <div class="pt-md mt-lg text-center">
                    <button
                        class="bg-surface-container-low text-on-surface px-xl rounded-full py-sm font-label-md hover:bg-surface-container transition-colors"
                        onclick="closeTransactionDetails()" type="button">إغلاق</button>
                </div>
            </div>
        </div>
        </div>

        <script src="/js/shared-ui.js"></script>
        <script>
            let allInvoices = [];
            let allClientsList = [];
            let allEndClientsList = [];

            async function loadClients() {
                try {
                    const res = await fetch('/api/clients');
                    const data = await res.json();
                    allClientsList = data.data || [];
                } catch (err) {
                    console.error('Failed to load clients:', err);
                }
            }

            async function loadEndClients() {
                try {
                    const res = await fetch('/api/end-clients');
                    const data = await res.json();
                    allEndClientsList = data.data || [];
                } catch (err) {
                    console.error('Failed to load end clients:', err);
                }
            }

            let currentInvSortField = 'date'; // 'date', 'clientName', 'amount', 'createdAt'
            let currentInvSortOrder = 'desc'; // 'desc' or 'asc'

            function sortInvoicesList(invoices) {
                const list = [...invoices];
                list.sort((a, b) => {
                    let diff = 0;
                    if (currentInvSortField === 'clientName') {
                        const nameA = (a.clientName || '').trim();
                        const nameB = (b.clientName || '').trim();
                        diff = nameA.localeCompare(nameB, 'ar', { sensitivity: 'base' });
                    } else if (currentInvSortField === 'amount') {
                        diff = (Number(a.amount) || 0) - (Number(b.amount) || 0);
                    } else if (currentInvSortField === 'createdAt') {
                        const timeA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
                        const timeB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
                        diff = timeA - timeB;
                    } else {
                        // date
                        const dateA = new Date(a.date || 0).getTime();
                        const dateB = new Date(b.date || 0).getTime();
                        diff = dateA - dateB;
                    }

                    if (diff === 0) {
                        const timeA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
                        const timeB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
                        diff = timeA - timeB;
                    }

                    return currentInvSortOrder === 'asc' ? diff : -diff;
                });
                return list;
            }

            // Custom Invoice Sort Dropdown Functions
            function toggleInvSortDropdown(e) {
                e.stopPropagation();
                const menu = document.getElementById('invSortDropdownMenu');
                const arrow = document.getElementById('invSortDropdownArrow');
                const isHidden = menu.classList.contains('hidden');
                
                if (isHidden) {
                    menu.classList.remove('hidden');
                    requestAnimationFrame(() => {
                        menu.classList.remove('opacity-0', 'scale-95');
                        menu.classList.add('opacity-100', 'scale-100');
                    });
                    arrow.classList.add('rotate-180');
                } else {
                    menu.classList.add('opacity-0', 'scale-95');
                    menu.classList.remove('opacity-100', 'scale-100');
                    arrow.classList.remove('rotate-180');
                    setTimeout(() => menu.classList.add('hidden'), 150);
                }
            }

            function selectInvSortOption(field, label) {
                currentInvSortField = field;
                document.getElementById('invSortSelectedLabel').textContent = label;
                
                // Update checkmarks
                document.querySelectorAll('.inv-sort-check').forEach(el => el.classList.add('hidden'));
                const activeCheck = document.getElementById(`inv-check-${field}`);
                if (activeCheck) activeCheck.classList.remove('hidden');
                
                // Close menu
                const menu = document.getElementById('invSortDropdownMenu');
                const arrow = document.getElementById('invSortDropdownArrow');
                menu.classList.add('opacity-0', 'scale-95');
                menu.classList.remove('opacity-100', 'scale-100');
                arrow.classList.remove('rotate-180');
                setTimeout(() => menu.classList.add('hidden'), 150);
                
                filterInvoices();
            }

            document.getElementById('invSortDropdownBtn').addEventListener('click', toggleInvSortDropdown);

            document.addEventListener('click', (e) => {
                const container = document.getElementById('invSortDropdownContainer');
                if (container && !container.contains(e.target)) {
                    const menu = document.getElementById('invSortDropdownMenu');
                    const arrow = document.getElementById('invSortDropdownArrow');
                    if (menu && !menu.classList.contains('hidden')) {
                        menu.classList.add('opacity-0', 'scale-95');
                        menu.classList.remove('opacity-100', 'scale-100');
                        arrow.classList.remove('rotate-180');
                        setTimeout(() => menu.classList.add('hidden'), 150);
                    }
                }
            });

            document.getElementById('invSortOrderToggle').addEventListener('click', () => {
                currentInvSortOrder = currentInvSortOrder === 'asc' ? 'desc' : 'asc';
                document.getElementById('invSortOrderIcon').textContent = currentInvSortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward';
                filterInvoices();
            });

            async function loadInvoices() {
                const user = await checkAuth();
                if (!user) return;

                // Update user display names
                document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
                document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');

                // Setup Validation
                setupPhoneValidation('mobileNumber', 'mobileNumberError');

                // Setup Calendar
                flatpickr("#invoiceDate", {
                    locale: "ar",
                    defaultDate: "today",
                    dateFormat: "Y-m-d",
                    disableMobile: true
                });

                try {
                    const res = await fetch('/api/invoices');
                    const responseData = await res.json();
                    allInvoices = responseData.data || [];
                    renderInvoices(sortInvoicesList(allInvoices));
                } catch (err) {
                    console.error('Failed to load invoices:', err);
                    showToast('فشل في تحميل الفواتير', 'error');
                }
            }

            let currentInvoicesList = [];
            let invoicesCurrentPage = 1;
            let invoicesPageSize = 10;

            // Custom Invoice Page Size Dropdown Functions
            function toggleInvoicesPageSizeDropdown(e) {
                e.stopPropagation();
                const menu = document.getElementById('invoicesPageSizeMenu');
                const arrow = document.getElementById('invoicesPageSizeArrow');
                const isHidden = menu.classList.contains('hidden');
                
                if (isHidden) {
                    menu.classList.remove('hidden');
                    requestAnimationFrame(() => {
                        menu.classList.remove('opacity-0', 'scale-95');
                        menu.classList.add('opacity-100', 'scale-100');
                    });
                    arrow.classList.add('rotate-180');
                } else {
                    menu.classList.add('opacity-0', 'scale-95');
                    menu.classList.remove('opacity-100', 'scale-100');
                    arrow.classList.remove('rotate-180');
                    setTimeout(() => menu.classList.add('hidden'), 150);
                }
            }

            function selectInvoicesPageSize(val) {
                invoicesPageSize = Number(val);
                document.getElementById('invoicesPageSizeLabel').textContent = val;
                
                // Update checkmarks
                [10, 25, 50, 100].forEach(size => {
                    const check = document.getElementById(`inv-size-check-${size}`);
                    if (check) check.classList.toggle('hidden', size !== invoicesPageSize);
                });
                
                // Close menu
                const menu = document.getElementById('invoicesPageSizeMenu');
                const arrow = document.getElementById('invoicesPageSizeArrow');
                menu.classList.add('opacity-0', 'scale-95');
                menu.classList.remove('opacity-100', 'scale-100');
                arrow.classList.remove('rotate-180');
                setTimeout(() => menu.classList.add('hidden'), 150);
                
                invoicesCurrentPage = 1;
                renderInvoices(currentInvoicesList);
            }

            document.getElementById('invoicesPageSizeBtn').addEventListener('click', toggleInvoicesPageSizeDropdown);

            document.addEventListener('click', (e) => {
                const container = document.getElementById('invoicesPageSizeContainer');
                if (container && !container.contains(e.target)) {
                    const menu = document.getElementById('invoicesPageSizeMenu');
                    const arrow = document.getElementById('invoicesPageSizeArrow');
                    if (menu && !menu.classList.contains('hidden')) {
                        menu.classList.add('opacity-0', 'scale-95');
                        menu.classList.remove('opacity-100', 'scale-100');
                        arrow.classList.remove('rotate-180');
                        setTimeout(() => menu.classList.add('hidden'), 150);
                    }
                }
            });

            function renderInvoices(invoices, resetPage = false) {
                currentInvoicesList = invoices;
                if (resetPage) invoicesCurrentPage = 1;

                const tbody = document.getElementById('invoiceList');
                const query = document.getElementById('searchInput').value;
                const totalRecords = invoices.length;

                if (totalRecords === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="p-xl text-center text-secondary">لا توجد فواتير بعد</td></tr>';
                    renderPaginationControls({
                        containerId: 'invoicesPaginationControls',
                        infoId: 'invoicesPaginationInfo',
                        currentPage: 1,
                        pageSize: invoicesPageSize,
                        totalRecords: 0,
                        unitLabel: 'فاتورة',
                        onPageChange: () => {}
                    });
                    return;
                }

                const totalPages = Math.ceil(totalRecords / invoicesPageSize) || 1;
                if (invoicesCurrentPage > totalPages) invoicesCurrentPage = totalPages;
                if (invoicesCurrentPage < 1) invoicesCurrentPage = 1;

                const startIndex = (invoicesCurrentPage - 1) * invoicesPageSize;
                const endIndex = Math.min(startIndex + invoicesPageSize, totalRecords);
                const pagedInvoices = invoices.slice(startIndex, endIndex);

                tbody.innerHTML = pagedInvoices.map(inv => `
        <tr class="invoice-item cursor-pointer hover:bg-primary/5 transition-colors group" onclick="openTransactionDetails(${inv._id})">
            <td class="p-md font-body-md text-on-surface client-name">${highlightArabic(inv.clientName, query)}</td>
            <td class="p-md font-body-md text-secondary end-client-name">${highlightArabic(inv.endClientName || '', query) || '-'}</td>
            <td class="p-md font-body-md font-bold ${inv.type === 'payment' ? 'text-green-600' : 'text-primary'}">${inv.type === 'payment' ? '-' : ''}${formatCurrency(inv.amount)}</td>
            <td class="p-md font-body-md text-secondary client-mobile" dir="ltr">${highlightArabic(inv.clientPhone || '', query) || '-'}</td>
            <td class="p-md font-body-md text-secondary">${formatDate(inv.date)}</td>
            <td class="p-md font-body-md text-secondary">${inv.details || '-'}</td>
            <td class="p-md text-center">
                <div class="flex items-center justify-center gap-xs group-hover:gap-sm transition-all">
                    <button onclick="event.stopPropagation(); editInvoice(${inv._id})" class="p-sm rounded-lg hover:bg-primary/20 text-primary transition-all active:scale-90" title="تعديل">
                        <span class="material-symbols-outlined text-[20px]">edit</span>
                    </button>
                    <button onclick="event.stopPropagation(); deleteInvoice(${inv._id})" class="p-sm rounded-lg hover:bg-error-container/20 text-error transition-all active:scale-90" title="حذف">
                        <span class="material-symbols-outlined text-[20px]">delete</span>
                    </button>
                </div>
            </td>
        </tr>
    `).join('');

                renderPaginationControls({
                    containerId: 'invoicesPaginationControls',
                    infoId: 'invoicesPaginationInfo',
                    currentPage: invoicesCurrentPage,
                    pageSize: invoicesPageSize,
                    totalRecords: totalRecords,
                    unitLabel: 'فاتورة',
                    onPageChange: (newPage) => {
                        invoicesCurrentPage = newPage;
                        renderInvoices(currentInvoicesList);
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });
            }

            // Search/Filter
            function filterInvoices() {
                const filter = normalizeArabic(document.getElementById('searchInput').value);
                const filtered = allInvoices.filter(inv =>
                    normalizeArabic(inv.clientName).includes(filter) ||
                    (inv.endClientName && normalizeArabic(inv.endClientName).includes(filter)) ||
                    (inv.clientPhone && inv.clientPhone.includes(filter))
                );
                renderInvoices(sortInvoicesList(filtered), true);
                document.getElementById('noResults').classList.toggle('hidden', filtered.length > 0);
            }

            // Delete invoice
            async function deleteInvoice(id) {
                const confirmed = await showConfirm('هل أنت متأكد من حذف هذه الفاتورة؟');
                if (!confirmed) return;
                try {
                    const res = await fetch(`/api/invoices/${id}`, { method: 'DELETE' });
                    if (res.ok) {
                        showToast('تم حذف الفاتورة بنجاح', 'success');
                        loadInvoices();
                    } else {
                        showToast('فشل في حذف الفاتورة', 'error');
                    }
                } catch (err) {
                    showToast('فشل في حذف الفاتورة', 'error');
                }
            }

            // Edit invoice
            function editInvoice(id) {
                const inv = allInvoices.find(i => String(i._id) === String(id));
                if (!inv) {
                    showToast('لم تجد الفاتورة', 'error');
                    return;
                }

                // Set the mode to edit
                document.getElementById('invoiceId').value = id;
                document.getElementById('modalTitle').textContent = 'تعديل الفاتورة';
                document.getElementById('submitButtonText').textContent = 'حفظ التغييرات';

                // Populate form with invoice data
                document.getElementById('clientName').value = inv.clientName || '';
                document.getElementById('clientId').value = inv.clientId || '';
                document.getElementById('endClientName').value = inv.endClientName || '';
                document.getElementById('endClientId').value = inv.endClientId || '';
                document.getElementById('mobileNumber').value = inv.clientPhone && inv.clientPhone !== '-' ? inv.clientPhone : '';
                document.getElementById('invoiceDetails').value = inv.details || '-';
                document.getElementById('deliveryAddress').value = inv.address || '-';
                
                // Format date for input
                const dateObj = new Date(inv.date);
                const year = dateObj.getFullYear();
                const month = String(dateObj.getMonth() + 1).padStart(2, '0');
                const day = String(dateObj.getDate()).padStart(2, '0');
                document.getElementById('invoiceDate').value = `${year}-${month}-${day}`;
                
                document.getElementById('invoiceAmount').value = inv.amount;

                // Show client summary
                if (inv.clientId) {
                    const client = allClientsList.find(c => c.id === inv.clientId);
                    if (client) {
                        const balanceEl = document.getElementById('summaryBalance');
                        balanceEl.textContent = formatCurrency(client.balance || 0);
                        balanceEl.className = `font-bold dir-ltr inline-block ${(client.balance || 0) > 0 ? 'text-tertiary' : ((client.balance || 0) < 0 ? 'text-error' : 'text-primary')}`;
                        document.getElementById('summaryLastTransaction').textContent = client.updatedAt ? formatDate(client.updatedAt) : '--';
                        document.getElementById('summaryProfileLink').href = `/client-details?id=${client.id}`;
                        document.getElementById('clientSummaryCard').classList.remove('hidden');
                        document.getElementById('clientSummaryCard').classList.add('flex');
                    }
                }

                // Open modal
                const modal = document.getElementById('invoiceModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            // Transaction Details Modal
            function openTransactionDetails(id) {
                const inv = allInvoices.find(i => String(i._id) === String(id));
                if (!inv) return;

                document.getElementById('tdDate').textContent = formatDate(inv.date);
                document.getElementById('tdClient').textContent = inv.clientName;
                document.getElementById('tdEndClient').textContent = inv.endClientName || '-';
                document.getElementById('tdType').textContent = inv.type === 'payment' ? 'دفعة' : 'عملية شراء';

                const amountEl = document.getElementById('tdAmount');
                amountEl.textContent = formatCurrency(inv.amount);
                amountEl.className = `font-body-md font-bold ${inv.type === 'payment' ? 'text-green-600' : 'text-primary'}`;

                document.getElementById('tdAddress').textContent = inv.address || '-';
                document.getElementById('tdNotes').textContent = inv.details || '-';

                const modal = document.getElementById('transactionDetailsModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            function closeTransactionDetails() {
                const modal = document.getElementById('transactionDetailsModal');
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            }

            document.getElementById('transactionDetailsModal').addEventListener('click', function (e) {
                if (e.target === this) closeTransactionDetails();
            });

            // Modal functions
            function openModal() {
                document.getElementById('invoiceId').value = '';
                document.getElementById('modalTitle').textContent = 'إضافة فاتورة جديدة';
                document.getElementById('submitButtonText').textContent = 'حفظ الفاتورة';
                const modal = document.getElementById('invoiceModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
                document.getElementById('invoiceDate').valueAsDate = new Date();
                loadClients();
                loadEndClients();
            }

            function closeModal() {
                const modal = document.getElementById('invoiceModal');
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
                document.getElementById('invoiceForm').reset();
                document.getElementById('invoiceId').value = '';
                document.getElementById('clientId').value = '';
                document.getElementById('endClientId').value = '';
                document.getElementById('clientSummaryCard').classList.add('hidden');
                document.getElementById('clientSummaryCard').classList.remove('flex');
                document.getElementById('clientDropdown').classList.add('hidden');
                document.getElementById('endClientDropdown').classList.add('hidden');
                // Reset modal to create mode
                document.getElementById('modalTitle').textContent = 'إضافة فاتورة جديدة';
                document.getElementById('submitButtonText').textContent = 'حفظ الفاتورة';
            }

            // Client Auto-complete Logic
            const clientNameInput = document.getElementById('clientName');
            const clientDropdown = document.getElementById('clientDropdown');
            const clientIdInput = document.getElementById('clientId');
            const clientSummaryCard = document.getElementById('clientSummaryCard');

            clientNameInput.addEventListener('input', (e) => {
                const rawVal = e.target.value || '';
                const terms = [...new Set(rawVal.trim().split(/\s+/).filter(Boolean))];

                // Clear selection if user types
                clientIdInput.value = '';
                clientSummaryCard.classList.add('hidden');
                clientSummaryCard.classList.remove('flex');

                if (terms.length === 0) {
                    clientDropdown.classList.add('hidden');
                    return;
                }

                const scoredClients = [];
                for (const c of allClientsList) {
                    const normName = normalizeArabic(c.name || '');
                    const phone = c.phone || '';
                    let score = 0;
                    for (const term of terms) {
                        const normTerm = normalizeArabic(term);
                        const nameMatches = normTerm && normName.includes(normTerm);
                        const phoneMatches = phone && phone.includes(term);
                        if (nameMatches || phoneMatches) {
                            score++;
                        }
                    }
                    if (score > 0) {
                        scoredClients.push({ client: c, score });
                    }
                }

                scoredClients.sort((a, b) => b.score - a.score);
                const matches = scoredClients.map(item => item.client);

                if (matches.length > 0) {
                    clientDropdown.innerHTML = matches.map(c => {
                        const id = String(c.id || c._id);
                        const safeName = (c.name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                        const safePhone = (c.phone || '').replace(/'/g, "\\'");
                        const safeDate = (c.updatedAt || '').replace(/'/g, "\\'");
                        return `
                    <div class="px-md py-sm hover:bg-surface-container-highest cursor-pointer border-b border-outline-variant/30 last:border-0 transition-colors"
                         onclick="selectClient('${id}', '${safeName}', '${safePhone}', ${c.balance || 0}, '${safeDate}')">
                        <div class="font-body-md text-on-surface font-bold">${highlightArabic(c.name, rawVal)}</div>
                        <div class="font-label-sm text-secondary dir-ltr text-right">${highlightArabic(c.phone || '', rawVal)}</div>
                    </div>
                `}).join('');
                    clientDropdown.classList.remove('hidden');
                } else {
                    clientDropdown.classList.add('hidden');
                }
            });

            function selectClient(id, name, phone, balance, lastTransaction) {
                clientIdInput.value = id;
                clientNameInput.value = name;
                document.getElementById('mobileNumber').value = phone && phone !== '-' ? phone : '';

                const balanceEl = document.getElementById('summaryBalance');
                balanceEl.textContent = formatCurrency(balance);
                balanceEl.className = `font-bold dir-ltr inline-block ${balance > 0 ? 'text-tertiary' : (balance < 0 ? 'text-error' : 'text-primary')}`;

                document.getElementById('summaryLastTransaction').textContent = lastTransaction ? formatDate(lastTransaction) : '--';
                document.getElementById('summaryProfileLink').href = `/client-details?id=${id}`;

                clientDropdown.classList.add('hidden');
                clientSummaryCard.classList.remove('hidden');
                clientSummaryCard.classList.add('flex');
            }

            // End Client Auto-complete Logic
            const endClientNameInput = document.getElementById('endClientName');
            const endClientDropdown = document.getElementById('endClientDropdown');
            const endClientIdInput = document.getElementById('endClientId');

            endClientNameInput.addEventListener('input', (e) => {
                const rawVal = e.target.value || '';
                const terms = [...new Set(rawVal.trim().split(/\s+/).filter(Boolean))];

                endClientIdInput.value = '';

                if (terms.length === 0) {
                    endClientDropdown.classList.add('hidden');
                    return;
                }

                const scoredEndClients = [];
                for (const ec of allEndClientsList) {
                    const normName = normalizeArabic(ec.name || '');
                    const phone = ec.phone || '';
                    let score = 0;
                    for (const term of terms) {
                        const normTerm = normalizeArabic(term);
                        const nameMatches = normTerm && normName.includes(normTerm);
                        const phoneMatches = phone && phone.includes(term);
                        if (nameMatches || phoneMatches) {
                            score++;
                        }
                    }
                    if (score > 0) {
                        scoredEndClients.push({ client: ec, score });
                    }
                }

                scoredEndClients.sort((a, b) => b.score - a.score);
                const matches = scoredEndClients.map(item => item.client);

                if (matches.length > 0) {
                    endClientDropdown.innerHTML = matches.map(ec => {
                        const id = String(ec.id || ec._id);
                        const safeName = (ec.name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                        return `
                    <div class="px-md py-sm hover:bg-surface-container-highest cursor-pointer border-b border-outline-variant/30 last:border-0 transition-colors"
                         onclick="selectEndClient('${id}', '${safeName}')">
                        <div class="font-body-md text-on-surface font-bold">${highlightArabic(ec.name, rawVal)}</div>
                        ${ec.phone && ec.phone !== '-' ? `<div class="font-label-sm text-secondary dir-ltr text-right">${highlightArabic(ec.phone, rawVal)}</div>` : ''}
                    </div>
                `}).join('');
                    endClientDropdown.classList.remove('hidden');
                } else {
                    endClientDropdown.classList.add('hidden');
                }
            });

            function selectEndClient(id, name) {
                endClientIdInput.value = id;
                endClientNameInput.value = name;
                endClientDropdown.classList.add('hidden');
            }

            document.addEventListener('click', (e) => {
                if (!clientNameInput.contains(e.target) && !clientDropdown.contains(e.target)) {
                    clientDropdown.classList.add('hidden');
                }
                if (!endClientNameInput.contains(e.target) && !endClientDropdown.contains(e.target)) {
                    endClientDropdown.classList.add('hidden');
                }
            });

            // Handle form submission — POST to API (create) or PATCH (update)
            document.getElementById('invoiceForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                const name = document.getElementById('clientName').value.trim();
                const endName = document.getElementById('endClientName').value.trim();
                const mobile = document.getElementById('mobileNumber').value.trim();
                const date = document.getElementById('invoiceDate').value;
                const amount = document.getElementById('invoiceAmount').value;
                const details = document.getElementById('invoiceDetails').value.trim();
                const address = document.getElementById('deliveryAddress').value.trim();
                const invoiceId = document.getElementById('invoiceId').value;

                if (validateFormFields('invoiceForm')) {
                    showToast('الرجاء إدخال اسم العميل', 'warning');
                    return;
                }

                const clientId = document.getElementById('clientId').value;
                const endClientId = document.getElementById('endClientId').value;

                try {
                    // Prepare data object
                    const payload = {
                        clientName: name,
                        endClientName: endName || undefined,
                        clientPhone: mobile || undefined,
                        date: date || undefined,
                        amount: parseFloat(amount) || 0,
                        details: details || '-',
                        address: address || '-'
                    };

                    // If updating, send PATCH; if creating, send POST
                    let res;
                    if (invoiceId) {
                        // Update existing invoice
                        res = await fetch(`/api/invoices/${invoiceId}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                    } else {
                        // Create new invoice
                        const createPayload = {
                            ...payload,
                            client: clientId || undefined,
                            endClientId: endClientId || undefined,
                            type: 'purchase'
                        };
                        res = await fetch('/api/invoices', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(createPayload)
                        });
                    }

                    if (res.ok) {
                        const successMsg = invoiceId ? 'تم تحديث الفاتورة بنجاح ✓' : 'تم حفظ الفاتورة بنجاح ✓';
                        showToast(successMsg, 'success');
                        closeModal();
                        loadInvoices();
                        loadClients();
                        loadEndClients();
                    } else {
                        const err = await res.json();
                        showToast(err.error || (invoiceId ? 'فشل في تحديث الفاتورة' : 'فشل في حفظ الفاتورة'), 'error');
                    }
                } catch (err) {
                    const errorMsg = invoiceId ? 'فشل في تحديث الفاتورة — تأكد من تشغيل السيرفر' : 'فشل في حفظ الفاتورة — تأكد من تشغيل السيرفر';
                    showToast(errorMsg, 'error');
                }
            });

            // Close modal when clicking outside
            document.getElementById('invoiceModal').addEventListener('click', function (e) {
                if (e.target === this) closeModal();
            });

            // Load data on start
            document.addEventListener('DOMContentLoaded', () => {
                loadInvoices();
                loadClients();
                loadEndClients();
            });
        </script>
</body>

</html>