</div>
<div class="flex items-center gap-md">
<button type="button" onclick="event.preventDefault(); event.stopPropagation(); logout();" class="p-base hover:bg-error-container/20 text-secondary hover:text-error rounded-full transition-colors active:opacity-80 cursor-pointer" title="تسجيل الخروج">
<span class="material-symbols-outlined">logout</span>
