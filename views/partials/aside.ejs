<aside
    class="hidden md:flex flex-col gap-md p-md fixed right-0 h-full w-64 bg-surface-container-lowest border-l border-line z-40 transition-all duration-300"
    id="sidebar">
    <div class="flex items-center gap-sm px-sm pt-sm pb-md border-b border-line/70">
        <img src="/images/logo.svg" alt="سجل الديون" class="w-11 h-11 object-contain shrink-0" />
        <div class="text-right min-w-0">
            <h1 class="font-bold text-primary text-[17px] leading-tight truncate">سجل الديون</h1>
            <p class="text-[11px] text-muted">إدارة مواد البناء</p>
        </div>
    </div>
    <nav class="flex flex-col gap-lg flex-grow overflow-y-auto custom-scrollbar" aria-label="التنقل الرئيسي">
        <div>
            <p class="px-md mb-xs text-[11px] font-bold text-muted">الرئيسية</p>
            <a class="relative flex flex-row items-center gap-md <%= active === 'dashboard' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-secondary font-medium' %> rounded-xl px-md py-sm hover:bg-wash transition-all"
                data-module="dashboard" href="/dashboard" <%= active === 'dashboard' ? 'aria-current="page"' : '' %>>
                <% if (active === 'dashboard') { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-6 rounded-full bg-primary"></span><% } %>
                <span class="material-symbols-outlined <%= active === 'dashboard' ? 'filled' : '' %>">dashboard</span>
                <span class="text-[14px] flex-grow text-right">لوحة القيادة</span>
            </a>
        </div>
        <div>
            <p class="px-md mb-xs text-[11px] font-bold text-muted">العمل اليومي</p>
            <div class="flex flex-col gap-xs">
            <a class="relative flex flex-row items-center gap-md <%= active === 'clients' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-secondary font-medium' %> rounded-xl px-md py-sm hover:bg-wash transition-all"
                data-module="clients" href="/clients" <%= active === 'clients' ? 'aria-current="page"' : '' %>>
                <% if (active === 'clients') { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-6 rounded-full bg-primary"></span><% } %>
                <span class="material-symbols-outlined <%= active === 'clients' ? 'filled' : '' %>">group</span>
                <span class="text-[14px] flex-grow text-right">العملاء</span>
            </a>
            <a class="relative flex flex-row items-center gap-md <%= active === 'invoices' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-secondary font-medium' %> rounded-xl px-md py-sm hover:bg-wash transition-all"
                data-module="invoices" href="/new-invoice" <%= active === 'invoices' ? 'aria-current="page"' : '' %>>
                <% if (active === 'invoices') { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-6 rounded-full bg-primary"></span><% } %>
                <span class="material-symbols-outlined <%= active === 'invoices' ? 'filled' : '' %>">receipt_long</span>
                <span class="text-[14px] flex-grow text-right">سجل الفواتير</span>
            </a>
            <a class="relative flex flex-row items-center gap-md <%= active === 'items' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-secondary font-medium' %> rounded-xl px-md py-sm hover:bg-wash transition-all"
                data-module="items" href="/items" <%= active === 'items' ? 'aria-current="page"' : '' %>>
                <% if (active === 'items') { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-6 rounded-full bg-primary"></span><% } %>
                <span class="material-symbols-outlined <%= active === 'items' ? 'filled' : '' %>">inventory_2</span>
                <span class="text-[14px] flex-grow text-right">كتالوج الأصناف</span>
            </a>
            <a class="relative flex flex-row items-center gap-md <%= active === 'suppliers' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-secondary font-medium' %> rounded-xl px-md py-sm hover:bg-wash transition-all"
                data-module="suppliers" href="/suppliers" <%= active === 'suppliers' ? 'aria-current="page"' : '' %>>
                <% if (active === 'suppliers') { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-6 rounded-full bg-primary"></span><% } %>
                <span class="material-symbols-outlined <%= active === 'suppliers' ? 'filled' : '' %>">local_shipping</span>
                <span class="text-[14px] flex-grow text-right">الموردين</span>
            </a>
            </div>
        </div>
        <div>
            <p class="px-md mb-xs text-[11px] font-bold text-muted">النظام</p>
            <div class="flex flex-col gap-xs">
            <a data-requires-admin class="relative flex flex-row items-center gap-md <%= active === 'users' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-secondary font-medium' %> rounded-xl px-md py-sm hover:bg-wash transition-all"
                href="/users" <%= active === 'users' ? 'aria-current="page"' : '' %>>
                <% if (active === 'users') { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-6 rounded-full bg-primary"></span><% } %>
                <span class="material-symbols-outlined <%= active === 'users' ? 'filled' : '' %>">manage_accounts</span>
                <span class="text-[14px] flex-grow text-right">المستخدمون</span>
            </a>
            <a class="relative flex flex-row items-center gap-md <%= active === 'status' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-secondary font-medium' %> rounded-xl px-md py-sm hover:bg-wash transition-all"
                href="/status" <%= active === 'status' ? 'aria-current="page"' : '' %>>
                <% if (active === 'status') { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-6 rounded-full bg-primary"></span><% } %>
                <span class="material-symbols-outlined <%= active === 'status' ? 'filled' : '' %>">dns</span>
                <span class="text-[14px] flex-grow text-right">حالة النظام</span>
            </a>
            </div>
        </div>
    </nav>
    <div class="mt-auto pt-sm border-t border-line/70">
        <div class="flex flex-row items-center justify-between gap-sm bg-wash p-sm rounded-xl">
            <div class="flex items-center gap-sm overflow-hidden">
                <div class="w-10 h-10 rounded-full overflow-hidden bg-primary-container flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-primary">account_circle</span>
                </div>
                <div class="text-right overflow-hidden flex flex-col">
                    <p class="text-sm font-bold text-on-surface truncate user-display-name">شركة مواد البناء</p>
                    <p class="text-[11px] text-muted truncate user-role-name">مدير الحسابات</p>
                </div>
            </div>
            <div class="flex items-center gap-xs shrink-0">
            <button type="button" onclick="event.preventDefault(); event.stopPropagation(); openPasswordModal();"
                class="p-sm hover:bg-primary/10 text-secondary hover:text-primary rounded-lg transition-colors shrink-0 cursor-pointer z-10"
                title="تغيير كلمة المرور" aria-label="تغيير كلمة المرور">
                <span class="material-symbols-outlined text-[20px]">key</span>
            </button>
            <button type="button" onclick="event.preventDefault(); event.stopPropagation(); logout();"
                class="p-sm hover:bg-error-container/20 text-secondary hover:text-error rounded-lg transition-colors shrink-0 cursor-pointer z-10"
                title="تسجيل الخروج" aria-label="تسجيل الخروج">
                <span class="material-symbols-outlined text-[20px]">logout</span>
            </button>
            </div>
        </div>
    </div>
</aside>
