<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>حالة النظام - سجل الديون</title>
    <meta name="description" content="عرض حالة النشر وقاعدة البيانات"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/js/tailwind-config.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="/css/styles.css" rel="stylesheet"/>
</head>
<body class="bg-background text-on-surface min-h-screen overflow-x-hidden">

<!-- Side Navigation (Desktop Only) -->
<%- include('partials/aside', { active: 'status' }) %>

<!-- Main Content Canvas -->
<main class="pt-md pb-32 px-container-margin md:mr-64 min-h-screen">
    <!-- TopNavBar (Mobile & Tablet) -->
    <%- include('partials/header', { title: 'حالة النظام' }) %>

    <div class="max-w-4xl mx-auto space-y-lg" id="mainContent">

        <!-- Page Header & Action Bar -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md bg-white rounded-xl border border-outline-variant p-lg shadow-sm">
            <div>
                <h1 class="font-headline-md text-headline-md font-bold text-on-surface flex items-center gap-xs">
                    <span class="material-symbols-outlined text-primary text-2xl">dns</span>
                    حالة النظام والمعلومات البرمجية
                </h1>
                <p class="text-sm text-secondary mt-1">مراقبة حالة عملية النشر الأخيرة على Vercel وحالة قاعدة البيانات</p>
            </div>
            <button onclick="window.location.reload()" type="button" class="px-lg py-sm bg-primary text-on-primary rounded-full font-label-md text-label-md hover:opacity-90 active:scale-95 transition-all flex items-center gap-xs shadow-xs self-end sm:self-auto cursor-pointer">
                <span class="material-symbols-outlined text-lg">refresh</span>
                تحديث
            </button>
        </div>

        <div class="grid grid-cols-1 gap-lg">

            <!-- Card 1: Vercel Deployment Status -->
            <div class="bg-white rounded-xl border border-outline-variant p-lg shadow-sm space-y-md">
                <div class="flex justify-between items-center border-b border-outline-variant/40 pb-md">
                    <div class="flex items-center gap-sm">
                        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold">
                            <span class="material-symbols-outlined text-xl">rocket_launch</span>
                        </div>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">آخر عملية نشر (Vercel Deployment)</h2>
                            <p class="text-xs text-secondary">معلومات البيئة وحالة الـ Deployment الأخير</p>
                        </div>
                    </div>

                    <% if (deployment.error) { %>
                        <span class="px-md py-xs rounded-full font-label-sm text-label-sm border bg-amber-50 text-amber-800 border-amber-300 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                            تعذر الاتصال بـ Vercel
                        </span>
                    <% } else if (deployment.state === 'READY') { %>
                        <span class="px-md py-xs rounded-full font-label-sm text-label-sm border bg-green-50 text-green-800 border-green-300 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-green-600"></span>
                            نشط وشغال
                        </span>
                    <% } else if (deployment.state === 'ERROR') { %>
                        <span class="px-md py-xs rounded-full font-label-sm text-label-sm border bg-red-50 text-red-800 border-red-300 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
                            فشل النشر
                        </span>
                    <% } else if (['BUILDING', 'QUEUED', 'INITIALIZING'].includes(deployment.state)) { %>
                        <span class="px-md py-xs rounded-full font-label-sm text-label-sm border bg-amber-50 text-amber-800 border-amber-300 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
                            جاري النشر الآن (<%= deployment.state %>)
                        </span>
                    <% } else { %>
                        <span class="px-md py-xs rounded-full font-label-sm text-label-sm border bg-gray-50 text-gray-800 border-gray-300 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                            <%= deployment.state %>
                        </span>
                    <% } %>
                </div>

                <% if (deployment.error) { %>
                    <!-- Vercel API Error / Missing Token Warning -->
                    <div class="bg-amber-50 border border-amber-200 text-amber-900 rounded-xl p-md space-y-sm text-sm">
                        <div class="flex items-center gap-xs font-bold text-amber-800">
                            <span class="material-symbols-outlined text-xl text-amber-600">warning</span>
                            <span>تعذر جلب بيانات النشر من Vercel</span>
                        </div>
                        <p class="pr-6"><%= deployment.error %></p>
                        <% if (deployment.details) { %>
                            <p class="pr-6 text-xs text-amber-700 font-mono dir-ltr text-right bg-amber-100/50 p-sm rounded-lg"><%= deployment.details %></p>
                        <% } %>
                        <p class="pr-6 text-xs text-amber-800">
                            تأكد من ضبط المتغيرات البيئية <code class="bg-amber-200 px-1 py-0.5 rounded font-mono">VERCEL_API_TOKEN</code> و <code class="bg-amber-200 px-1 py-0.5 rounded font-mono">VERCEL_PROJECT_ID</code> في إعدادات مشروك على Vercel أو في ملف <code class="bg-amber-200 px-1 py-0.5 rounded font-mono">.env</code> المحلي.
                        </p>
                    </div>
                <% } else { %>
                    <!-- Deployment Details Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-md pt-sm">
                        <div class="bg-surface-container-low p-sm rounded-xl border border-outline-variant/30 space-y-1">
                            <span class="text-xs text-secondary font-medium">تاريخ ووقت النشر</span>
                            <p class="font-bold text-on-surface text-sm" id="deploymentDate">
                                <%= new Date(deployment.createdAt).toLocaleString('ar-EG', { dateStyle: 'full', timeStyle: 'short' }) %>
                            </p>
                        </div>

                        <div class="bg-surface-container-low p-sm rounded-xl border border-outline-variant/30 space-y-1">
                            <span class="text-xs text-secondary font-medium">رابط الـ Deployment</span>
                            <p class="text-sm font-bold text-primary truncate" dir="ltr">
                                <% if (deployment.url) { %>
                                    <a href="<%= deployment.url %>" target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center justify-end gap-1">
                                        <span><%= deployment.url %></span>
                                        <span class="material-symbols-outlined text-xs">open_in_new</span>
                                    </a>
                                <% } else { %>
                                    <span class="text-secondary">-</span>
                                <% } %>
                            </p>
                        </div>

                        <% if (deployment.commitMessage) { %>
                            <div class="md:col-span-2 bg-surface-container-low p-sm rounded-xl border border-outline-variant/30 space-y-1">
                                <span class="text-xs text-secondary font-medium">رسالة الـ Commit</span>
                                <p class="font-mono text-sm text-on-surface bg-surface/60 p-xs rounded border border-outline-variant/20 dir-ltr text-right">
                                    <%= deployment.commitMessage %>
                                </p>
                            </div>
                        <% } %>
                    </div>

                    <% if (deployment.state === 'ERROR') { %>
                        <!-- Deployment Failure Alert Box -->
                        <div class="bg-red-50 border border-red-200 text-red-900 rounded-xl p-md space-y-sm">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-xs font-bold text-red-800">
                                    <span class="material-symbols-outlined text-xl text-red-600">error</span>
                                    <span>تفاصيل خطأ النشر (Deployment Error)</span>
                                </div>
                                <% if (deployment.dashboardUrl) { %>
                                    <a href="<%= deployment.dashboardUrl %>" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-red-700 hover:text-red-900 underline flex items-center gap-0.5">
                                        <span>عرض التفاصيل الكاملة على Vercel</span>
                                        <span class="material-symbols-outlined text-xs">open_in_new</span>
                                    </a>
                                <% } %>
                            </div>
                            <div class="bg-white/80 border border-red-200 p-sm rounded-lg font-mono text-xs text-red-800 dir-ltr text-right whitespace-pre-wrap max-h-48 overflow-y-auto">
                                <%= deployment.errorMessage %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </div>

            <!-- Card 2: Database Connection Status -->
            <div class="bg-white rounded-xl border border-outline-variant p-lg shadow-sm space-y-md">
                <div class="flex justify-between items-center border-b border-outline-variant/40 pb-md">
                    <div class="flex items-center gap-sm">
                        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold">
                            <span class="material-symbols-outlined text-xl">database</span>
                        </div>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">حالة قاعدة البيانات (Supabase PostgreSQL)</h2>
                            <p class="text-xs text-secondary">التحقق من الاتصال وزمن الاستجابة (Latency)</p>
                        </div>
                    </div>

                    <% if (dbStatus.connected) { %>
                        <span class="px-md py-xs rounded-full font-label-sm text-label-sm border bg-green-50 text-green-800 border-green-300 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-green-600"></span>
                            متصلة وتعمل بشكل طبيعي
                        </span>
                    <% } else { %>
                        <span class="px-md py-xs rounded-full font-label-sm text-label-sm border bg-red-50 text-red-800 border-red-300 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
                            غير متصلة
                        </span>
                    <% } %>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-md pt-sm">
                    <div class="bg-surface-container-low p-sm rounded-xl border border-outline-variant/30 space-y-1">
                        <span class="text-xs text-secondary font-medium">حالة الاتصال</span>
                        <p class="font-bold text-sm <%= dbStatus.connected ? 'text-green-700' : 'text-red-700' %>">
                            <%= dbStatus.connected ? 'متصل بنجاح (SELECT 1)' : 'فشل في الاتصال' %>
                        </p>
                    </div>

                    <div class="bg-surface-container-low p-sm rounded-xl border border-outline-variant/30 space-y-1">
                        <span class="text-xs text-secondary font-medium">زمن الاستجابة (Latency)</span>
                        <p class="font-bold text-sm text-on-surface flex items-center gap-1">
                            <span><%= dbStatus.latencyMs %> مللي ثانية (ms)</span>
                            <% if (dbStatus.latencyMs < 200) { %>
                                <span class="text-xs text-green-600 font-normal">(سريع جداً)</span>
                            <% } else if (dbStatus.latencyMs < 800) { %>
                                <span class="text-xs text-amber-600 font-normal">(متوسط)</span>
                            <% } else { %>
                                <span class="text-xs text-red-600 font-normal">(بطيء)</span>
                            <% } %>
                        </p>
                    </div>
                </div>

                <% if (!dbStatus.connected) { %>
                    <!-- Database Connection Failure Callout -->
                    <div class="bg-red-50 border border-red-200 text-red-900 rounded-xl p-md space-y-sm">
                        <div class="flex items-center gap-xs font-bold text-red-800">
                            <span class="material-symbols-outlined text-xl text-red-600">report_problem</span>
                            <span>رسالة الخطأ المختصرة</span>
                        </div>
                        <p class="font-mono text-xs text-red-800 bg-white/80 p-sm rounded border border-red-200 dir-ltr text-right">
                            <%= dbStatus.error %>
                        </p>
                    </div>
                <% } %>
            </div>

        </div>

    </div>

    <!-- Mobile Bottom Nav -->
    <%- include('partials/bottom-nav', { active: 'status' }) %>
</main>

<script src="/js/shared-ui.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', async () => {
        // Authenticate user session
        await checkAuth();
    });
</script>
</body>
</html>
