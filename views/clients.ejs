<script src="/js/shared-ui.js"></script>
<script>
let allClients = [];
let currentSortField = 'createdAt'; // 'createdAt', 'name', 'phone', or 'balance'
let currentSortOrder = 'desc'; // 'asc' or 'desc'
let activeBalanceFilter = null; // null, 'credit', or 'debt'

function escapeJsString(value = '') {
    return String(value)
        .replace(/\\/g, '\\\\')
        .replace(/'/g, "\\'")
        .replace(/\n/g, '\\n');
}

function sortClientsList(clients) {
    const list = [...clients];
    list.sort((a, b) => {
        let cmp = 0;
        if (currentSortField === 'name') {
            const nameA = (a.name || '').trim();
            const nameB = (b.name || '').trim();
            cmp = nameA.localeCompare(nameB, 'ar', { sensitivity: 'base' });
        } else if (currentSortField === 'phone') {
            const phoneA = (a.phone || '').trim();
            const phoneB = (b.phone || '').trim();
            cmp = phoneA.localeCompare(phoneB, 'ar', { numeric: true });
        } else if (currentSortField === 'pageNumber') {
            const pageA = Number(a.pageNumber) || 0;
            const pageB = Number(b.pageNumber) || 0;
            cmp = pageA - pageB;
        } else if (currentSortField === 'balance') {
            const balA = Number(a.balance) || 0;
            const balB = Number(b.balance) || 0;
            cmp = balA - balB;
        } else {
            const timeA = new Date(a.createdAt || a.updatedAt || 0).getTime() || (Number(a.id) || 0);
            const timeB = new Date(b.createdAt || b.updatedAt || 0).getTime() || (Number(b.id) || 0);
            cmp = timeA - timeB;
        }
        return currentSortOrder === 'asc' ? cmp : -cmp;
    });
    return list;
}

// Load clients from API
async function loadClients() {
    const user = await checkAuth();
    if (!user) return;
    
    // Update user display names
    document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
    document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');

    // Setup Validation
    setupPhoneValidation('newClientPhone', 'newClientPhoneError');

    try {
        const res = await fetch('/api/clients?limit=1000');
        const responseData = await res.json();
        allClients = responseData.data || [];
        updateStats(responseData);
        applyFiltersAndSort();
    } catch (err) {
        console.error('Failed to load clients:', err);
        showToast('فشل في تحميل بيانات العملاء', 'error');
    }
}

function updateStats(responseData) {
    const stats = responseData.stats || {};
    const creditCount = stats.creditCount !== undefined ? stats.creditCount : allClients.filter(c => (Number(c.balance) || 0) <= 0).length;
    const creditTotal = stats.creditTotal !== undefined ? stats.creditTotal : allClients.filter(c => (Number(c.balance) || 0) <= 0).reduce((sum, c) => sum + Math.abs(Number(c.balance) || 0), 0);
    const debtCount = stats.debtCount !== undefined ? stats.debtCount : allClients.filter(c => (Number(c.balance) || 0) > 0).length;
    const debtTotal = stats.debtTotal !== undefined ? stats.debtTotal : allClients.filter(c => (Number(c.balance) || 0) > 0).reduce((sum, c) => sum + (Number(c.balance) || 0), 0);

    const creditTotalEl = document.getElementById('statCreditTotal');
    if (creditTotalEl) creditTotalEl.textContent = formatCurrency(creditTotal);
    const creditCountEl = document.getElementById('statCreditCount');
    if (creditCountEl) creditCountEl.textContent = `(${creditCount} عميل)`;

    const debtTotalEl = document.getElementById('statDebtTotal');
    if (debtTotalEl) debtTotalEl.textContent = formatCurrency(debtTotal);
    const debtCountEl = document.getElementById('statDebtCount');
    if (debtCountEl) debtCountEl.textContent = `(${debtCount} عميل)`;
}

function toggleBalanceFilter(type) {
    if (activeBalanceFilter === type) {
        activeBalanceFilter = null;
    } else {
        activeBalanceFilter = type;
    }
    updateBalanceFilterUI();
    applyFiltersAndSort();
}

function updateBalanceFilterUI() {
    const cardCredit = document.getElementById('cardFilterCredit');
    const cardDebt = document.getElementById('cardFilterDebt');
    
    if (!cardCredit || !cardDebt) return;

    if (activeBalanceFilter === 'credit') {
        cardCredit.className = "bg-green-50 border-2 border-green-600 rounded-xl p-md flex items-center justify-between shadow-md cursor-pointer transition-all select-none group ring-2 ring-green-600/20";
        cardDebt.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-tertiary/60 opacity-60 transition-all select-none group";
    } else if (activeBalanceFilter === 'debt') {
        cardCredit.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-green-600/60 opacity-60 transition-all select-none group";
        cardDebt.className = "bg-tertiary-fixed/20 border-2 border-tertiary rounded-xl p-md flex items-center justify-between shadow-md cursor-pointer transition-all select-none group ring-2 ring-tertiary/20";
    } else {
        cardCredit.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-green-600/60 transition-all select-none group";
        cardDebt.className = "bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-tertiary/60 transition-all select-none group";
    }
}

function toggleHeaderSort(field) {
    if (currentSortField === field) {
        currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
    } else {
        currentSortField = field;
        currentSortOrder = (field === 'createdAt' || field === 'balance') ? 'desc' : 'asc';
    }
    updateHeaderSortIcons();

    const labelMap = {
        'createdAt': 'تاريخ الإضافة',
        'name': 'الاسم',
        'phone': 'رقم الهاتف',
        'pageNumber': 'رقم الصفحة',
        'balance': 'الرصيد'
    };
    const label = labelMap[field] || 'تاريخ الإضافة';
    const sortLabelEl = document.getElementById('sortSelectedLabel');
    if (sortLabelEl) sortLabelEl.textContent = label;
    const sortOrderIcon = document.getElementById('sortOrderIcon');
    if (sortOrderIcon) sortOrderIcon.textContent = currentSortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward';

    applyFiltersAndSort();
}

function updateHeaderSortIcons() {
    ['name', 'phone', 'pageNumber', 'balance', 'createdAt'].forEach(field => {
        const icon = document.getElementById(`sortHeaderIcon_${field}`);
        if (!icon) return;
        if (currentSortField === field) {
            icon.textContent = currentSortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward';
            icon.className = "material-symbols-outlined text-sm font-bold text-primary";
        } else {
            icon.textContent = "unfold_more";
            icon.className = "material-symbols-outlined text-sm font-bold text-outline opacity-60";
        }
    });
}

function applyFiltersAndSort() {
    let list = [...allClients];

    if (activeBalanceFilter === 'credit') {
        list = list.filter(c => (Number(c.balance) || 0) <= 0);
    } else if (activeBalanceFilter === 'debt') {
        list = list.filter(c => (Number(c.balance) || 0) > 0);
    }

    const sortedList = sortClientsList(list);
    renderClients(sortedList, true);
}

let currentClientsList = [];
let clientsCurrentPage = 1;
let clientsPageSize = 10;

// Custom Page Size Dropdown Functions
function toggleClientsPageSizeDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('clientsPageSizeMenu');
    const arrow = document.getElementById('clientsPageSizeArrow');
    const isHidden = menu.classList.contains('hidden');
    
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        arrow.classList.add('rotate-180');
    } else {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

function selectClientsPageSize(val) {
    clientsPageSize = Number(val);
    document.getElementById('clientsPageSizeLabel').textContent = val;
    
    // Update checkmarks
    [10, 25, 50, 100].forEach(size => {
        const check = document.getElementById(`size-check-${size}`);
        if (check) check.classList.toggle('hidden', size !== clientsPageSize);
    });
    
    // Close menu
    const menu = document.getElementById('clientsPageSizeMenu');
    const arrow = document.getElementById('clientsPageSizeArrow');
    menu.classList.add('opacity-0', 'scale-95');
    menu.classList.remove('opacity-100', 'scale-100');
    arrow.classList.remove('rotate-180');
    setTimeout(() => menu.classList.add('hidden'), 150);
    
    clientsCurrentPage = 1;
    renderClients(currentClientsList);
}

document.getElementById('clientsPageSizeBtn').addEventListener('click', toggleClientsPageSizeDropdown);

document.addEventListener('click', (e) => {
    const container = document.getElementById('clientsPageSizeContainer');
    if (container && !container.contains(e.target)) {
        const menu = document.getElementById('clientsPageSizeMenu');
        const arrow = document.getElementById('clientsPageSizeArrow');
        if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('opacity-0', 'scale-95');
            menu.classList.remove('opacity-100', 'scale-100');
            arrow.classList.remove('rotate-180');
            setTimeout(() => menu.classList.add('hidden'), 150);
        }
    }
});

function renderClients(clients, resetPage = false) {
    currentClientsList = clients;
    if (resetPage) clientsCurrentPage = 1;

    const tbody = document.getElementById('clientsTableBody');
    const query = document.getElementById('searchInput').value;
    const totalRecords = clients.length;

    if (totalRecords === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-xl text-center text-secondary">لا يوجد عملاء مسجلين</td></tr>';
        renderPaginationControls({
            containerId: 'clientsPaginationControls',
            infoId: 'clientsPaginationInfo',
            currentPage: 1,
            pageSize: clientsPageSize,
            totalRecords: 0,
            unitLabel: 'عميل',
            onPageChange: () => {}
        });
        return;
    }

    const totalPages = Math.ceil(totalRecords / clientsPageSize) || 1;
    if (clientsCurrentPage > totalPages) clientsCurrentPage = totalPages;
    if (clientsCurrentPage < 1) clientsCurrentPage = 1;

    const startIndex = (clientsCurrentPage - 1) * clientsPageSize;
    const endIndex = Math.min(startIndex + clientsPageSize, totalRecords);
    const pagedClients = clients.slice(startIndex, endIndex);

    tbody.innerHTML = pagedClients.map((client, index) => {
        const clientName = client.name || '';
        const initial = clientName.charAt(0) || '-';
        const clientBalance = Number(client.balance) || 0;
        const balanceColor = clientBalance > 0 ? 'text-tertiary' : 'text-primary-container';
        const matchedList = Array.isArray(client.matchedEndClients) ? client.matchedEndClients : [];
        const matchedCount = client.matchedEndClientsCount || matchedList.length;
        const hasMatchedEndClients = matchedCount > 0;
        return `
            <tr onclick="window.location.href='/client-details?id=${client.id}'" class="cursor-pointer hover:bg-primary/10 transition-all duration-200 group" style="opacity:0;transform:translateY(10px);animation:fadeInRow 0.4s ease ${index * 0.05}s forwards;">
                <td class="px-lg py-md">
                    <div class="flex items-center gap-md">
                        <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container font-bold group-hover:scale-105 transition-transform">${initial}</div>
                        <div class="flex flex-col">
                            <span class="font-body-md text-body-md text-on-surface font-bold group-hover:text-primary transition-colors">${highlightArabic(clientName, query)}</span>
                        </div>
                    </div>
                </td>
                <td class="px-lg py-md font-body-md text-body-md text-secondary" dir="ltr">${highlightArabic(client.phone || '', query)}</td>
                <td class="px-lg py-md font-body-md text-body-md text-secondary">
                    ${hasMatchedEndClients ? `
                        <span class="font-bold text-on-surface-variant">${matchedList.slice(0, 3).map(n => highlightArabic(n || '', query)).join('، ')}</span>${matchedCount > 3 ? `<span class="text-xs text-secondary font-bold"> (+${matchedCount - 3} آخرين)</span>` : ''}
                    ` : '-'}
                </td>
                <td class="px-lg py-md">
                    <span class="font-body-md text-body-md ${client.pageNumber ? 'text-on-surface font-bold' : 'text-secondary'}">${client.pageNumber ? client.pageNumber : '-'}</span>
                </td>
                <td class="px-lg py-md">
                    <span class="font-headline-sm text-headline-sm ${balanceColor}">${formatCurrency(clientBalance)}</span>
                </td>
                <td class="px-lg py-md">
                    <div class="flex flex-col">
                        <span class="font-body-md text-body-md text-on-surface">${formatDate(client.lastTransaction)}</span>
                        <span class="font-label-sm text-label-sm text-outline">${client.lastTransactionNote || client.notes || ''}</span>
                    </div>
                </td>
                <td class="px-lg py-md">
                    <div class="flex items-center justify-center gap-sm">
                        <a href="/client-details?id=${client.id}" onclick="event.stopPropagation();" class="p-sm rounded-lg hover:bg-surface-container-highest text-primary transition-all active:scale-90" title="عرض">
                            <span class="material-symbols-outlined">visibility</span>
                        </a>
                        <button onclick="event.stopPropagation(); openEditClientModal('${client.id}', '${escapeJsString(clientName)}', '${escapeJsString(client.phone || '')}', '${escapeJsString(client.address || '')}', '${client.pageNumber ?? 0}')" class="p-sm rounded-lg hover:bg-primary/10 text-primary transition-all active:scale-90" title="تعديل">
                            <span class="material-symbols-outlined">edit</span>
                        </button>
                        <button onclick="event.stopPropagation(); deleteClient('${client.id}', '${escapeJsString(clientName)}')" class="p-sm rounded-lg hover:bg-error-container/20 text-error transition-all active:scale-90" title="حذف">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }).join('');



    renderPaginationControls({
        containerId: 'clientsPaginationControls',
        infoId: 'clientsPaginationInfo',
        currentPage: clientsCurrentPage,
        pageSize: clientsPageSize,
        totalRecords: totalRecords,
        unitLabel: 'عميل',
        onPageChange: (newPage) => {
            clientsCurrentPage = newPage;
            renderClients(currentClientsList);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
}

// Custom Sort Dropdown Functions
function toggleSortDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('sortDropdownMenu');
    const arrow = document.getElementById('sortDropdownArrow');
    const isHidden = menu.classList.contains('hidden');
    
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        arrow.classList.add('rotate-180');
    } else {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

function selectSortOption(field, label) {
    currentSortField = field;
    document.getElementById('sortSelectedLabel').textContent = label;
    
    // Update checkmarks
    ['createdAt', 'name', 'phone', 'balance'].forEach(f => {
        const chk = document.getElementById(`check-${f}`);
        if (chk) chk.classList.toggle('hidden', f !== field);
    });
    
    updateHeaderSortIcons();

    // Close menu
    const menu = document.getElementById('sortDropdownMenu');
    const arrow = document.getElementById('sortDropdownArrow');
    if (menu) {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        if (arrow) arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
    
    applyFiltersAndSort();
}

document.getElementById('sortDropdownBtn').addEventListener('click', toggleSortDropdown);

document.addEventListener('click', (e) => {
    const container = document.getElementById('sortDropdownContainer');
    if (container && !container.contains(e.target)) {
        const menu = document.getElementById('sortDropdownMenu');
        const arrow = document.getElementById('sortDropdownArrow');
        if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('opacity-0', 'scale-95');
            menu.classList.remove('opacity-100', 'scale-100');
            arrow.classList.remove('rotate-180');
            setTimeout(() => menu.classList.add('hidden'), 150);
        }
    }
});

document.getElementById('sortOrderToggle').addEventListener('click', () => {
    currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
    document.getElementById('sortOrderIcon').textContent = currentSortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward';
    updateHeaderSortIcons();
    applyFiltersAndSort();
});

// Unified Search with 300ms Debounce
let searchDebounceTimer = null;

document.getElementById('searchInput').addEventListener('input', (e) => {
    const rawVal = (e.target.value || '').trim();
    const endClientsSection = document.getElementById('endClientResultsSection');
    const endClientsGrid = document.getElementById('endClientResultsGrid');

    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);

    if (rawVal.length === 0) {
        endClientsSection.classList.add('hidden');
        renderClients(sortClientsList(allClients), true);
        updateStats(allClients);
        return;
    }

    searchDebounceTimer = setTimeout(async () => {
        try {
            const res = await fetch(`/api/search?q=${encodeURIComponent(rawVal)}`);
            if (!res.ok) throw new Error('Search failed');
            const data = await res.json();
            
            const contractors = data.contractors || [];
            const endClientMatches = data.endClientMatches || [];

            // Render contractors table
            renderClients(contractors, true);

            // Render End Clients results section
            if (endClientMatches.length > 0) {
                endClientsGrid.innerHTML = endClientMatches.map(item => {
                    const primaryContractorId = item.contractors[0] ? item.contractors[0].id : '';
                    const encodedName = encodeURIComponent(item.endClientName);
                    const cardUrl = primaryContractorId ? `/client-details?id=${primaryContractorId}&filterEndClient=${encodedName}` : '#';
                    return `
                    <div onclick="if ('${cardUrl}' !== '#') window.location.href='${cardUrl}'"
                         class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md shadow-sm flex flex-col gap-sm cursor-pointer hover:border-primary/60 hover:shadow-md transition-all">
                        <div class="flex items-center gap-sm border-b border-outline-variant/40 pb-xs">
                            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold">
                                <span class="material-symbols-outlined text-lg">person_pin</span>
                            </div>
                            <h4 class="font-headline-sm text-headline-sm font-bold text-on-surface">${highlightArabic(item.endClientName, rawVal)}</h4>
                        </div>
                        <div class="text-xs text-secondary space-y-1">
                            <span class="font-medium text-on-surface-variant block mb-1">عن طريق:</span>
                            <div class="flex flex-wrap gap-xs">
                                ${item.contractors.map(c => `
                                    <a href="/client-details?id=${c.id}&filterEndClient=${encodedName}" onclick="event.stopPropagation();" class="inline-flex items-center gap-1 bg-surface-container-low hover:bg-primary/10 text-primary px-sm py-1 rounded-lg border border-outline-variant/60 transition-colors">
                                        <span class="font-bold">${c.name}</span>
                                        <span class="text-secondary text-[11px]">(${c.invoiceCount} فاتورة)</span>
                                    </a>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                `}).join('');
                endClientsSection.classList.remove('hidden');
            } else {
                endClientsSection.classList.add('hidden');
            }


            // Empty state check
            if (contractors.length === 0 && endClientMatches.length === 0) {
                const tbody = document.getElementById('clientsTableBody');
                tbody.innerHTML = '<tr><td colspan="7" class="p-xl text-center text-secondary">لا توجد نتائج مطابقة للبحث</td></tr>';
            }

        } catch (err) {
            console.error('Search error:', err);
        }
    }, 300);
});

// Delete client
async function deleteClient(id, name) {
    const confirmed = await showConfirm(`هل أنت متأكد من حذف العميل "${name}"؟ سيتم حذف جميع فواتيره أيضاً.`);
    if (!confirmed) return;
    try {
        const res = await fetch(`/api/clients/${id}`, { method: 'DELETE' });
        if (res.ok) {
            showToast(`تم حذف العميل "${name}" بنجاح`, 'success');
            loadClients();
        } else {
            showToast('فشل في حذف العميل', 'error');
        }
    } catch (err) {
        showToast('فشل في حذف العميل', 'error');
    }
}

// Add Client Modal & Validation
const newClientNameInput = document.getElementById('newClientName');
const newClientNameDropdown = document.getElementById('newClientNameDropdown');
const newClientNameError = document.getElementById('newClientNameError');
const newClientPhoneInput = document.getElementById('newClientPhone');
const newClientPhoneError = document.getElementById('newClientPhoneError');
const submitBtn = document.querySelector('#addClientForm button[type="submit"]');

function validateClientNameDuplicate() {
    const rawVal = (newClientNameInput.value || '').trim();
    const val = normalizeArabic(rawVal);
    
    if (!val) {
        newClientNameError.classList.add('hidden');
        newClientNameInput.classList.remove('border-error');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        return false;
    }
    
    const exists = allClients.some(c => normalizeArabic(c.name || '') === val);
    
    if (exists) {
        newClientNameError.textContent = 'العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة';
        newClientNameError.classList.remove('hidden');
        newClientNameInput.classList.add('border-error');
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        return true;
    } else {
        newClientNameError.classList.add('hidden');
        newClientNameInput.classList.remove('border-error');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        return false;
    }
}

let newClientSearchDebounce = null;

async function updateNewClientSuggestions(rawVal) {
    if (!newClientNameDropdown) return;
    const val = (rawVal || '').trim();

    if (val.length === 0) {
        newClientNameDropdown.classList.add('hidden');
        return;
    }

    if (newClientSearchDebounce) clearTimeout(newClientSearchDebounce);

    newClientSearchDebounce = setTimeout(async () => {
        try {
            const res = await fetch(`/api/search?q=${encodeURIComponent(val)}`);
            if (!res.ok) return;
            const data = await res.json();

            const contractors = data.contractors || [];
            const endClientMatches = data.endClientMatches || [];

            if (contractors.length === 0 && endClientMatches.length === 0) {
                newClientNameDropdown.classList.add('hidden');
                return;
            }

            let html = '';

            if (contractors.length > 0) {
                html += `
                    <div class="px-md py-xs bg-surface-container-low text-[11px] font-bold text-secondary border-b border-outline-variant/30 flex items-center justify-between">
                        <span>عملاء (مقاولون) مسجلون بأسماء مشابهة:</span>
                        <span class="text-primary">${contractors.length} عميل</span>
                    </div>
                `;
                html += contractors.map(c => {
                    const id = String(c.id || c._id);
                    const phoneStr = c.phone && c.phone !== '-' ? c.phone : '';
                    return `
                        <a href="/client-details?id=${id}" target="_blank" class="px-md py-sm hover:bg-primary/10 cursor-pointer border-b border-outline-variant/30 last:border-0 transition-colors flex items-center justify-between no-underline block">
                            <div class="font-body-md text-on-surface font-bold hover:text-primary flex items-center gap-xs">
                                <span class="material-symbols-outlined text-sm text-primary">person</span>
                                <span>${highlightArabic(c.name, val)}</span>
                            </div>
                            <div class="flex items-center gap-xs">
                                ${phoneStr ? `<span class="font-label-sm text-secondary dir-ltr text-right">${highlightArabic(phoneStr, val)}</span>` : ''}
                                <span class="material-symbols-outlined text-xs text-outline">open_in_new</span>
                            </div>
                        </a>
                    `;
                }).join('');
            }

            if (endClientMatches.length > 0) {
                html += `
                    <div class="px-md py-xs bg-surface-container-low text-[11px] font-bold text-tertiary border-b border-outline-variant/30 flex items-center justify-between ${contractors.length > 0 ? 'border-t border-outline-variant/40' : ''}">
                        <span>عملاء نهائيون مسجلون بأسماء مشابهة:</span>
                        <span class="text-tertiary">${endClientMatches.length} عميل نهائي</span>
                    </div>
                `;
                html += endClientMatches.map(ec => {
                    const primaryContractor = ec.contractors && ec.contractors[0];
                    const primaryContractorId = primaryContractor ? primaryContractor.id : '';
                    const encodedName = encodeURIComponent(ec.endClientName);
                    const cardUrl = primaryContractorId ? `/client-details?id=${primaryContractorId}&filterEndClient=${encodedName}` : '#';
                    return `
                        <a href="${cardUrl}" target="_blank" class="px-md py-sm hover:bg-tertiary/10 cursor-pointer border-b border-outline-variant/30 last:border-0 transition-colors flex items-center justify-between no-underline block">
                            <div class="font-body-md text-on-surface font-bold hover:text-tertiary flex items-center gap-xs">
                                <span class="material-symbols-outlined text-sm text-tertiary">person_pin</span>
                                <span>${highlightArabic(ec.endClientName, val)}</span>
                            </div>
                            <div class="flex items-center gap-xs text-[11px] text-secondary">
                                ${primaryContractor ? `<span>عن طريق: ${primaryContractor.name}</span>` : ''}
                                <span class="material-symbols-outlined text-xs text-outline">open_in_new</span>
                            </div>
                        </a>
                    `;
                }).join('');
            }

            newClientNameDropdown.innerHTML = html;
            newClientNameDropdown.classList.remove('hidden');
        } catch (err) {
            console.error('Error in new client suggestions search:', err);
        }
    }, 150);
}

newClientNameInput.addEventListener('input', (e) => {
    validateClientNameDuplicate();
    updateNewClientSuggestions(e.target.value);
});
newClientNameInput.addEventListener('focus', (e) => {
    updateNewClientSuggestions(e.target.value);
});
newClientNameInput.addEventListener('blur', validateClientNameDuplicate);

document.addEventListener('click', (e) => {
    if (newClientNameDropdown && !newClientNameInput.contains(e.target) && !newClientNameDropdown.contains(e.target)) {
        newClientNameDropdown.classList.add('hidden');
    }
});

function openAddClientModal() {
    const modal = document.getElementById('addClientModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    
    // Reset form and clear error states
    document.getElementById('addClientForm').reset();
    newClientNameError.classList.add('hidden');
    newClientNameInput.classList.remove('border-error');
    newClientPhoneError.classList.add('hidden');
    newClientPhoneInput.classList.remove('border-error');
    if (newClientNameDropdown) newClientNameDropdown.classList.add('hidden');
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    setTimeout(() => newClientNameInput.focus(), 50);
}

function closeAddClientModal() {
    const modal = document.getElementById('addClientModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    document.getElementById('addClientForm').reset();
    newClientNameError.classList.add('hidden');
    newClientNameInput.classList.remove('border-error');
    newClientPhoneError.classList.add('hidden');
    if (newClientNameDropdown) newClientNameDropdown.classList.add('hidden');
    newClientPhoneInput.classList.remove('border-error');
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
}

const editClientNameInput = document.getElementById('editClientName');
const editClientNameError = document.getElementById('editClientNameError');
const editClientPhoneInput = document.getElementById('editClientPhone');
const editClientPhoneError = document.getElementById('editClientPhoneError');
const editClientAddressInput = document.getElementById('editClientAddress');
const editClientPageNumberInput = document.getElementById('editClientPageNumber');
const editClientIdInput = document.getElementById('editClientId');

function openEditClientModal(clientId, clientName, clientPhone, clientAddress, clientPageNumber) {
    const modal = document.getElementById('editClientModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    const client = allClients.find(c => String(c.id || c._id) === String(clientId));
    const nameVal = clientName !== undefined ? clientName : (client?.name || '');
    const phoneVal = clientPhone !== undefined ? clientPhone : (client?.phone || '');
    const addressVal = clientAddress !== undefined ? clientAddress : (client?.address || '');
    const pageVal = clientPageNumber !== undefined ? clientPageNumber : (client?.pageNumber ?? 0);

    editClientIdInput.value = clientId;
    editClientNameInput.value = nameVal;
    editClientPhoneInput.value = (phoneVal === '-' ? '' : phoneVal);
    if (editClientAddressInput) editClientAddressInput.value = (addressVal === '-' ? '' : addressVal);
    editClientPageNumberInput.value = pageVal;
    editClientNameError.classList.add('hidden');
    editClientNameInput.classList.remove('border-error');
    editClientPhoneError.classList.add('hidden');
    editClientPhoneInput.classList.remove('border-error');
    setTimeout(() => editClientNameInput.focus(), 50);
}

function closeEditClientModal() {
    const modal = document.getElementById('editClientModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    document.getElementById('editClientForm').reset();
    editClientNameError.classList.add('hidden');
    editClientNameInput.classList.remove('border-error');
    editClientPhoneError.classList.add('hidden');
    editClientPhoneInput.classList.remove('border-error');
}

async function submitEditClientForm(e) {
    e.preventDefault();

    const clientId = editClientIdInput.value;
    const name = editClientNameInput.value.trim();
    const phone = editClientPhoneInput.value.trim();
    const address = (editClientAddressInput ? editClientAddressInput.value : '').trim();
    const pageNumber = editClientPageNumberInput.value.trim();

    if (!name) {
        showToast('الرجاء إدخال اسم العميل', 'warning');
        editClientNameInput.focus();
        return;
    }

    const duplicate = allClients.some(client => {
        if (String(client.id || client._id) === String(clientId)) return false;
        return normalizeArabic((client.name || '').trim()) === normalizeArabic(name);
    });

    if (duplicate) {
        editClientNameError.textContent = 'العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة';
        editClientNameError.classList.remove('hidden');
        editClientNameInput.classList.add('border-error');
        showToast('العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة', 'error');
        editClientNameInput.focus();
        return;
    }

    if (phone && !/^\d+$/.test(phone.replace(/\s+/g, '').replace(/\+/g, ''))) {
        editClientPhoneError.classList.remove('hidden');
        editClientPhoneInput.classList.add('border-error');
        showToast('يجب إدخال أرقام فقط في رقم الهاتف', 'error');
        editClientPhoneInput.focus();
        return;
    }

    try {
        const res = await fetch(`/api/clients/${clientId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name,
                phone: phone || '-',
                address: address || '',
                pageNumber: pageNumber === '' ? 0 : Number(pageNumber)
            })
        });

        if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || 'فشل في تحديث العميل');
        }

        const updatedClient = await res.json();

        // Update allClients in memory without full page reload
        const idx = allClients.findIndex(c => String(c.id || c._id) === String(clientId));
        if (idx !== -1) {
            allClients[idx] = {
                ...allClients[idx],
                ...updatedClient,
                name: updatedClient.name,
                phone: updatedClient.phone,
                address: updatedClient.address,
                pageNumber: updatedClient.pageNumber
            };
        }

        showToast('تم تحديث بيانات العميل بنجاح', 'success');
        closeEditClientModal();
        renderClients(sortClientsList(allClients));
        updateStats(allClients);
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تحديث العميل', 'error');
    }
}

const editClientForm = document.getElementById('editClientForm');
if (editClientForm) {
    editClientForm.addEventListener('submit', submitEditClientForm);
}

document.getElementById('addClientForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = newClientNameInput.value.trim();
    const phone = newClientPhoneInput.value.trim();
    const address = (document.getElementById('newClientAddress') ? document.getElementById('newClientAddress').value : '').trim();
    
    if (validateFormFields('addClientForm')) {
        showToast('الرجاء إكمال جميع الحقول الإجبارية', 'warning');
        return;
    }
    
    if (validateClientNameDuplicate()) {
        showToast('العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة', 'error');
        newClientNameInput.focus();
        return;
    }
    
    try {
        submitBtn.disabled = true;
        const pageNumber = document.getElementById('newClientPageNumber').value.trim();
        const res = await fetch('/api/clients', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name,
                phone: phone || '-',
                address: address || '',
                pageNumber: pageNumber === '' ? 0 : Number(pageNumber)
            })
        });
        
        if (res.ok) {
            showToast(`تمت إضافة العميل "${name}" بنجاح`, 'success');
            closeAddClientModal();
            await loadClients();
        } else {
            const err = await res.json();
            showToast(err.error || 'فشل في إضافة العميل', 'error');
            if (err.error && err.error.includes('مسجل')) {
                newClientNameError.textContent = err.error;
                newClientNameError.classList.remove('hidden');
                newClientNameInput.classList.add('border-error');
            }
        }
    } catch (err) {
        showToast('فشل في إضافة العميل', 'error');
    } finally {
        submitBtn.disabled = false;
    }
});

// Close modal on outside click
document.getElementById('addClientModal').addEventListener('click', function(e) {
    if (e.target === this) closeAddClientModal();
});

document.getElementById('editClientModal').addEventListener('click', function(e) {
    if (e.target === this) closeEditClientModal();
});

function toggleClientsExportDropdown(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('clientsExportDropdownMenu');
    const arrow = document.getElementById('clientsExportDropdownArrow');
    if (!menu) return;
    const isHidden = menu.classList.contains('hidden');
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        if (arrow) arrow.classList.add('rotate-180');
    } else {
        closeClientsExportDropdown();
    }
}

function closeClientsExportDropdown() {
    const menu = document.getElementById('clientsExportDropdownMenu');
    const arrow = document.getElementById('clientsExportDropdownArrow');
    if (menu && !menu.classList.contains('hidden')) {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        if (arrow) arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

document.addEventListener('click', (e) => {
    const container = document.getElementById('clientsExportDropdownContainer');
    if (container && !container.contains(e.target)) {
        closeClientsExportDropdown();
    }
});

// Initialize
document.addEventListener('DOMContentLoaded', loadClients);

</script>
