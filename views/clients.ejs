<script src="/js/shared-ui.js"></script>
<script>
let allClients = [];
let currentSortField = 'createdAt'; // 'createdAt' or 'name'
let currentSortOrder = 'desc'; // 'asc' or 'desc'

function escapeJsString(value = '') {
    return String(value)
        .replace(/\\/g, '\\\\')
        .replace(/'/g, "\\'")
        .replace(/\n/g, '\\n');
}

function sortClientsList(clients) {
    const list = [...clients];
    list.sort((a, b) => {
        if (currentSortField === 'name') {
            const nameA = (a.name || '').trim();
            const nameB = (b.name || '').trim();
            const cmp = nameA.localeCompare(nameB, 'ar', { sensitivity: 'base' });
            return currentSortOrder === 'asc' ? cmp : -cmp;
        } else {
            const timeA = new Date(a.createdAt || 0).getTime() || (Number(a.id) || 0);
            const timeB = new Date(b.createdAt || 0).getTime() || (Number(b.id) || 0);
            return currentSortOrder === 'asc' ? timeA - timeB : timeB - timeA;
        }
    });
    return list;
}

// Load clients from API
async function loadClients() {
    const user = await checkAuth();
    if (!user) return;
    
    // Update user display names
    document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
    document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');

    // Setup Validation
    setupPhoneValidation('newClientPhone', 'newClientPhoneError');

    try {
        const res = await fetch('/api/clients?limit=1000');
        const responseData = await res.json();
        allClients = responseData.data || [];
        renderClients(sortClientsList(allClients));
        updateStats(allClients);
    } catch (err) {
        console.error('Failed to load clients:', err);
        showToast('فشل في تحميل بيانات العملاء', 'error');
    }
}

function updateStats(clients) {
    document.getElementById('statTotal').textContent = clients.length;
    const totalDebt = clients.reduce((sum, c) => sum + (c.balance > 0 ? c.balance : 0), 0);
    document.getElementById('statDebt').textContent = formatCurrency(totalDebt);
    const clearClients = clients.filter(c => c.balance <= 0).length;
    document.getElementById('statClear').textContent = clearClients;
}

let currentClientsList = [];
let clientsCurrentPage = 1;
let clientsPageSize = 10;

// Custom Page Size Dropdown Functions
function toggleClientsPageSizeDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('clientsPageSizeMenu');
    const arrow = document.getElementById('clientsPageSizeArrow');
    const isHidden = menu.classList.contains('hidden');
    
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        arrow.classList.add('rotate-180');
    } else {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

function selectClientsPageSize(val) {
    clientsPageSize = Number(val);
    document.getElementById('clientsPageSizeLabel').textContent = val;
    
    // Update checkmarks
    [10, 25, 50, 100].forEach(size => {
        const check = document.getElementById(`size-check-${size}`);
        if (check) check.classList.toggle('hidden', size !== clientsPageSize);
    });
    
    // Close menu
    const menu = document.getElementById('clientsPageSizeMenu');
    const arrow = document.getElementById('clientsPageSizeArrow');
    menu.classList.add('opacity-0', 'scale-95');
    menu.classList.remove('opacity-100', 'scale-100');
    arrow.classList.remove('rotate-180');
    setTimeout(() => menu.classList.add('hidden'), 150);
    
    clientsCurrentPage = 1;
    renderClients(currentClientsList);
}

document.getElementById('clientsPageSizeBtn').addEventListener('click', toggleClientsPageSizeDropdown);

document.addEventListener('click', (e) => {
    const container = document.getElementById('clientsPageSizeContainer');
    if (container && !container.contains(e.target)) {
        const menu = document.getElementById('clientsPageSizeMenu');
        const arrow = document.getElementById('clientsPageSizeArrow');
        if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('opacity-0', 'scale-95');
            menu.classList.remove('opacity-100', 'scale-100');
            arrow.classList.remove('rotate-180');
            setTimeout(() => menu.classList.add('hidden'), 150);
        }
    }
});

function renderClients(clients, resetPage = false) {
    currentClientsList = clients;
    if (resetPage) clientsCurrentPage = 1;

    const tbody = document.getElementById('clientsTableBody');
    const query = document.getElementById('searchInput').value;
    const totalRecords = clients.length;

    if (totalRecords === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-xl text-center text-secondary">لا يوجد عملاء مسجلين</td></tr>';
        renderPaginationControls({
            containerId: 'clientsPaginationControls',
            infoId: 'clientsPaginationInfo',
            currentPage: 1,
            pageSize: clientsPageSize,
            totalRecords: 0,
            unitLabel: 'عميل',
            onPageChange: () => {}
        });
        return;
    }

    const totalPages = Math.ceil(totalRecords / clientsPageSize) || 1;
    if (clientsCurrentPage > totalPages) clientsCurrentPage = totalPages;
    if (clientsCurrentPage < 1) clientsCurrentPage = 1;

    const startIndex = (clientsCurrentPage - 1) * clientsPageSize;
    const endIndex = Math.min(startIndex + clientsPageSize, totalRecords);
    const pagedClients = clients.slice(startIndex, endIndex);

    tbody.innerHTML = pagedClients.map((client, index) => {
        const initial = client.name.charAt(0);
        const balanceColor = client.balance > 0 ? 'text-tertiary' : 'text-primary-container';
        const hasMatchedEndClients = client.matchedEndClientsCount && client.matchedEndClientsCount > 0;
        return `
            <tr onclick="window.location.href='/client-details?id=${client.id}'" class="cursor-pointer hover:bg-primary/10 transition-all duration-200 group" style="opacity:0;transform:translateY(10px);animation:fadeInRow 0.4s ease ${index * 0.05}s forwards;">
                <td class="px-lg py-md">
                    <div class="flex items-center gap-md">
                        <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container font-bold group-hover:scale-105 transition-transform">${initial}</div>
                        <div class="flex flex-col">
                            <span class="font-body-md text-body-md text-on-surface font-bold group-hover:text-primary transition-colors">${highlightArabic(client.name, query)}</span>
                            ${hasMatchedEndClients ? `
                                <span class="text-xs text-secondary mt-0.5">
                                    طلب من خلاله: <strong class="text-on-surface-variant font-semibold">${client.matchedEndClients.slice(0, 3).map(n => highlightArabic(n, query)).join('، ')}</strong>${client.matchedEndClientsCount > 3 ? ` (+${client.matchedEndClientsCount - 3} آخرين)` : ''}
                                </span>
                            ` : ''}
                        </div>
                    </div>
                </td>
                <td class="px-lg py-md">
                    <span class="font-body-md text-body-md ${client.pageNumber ? 'text-on-surface font-bold' : 'text-secondary'}">${client.pageNumber ? client.pageNumber : '-'}</span>
                </td>
                <td class="px-lg py-md">
                    <span class="font-headline-sm text-headline-sm ${balanceColor}">${formatCurrency(client.balance)}</span>
                </td>
                <td class="px-lg py-md font-body-md text-body-md text-secondary" dir="ltr">${highlightArabic(client.phone, query)}</td>
                <td class="px-lg py-md">
                    <div class="flex flex-col">
                        <span class="font-body-md text-body-md text-on-surface">${formatDate(client.lastTransaction)}</span>
                        <span class="font-label-sm text-label-sm text-outline">${client.lastTransactionNote || client.notes || ''}</span>
                    </div>
                </td>
                <td class="px-lg py-md">
                    <div class="flex items-center justify-center gap-sm">
                        <a href="/client-details?id=${client.id}" onclick="event.stopPropagation();" class="p-sm rounded-lg hover:bg-surface-container-highest text-primary transition-all active:scale-90" title="عرض">
                            <span class="material-symbols-outlined">visibility</span>
                        </a>
                        <button onclick="event.stopPropagation(); openEditClientModal('${client.id}', '${escapeJsString(client.name)}', '${escapeJsString(client.phone || '')}', '${escapeJsString(client.address || '')}', '${client.pageNumber ?? 0}')" class="p-sm rounded-lg hover:bg-primary/10 text-primary transition-all active:scale-90" title="تعديل">
                            <span class="material-symbols-outlined">edit</span>
                        </button>
                        <button onclick="event.stopPropagation(); deleteClient('${client.id}', '${escapeJsString(client.name)}')" class="p-sm rounded-lg hover:bg-error-container/20 text-error transition-all active:scale-90" title="حذف">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }).join('');

    renderPaginationControls({
        containerId: 'clientsPaginationControls',
        infoId: 'clientsPaginationInfo',
        currentPage: clientsCurrentPage,
        pageSize: clientsPageSize,
        totalRecords: totalRecords,
        unitLabel: 'عميل',
        onPageChange: (newPage) => {
            clientsCurrentPage = newPage;
            renderClients(currentClientsList);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
}

// Custom Sort Dropdown Functions
function toggleSortDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('sortDropdownMenu');
    const arrow = document.getElementById('sortDropdownArrow');
    const isHidden = menu.classList.contains('hidden');
    
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        arrow.classList.add('rotate-180');
    } else {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

function selectSortOption(field, label) {
    currentSortField = field;
    document.getElementById('sortSelectedLabel').textContent = label;
    
    // Update checkmarks
    document.getElementById('check-createdAt').classList.toggle('hidden', field !== 'createdAt');
    document.getElementById('check-name').classList.toggle('hidden', field !== 'name');
    
    // Close menu
    const menu = document.getElementById('sortDropdownMenu');
    const arrow = document.getElementById('sortDropdownArrow');
    menu.classList.add('opacity-0', 'scale-95');
    menu.classList.remove('opacity-100', 'scale-100');
    arrow.classList.remove('rotate-180');
    setTimeout(() => menu.classList.add('hidden'), 150);
    
    const query = (document.getElementById('searchInput').value || '').trim();
    if (query.length === 0) {
        renderClients(sortClientsList(allClients));
    }
}

document.getElementById('sortDropdownBtn').addEventListener('click', toggleSortDropdown);

document.addEventListener('click', (e) => {
    const container = document.getElementById('sortDropdownContainer');
    if (container && !container.contains(e.target)) {
        const menu = document.getElementById('sortDropdownMenu');
        const arrow = document.getElementById('sortDropdownArrow');
        if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('opacity-0', 'scale-95');
            menu.classList.remove('opacity-100', 'scale-100');
            arrow.classList.remove('rotate-180');
            setTimeout(() => menu.classList.add('hidden'), 150);
        }
    }
});

document.getElementById('sortOrderToggle').addEventListener('click', () => {
    currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
    document.getElementById('sortOrderIcon').textContent = currentSortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward';
    const query = (document.getElementById('searchInput').value || '').trim();
    if (query.length === 0) {
        renderClients(sortClientsList(allClients));
    }
});

// Unified Search with 300ms Debounce
let searchDebounceTimer = null;

document.getElementById('searchInput').addEventListener('input', (e) => {
    const rawVal = (e.target.value || '').trim();
    const endClientsSection = document.getElementById('endClientResultsSection');
    const endClientsGrid = document.getElementById('endClientResultsGrid');

    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);

    if (rawVal.length === 0) {
        endClientsSection.classList.add('hidden');
        renderClients(sortClientsList(allClients), true);
        updateStats(allClients);
        return;
    }

    searchDebounceTimer = setTimeout(async () => {
        try {
            const res = await fetch(`/api/search?q=${encodeURIComponent(rawVal)}`);
            if (!res.ok) throw new Error('Search failed');
            const data = await res.json();
            
            const contractors = data.contractors || [];
            const endClientMatches = data.endClientMatches || [];

            // Render contractors table
            renderClients(contractors, true);

            // Render End Clients results section
            if (endClientMatches.length > 0) {
                endClientsGrid.innerHTML = endClientMatches.map(item => `
                    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md shadow-sm flex flex-col gap-sm">
                        <div class="flex items-center gap-sm border-b border-outline-variant/40 pb-xs">
                            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold">
                                <span class="material-symbols-outlined text-lg">person_pin</span>
                            </div>
                            <h4 class="font-headline-sm text-headline-sm font-bold text-on-surface">${highlightArabic(item.endClientName, rawVal)}</h4>
                        </div>
                        <div class="text-xs text-secondary space-y-1">
                            <span class="font-medium text-on-surface-variant block mb-1">عن طريق:</span>
                            <div class="flex flex-wrap gap-xs">
                                ${item.contractors.map(c => `
                                    <a href="/client-details?id=${c.id}" class="inline-flex items-center gap-1 bg-surface-container-low hover:bg-primary/10 text-primary px-sm py-1 rounded-lg border border-outline-variant/60 transition-colors">
                                        <span class="font-bold">${c.name}</span>
                                        <span class="text-secondary text-[11px]">(${c.invoiceCount} فاتورة)</span>
                                    </a>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                `).join('');
                endClientsSection.classList.remove('hidden');
            } else {
                endClientsSection.classList.add('hidden');
            }

            // Empty state check
            if (contractors.length === 0 && endClientMatches.length === 0) {
                const tbody = document.getElementById('clientsTableBody');
                tbody.innerHTML = '<tr><td colspan="6" class="p-xl text-center text-secondary">لا توجد نتائج مطابقة للبحث</td></tr>';
            }
        } catch (err) {
            console.error('Search error:', err);
        }
    }, 300);
});

// Delete client
async function deleteClient(id, name) {
    const confirmed = await showConfirm(`هل أنت متأكد من حذف العميل "${name}"؟ سيتم حذف جميع فواتيره أيضاً.`);
    if (!confirmed) return;
    try {
        const res = await fetch(`/api/clients/${id}`, { method: 'DELETE' });
        if (res.ok) {
            showToast(`تم حذف العميل "${name}" بنجاح`, 'success');
            loadClients();
        } else {
            showToast('فشل في حذف العميل', 'error');
        }
    } catch (err) {
        showToast('فشل في حذف العميل', 'error');
    }
}

// Add Client Modal & Validation
const newClientNameInput = document.getElementById('newClientName');
const newClientNameError = document.getElementById('newClientNameError');
const newClientPhoneInput = document.getElementById('newClientPhone');
const newClientPhoneError = document.getElementById('newClientPhoneError');
const submitBtn = document.querySelector('#addClientForm button[type="submit"]');

function validateClientNameDuplicate() {
    const rawVal = (newClientNameInput.value || '').trim();
    const val = normalizeArabic(rawVal);
    
    if (!val) {
        newClientNameError.classList.add('hidden');
        newClientNameInput.classList.remove('border-error');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        return false;
    }
    
    const exists = allClients.some(c => normalizeArabic(c.name || '') === val);
    
    if (exists) {
        newClientNameError.textContent = 'العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة';
        newClientNameError.classList.remove('hidden');
        newClientNameInput.classList.add('border-error');
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        return true;
    } else {
        newClientNameError.classList.add('hidden');
        newClientNameInput.classList.remove('border-error');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        return false;
    }
}

newClientNameInput.addEventListener('input', validateClientNameDuplicate);
newClientNameInput.addEventListener('blur', validateClientNameDuplicate);

function openAddClientModal() {
    const modal = document.getElementById('addClientModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    
    // Reset form and clear error states
    document.getElementById('addClientForm').reset();
    newClientNameError.classList.add('hidden');
    newClientNameInput.classList.remove('border-error');
    newClientPhoneError.classList.add('hidden');
    newClientPhoneInput.classList.remove('border-error');
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    setTimeout(() => newClientNameInput.focus(), 50);
}

function closeAddClientModal() {
    const modal = document.getElementById('addClientModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    document.getElementById('addClientForm').reset();
    newClientNameError.classList.add('hidden');
    newClientNameInput.classList.remove('border-error');
    newClientPhoneError.classList.add('hidden');
    newClientPhoneInput.classList.remove('border-error');
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
}

const editClientNameInput = document.getElementById('editClientName');
const editClientNameError = document.getElementById('editClientNameError');
const editClientPhoneInput = document.getElementById('editClientPhone');
const editClientPhoneError = document.getElementById('editClientPhoneError');
const editClientAddressInput = document.getElementById('editClientAddress');
const editClientPageNumberInput = document.getElementById('editClientPageNumber');
const editClientIdInput = document.getElementById('editClientId');

function openEditClientModal(clientId, clientName, clientPhone, clientAddress, clientPageNumber) {
    const modal = document.getElementById('editClientModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    const client = allClients.find(c => String(c.id || c._id) === String(clientId));
    const nameVal = clientName !== undefined ? clientName : (client?.name || '');
    const phoneVal = clientPhone !== undefined ? clientPhone : (client?.phone || '');
    const addressVal = clientAddress !== undefined ? clientAddress : (client?.address || '');
    const pageVal = clientPageNumber !== undefined ? clientPageNumber : (client?.pageNumber ?? 0);

    editClientIdInput.value = clientId;
    editClientNameInput.value = nameVal;
    editClientPhoneInput.value = (phoneVal === '-' ? '' : phoneVal);
    if (editClientAddressInput) editClientAddressInput.value = (addressVal === '-' ? '' : addressVal);
    editClientPageNumberInput.value = pageVal;
    editClientNameError.classList.add('hidden');
    editClientNameInput.classList.remove('border-error');
    editClientPhoneError.classList.add('hidden');
    editClientPhoneInput.classList.remove('border-error');
    setTimeout(() => editClientNameInput.focus(), 50);
}

function closeEditClientModal() {
    const modal = document.getElementById('editClientModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    document.getElementById('editClientForm').reset();
    editClientNameError.classList.add('hidden');
    editClientNameInput.classList.remove('border-error');
    editClientPhoneError.classList.add('hidden');
    editClientPhoneInput.classList.remove('border-error');
}

async function submitEditClientForm(e) {
    e.preventDefault();

    const clientId = editClientIdInput.value;
    const name = editClientNameInput.value.trim();
    const phone = editClientPhoneInput.value.trim();
    const address = (editClientAddressInput ? editClientAddressInput.value : '').trim();
    const pageNumber = editClientPageNumberInput.value.trim();

    if (!name) {
        showToast('الرجاء إدخال اسم العميل', 'warning');
        editClientNameInput.focus();
        return;
    }

    const duplicate = allClients.some(client => {
        if (String(client.id || client._id) === String(clientId)) return false;
        return normalizeArabic((client.name || '').trim()) === normalizeArabic(name);
    });

    if (duplicate) {
        editClientNameError.textContent = 'العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة';
        editClientNameError.classList.remove('hidden');
        editClientNameInput.classList.add('border-error');
        showToast('العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة', 'error');
        editClientNameInput.focus();
        return;
    }

    if (phone && !/^\d+$/.test(phone.replace(/\s+/g, '').replace(/\+/g, ''))) {
        editClientPhoneError.classList.remove('hidden');
        editClientPhoneInput.classList.add('border-error');
        showToast('يجب إدخال أرقام فقط في رقم الهاتف', 'error');
        editClientPhoneInput.focus();
        return;
    }

    try {
        const res = await fetch(`/api/clients/${clientId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name,
                phone: phone || '-',
                address: address || '',
                pageNumber: pageNumber === '' ? 0 : Number(pageNumber)
            })
        });

        if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || 'فشل في تحديث العميل');
        }

        const updatedClient = await res.json();

        // Update allClients in memory without full page reload
        const idx = allClients.findIndex(c => String(c.id || c._id) === String(clientId));
        if (idx !== -1) {
            allClients[idx] = {
                ...allClients[idx],
                ...updatedClient,
                name: updatedClient.name,
                phone: updatedClient.phone,
                address: updatedClient.address,
                pageNumber: updatedClient.pageNumber
            };
        }

        showToast('تم تحديث بيانات العميل بنجاح', 'success');
        closeEditClientModal();
        renderClients(sortClientsList(allClients));
        updateStats(allClients);
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تحديث العميل', 'error');
    }
}

const editClientForm = document.getElementById('editClientForm');
if (editClientForm) {
    editClientForm.addEventListener('submit', submitEditClientForm);
}

document.getElementById('addClientForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = newClientNameInput.value.trim();
    const phone = newClientPhoneInput.value.trim();
    const address = (document.getElementById('newClientAddress') ? document.getElementById('newClientAddress').value : '').trim();
    
    if (validateFormFields('addClientForm')) {
        showToast('الرجاء إكمال جميع الحقول الإجبارية', 'warning');
        return;
    }
    
    if (validateClientNameDuplicate()) {
        showToast('العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة', 'error');
        newClientNameInput.focus();
        return;
    }
    
    try {
        submitBtn.disabled = true;
        const pageNumber = document.getElementById('newClientPageNumber').value.trim();
        const res = await fetch('/api/clients', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name,
                phone: phone || '-',
                address: address || '',
                pageNumber: pageNumber === '' ? 0 : Number(pageNumber)
            })
        });
        
        if (res.ok) {
            showToast(`تمت إضافة العميل "${name}" بنجاح`, 'success');
            closeAddClientModal();
            await loadClients();
        } else {
            const err = await res.json();
            showToast(err.error || 'فشل في إضافة العميل', 'error');
            if (err.error && err.error.includes('مسجل')) {
                newClientNameError.textContent = err.error;
                newClientNameError.classList.remove('hidden');
                newClientNameInput.classList.add('border-error');
            }
        }
    } catch (err) {
        showToast('فشل في إضافة العميل', 'error');
    } finally {
        submitBtn.disabled = false;
    }
});

// Close modal on outside click
document.getElementById('addClientModal').addEventListener('click', function(e) {
    if (e.target === this) closeAddClientModal();
});

document.getElementById('editClientModal').addEventListener('click', function(e) {
    if (e.target === this) closeEditClientModal();
});

// Add row animation keyframes
const style = document.createElement('style');
style.textContent = `@keyframes fadeInRow { to { opacity: 1; transform: translateY(0); } }`;
document.head.appendChild(style);

// Initialize
document.addEventListener('DOMContentLoaded', loadClients);
</script>
