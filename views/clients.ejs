<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>سجل الديون - العملاء</title>
<meta name="description" content="إدارة ومتابعة ديون العملاء المسجلين"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="js/tailwind-config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link href="css/styles.css" rel="stylesheet"/>
</head>
<body class="bg-background text-on-surface overflow-hidden max-w-[100vw]">
<!-- Shell Container -->
<div class="flex h-screen w-full">
<%- include('partials/aside', { active: 'clients' }) %>
<!-- Main Content Area -->
<main class="flex-1 min-w-0 flex flex-col md:mr-64 h-full relative">

<!-- Page Canvas -->
<div class="flex-1 overflow-y-auto p-container-margin pb-24 md:pb-xl md:p-xl custom-scrollbar">
<%- include('partials/header', { title: 'العملاء' }) %>
<!-- Content Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-md mb-xl">
<div class="flex flex-col">
<h2 class="font-headline-md text-headline-md text-on-surface">العملاء</h2>
<p class="font-body-md text-body-md text-secondary">إدارة ومتابعة ديون العملاء المسجلين</p>
</div>
<div class="flex flex-wrap items-center gap-xs sm:gap-sm">
    <!-- Standalone Export Dropdown -->
    <div class="relative" id="clientsExportDropdownContainer">
        <button id="clientsExportDropdownBtn" onclick="toggleClientsExportDropdown(event)" type="button" class="px-md py-sm border border-outline-variant bg-surface hover:bg-surface-container-high text-on-surface rounded-full font-bold text-sm transition-all flex items-center justify-center gap-xs shadow-xs cursor-pointer" title="تصدير بيانات العملاء">
            <span class="material-symbols-outlined text-primary text-xl">download</span>
            <span>تصدير</span>
            <span class="material-symbols-outlined text-outline text-base transition-transform duration-200" id="clientsExportDropdownArrow">expand_more</span>
        </button>
        <div id="clientsExportDropdownMenu" class="hidden absolute top-[calc(100%+8px)] right-0 w-44 bg-surface border border-outline-variant/80 rounded-xl shadow-xl z-50 py-1.5 overflow-hidden transition-all duration-150 transform opacity-0 scale-95 origin-top">
            <a href="/api/export/clients/excel" onclick="closeClientsExportDropdown()" class="w-full px-sm py-2 flex items-center gap-2 text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                <span class="material-symbols-outlined text-green-600 text-base">description</span>
                <span>Excel</span>
            </a>
            <a href="/api/export/clients/pdf" onclick="closeClientsExportDropdown()" class="w-full px-sm py-2 flex items-center gap-2 text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                <span class="material-symbols-outlined text-error text-base">picture_as_pdf</span>
                <span>PDF</span>
            </a>
            <a href="/api/export/clients/image" onclick="closeClientsExportDropdown()" class="w-full px-sm py-2 flex items-center gap-2 text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                <span class="material-symbols-outlined text-blue-600 text-base">image</span>
                <span>صورة (Image)</span>
            </a>
        </div>
    </div>

    <!-- Standalone Action Button -->
    <button onclick="openAddClientModal()" class="px-md py-sm bg-primary hover:bg-primary-container text-white rounded-full flex items-center justify-center gap-xs font-bold text-sm shadow-sm transition-all active:scale-95 cursor-pointer">
        <span class="material-symbols-outlined text-xl">person_add</span>
        <span>عميل جديد</span>
    </button>
</div>


</div>
<!-- Stats Row (Interactive Filter Cards) -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-md mb-xl">
    <!-- Card 1: Credit Clients (عملاء لهم فلوس) -->
    <div id="cardFilterCredit" onclick="toggleBalanceFilter('credit')" class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-green-600/60 transition-all select-none group">
        <div class="flex flex-col gap-xs">
            <div class="flex items-center gap-xs">
                <span class="font-label-md text-label-md text-secondary font-bold">عملاء لهم فلوس</span>
                <span class="text-[10px] bg-green-100 text-green-800 font-bold px-2 py-0.5 rounded-full">(رصيدهم ≤ 0)</span>
            </div>
            <div class="flex items-baseline gap-sm">
                <span class="font-headline-md text-headline-md text-green-700 font-bold" id="statCreditTotal">0.00 ج.م</span>
                <span class="text-xs text-secondary font-bold" id="statCreditCount">(0 عميل)</span>
            </div>
        </div>
        <div id="iconCreditCard" class="w-12 h-12 rounded-xl bg-green-100 text-green-700 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
            <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
        </div>
    </div>

    <!-- Card 2: Debt Clients (ديون مستحقة) -->
    <div id="cardFilterDebt" onclick="toggleBalanceFilter('debt')" class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm cursor-pointer hover:border-tertiary/60 transition-all select-none group">
        <div class="flex flex-col gap-xs">
            <div class="flex items-center gap-xs">
                <span class="font-label-md text-label-md text-secondary font-bold">ديون مستحقة</span>
                <span class="text-[10px] bg-tertiary/10 text-tertiary font-bold px-2 py-0.5 rounded-full">(رصيدهم > 0)</span>
            </div>
            <div class="flex items-baseline gap-sm">
                <span class="font-headline-md text-headline-md text-tertiary font-bold" id="statDebtTotal">0.00 ج.م</span>
                <span class="text-xs text-secondary font-bold" id="statDebtCount">(0 عميل)</span>
            </div>
        </div>
        <div id="iconDebtCard" class="w-12 h-12 rounded-xl bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center group-hover:scale-105 transition-transform shrink-0">
            <span class="material-symbols-outlined text-2xl">payments</span>
        </div>
    </div>
</div>
<!-- Search & Sort Controls -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md mb-md shadow-sm flex flex-col md:flex-row gap-sm items-center justify-between">
    <div class="relative w-full flex-1">
        <span class="material-symbols-outlined absolute right-md top-1/2 -translate-y-1/2 text-outline">search</span>
        <input class="w-full h-12 pr-12 pl-md rounded-xl bg-background border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none font-body-md text-body-md transition-all" placeholder="البحث باسم العميل أو رقم الهاتف..." type="text" id="searchInput"/>
    </div>
    <div class="flex items-center gap-xs w-full md:w-auto">
        <!-- Custom Sort Dropdown -->
        <div class="relative flex-1 md:flex-initial" id="sortDropdownContainer">
            <button id="sortDropdownBtn" type="button" class="w-full md:w-auto h-12 px-md bg-background border border-outline-variant hover:border-primary/60 focus:border-primary rounded-xl flex items-center justify-between gap-sm text-on-surface font-body-md text-sm transition-all shadow-sm active:scale-98">
                <div class="flex items-center gap-xs">
                    <span class="material-symbols-outlined text-primary text-lg">sort</span>
                    <span class="text-xs text-secondary whitespace-nowrap">الترتيب:</span>
                    <span id="sortSelectedLabel" class="font-bold text-on-surface text-xs whitespace-nowrap">تاريخ الإضافة</span>
                </div>
                <span class="material-symbols-outlined text-outline text-lg transition-transform duration-200" id="sortDropdownArrow">expand_more</span>
            </button>
            
            <!-- Custom Dropdown Menu -->
            <div id="sortDropdownMenu" class="hidden absolute top-[calc(100%+6px)] right-0 left-0 md:left-auto md:w-48 bg-surface border border-outline-variant/80 rounded-xl shadow-xl z-50 py-1.5 overflow-hidden transition-all duration-150 transform opacity-0 scale-95 origin-top">
                <button type="button" onclick="selectSortOption('createdAt', 'تاريخ الإضافة')" class="sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="createdAt">
                    <span class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base text-secondary">calendar_today</span>
                        تاريخ الإضافة
                    </span>
                    <span class="material-symbols-outlined text-primary text-base font-bold sort-check" id="check-createdAt">check</span>
                </button>
                <button type="button" onclick="selectSortOption('name', 'الاسم')" class="sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="name">
                    <span class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base text-secondary">badge</span>
                        الاسم
                    </span>
                    <span class="material-symbols-outlined text-primary text-base font-bold sort-check hidden" id="check-name">check</span>
                </button>
                <button type="button" onclick="selectSortOption('phone', 'رقم الهاتف')" class="sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="phone">
                    <span class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base text-secondary">call</span>
                        رقم الهاتف
                    </span>
                    <span class="material-symbols-outlined text-primary text-base font-bold sort-check hidden" id="check-phone">check</span>
                </button>
                <button type="button" onclick="selectSortOption('pageNumber', 'رقم الصفحة')" class="sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="pageNumber">
                    <span class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base text-secondary">book</span>
                        رقم الصفحة
                    </span>
                    <span class="material-symbols-outlined text-primary text-base font-bold sort-check hidden" id="check-pageNumber">check</span>
                </button>
                <button type="button" onclick="selectSortOption('balance', 'الرصيد')" class="sort-option w-full px-md py-2.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="balance">
                    <span class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-base text-secondary">payments</span>
                        الرصيد
                    </span>
                    <span class="material-symbols-outlined text-primary text-base font-bold sort-check hidden" id="check-balance">check</span>
                </button>
            </div>
        </div>

        <!-- Sort Direction Toggle Button -->
        <button id="sortOrderToggle" class="h-12 w-12 flex-shrink-0 flex items-center justify-center bg-background border border-outline-variant hover:border-primary/60 rounded-xl hover:bg-primary/5 text-primary transition-all active:scale-95 shadow-sm" title="تبديل الترتيب تصاعدي / تنازلي" type="button">
            <span class="material-symbols-outlined text-xl transition-transform duration-200" id="sortOrderIcon">arrow_downward</span>
        </button>
    </div>
</div>
<!-- Table Container -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
<div class="overflow-x-auto w-full max-w-[100vw]">
<table class="w-full text-right whitespace-nowrap">
<thead>
<tr class="bg-surface-container-low border-b border-outline-variant select-none">
<th onclick="toggleHeaderSort('name')" class="px-lg py-md font-label-md text-label-md text-secondary cursor-pointer hover:bg-surface-container-high transition-colors">
    <div class="flex items-center justify-between gap-xs">
        <span>اسم العميل</span>
        <span class="material-symbols-outlined text-sm font-bold text-outline opacity-60" id="sortHeaderIcon_name">unfold_more</span>
    </div>
</th>
<th onclick="toggleHeaderSort('phone')" class="px-lg py-md font-label-md text-label-md text-secondary cursor-pointer hover:bg-surface-container-high transition-colors">
    <div class="flex items-center justify-between gap-xs">
        <span>رقم الهاتف</span>
        <span class="material-symbols-outlined text-sm font-bold text-outline opacity-60" id="sortHeaderIcon_phone">unfold_more</span>
    </div>
</th>
<th class="px-lg py-md font-label-md text-label-md text-secondary">العملاء تحته</th>
<th onclick="toggleHeaderSort('pageNumber')" class="px-lg py-md font-label-md text-label-md text-secondary cursor-pointer hover:bg-surface-container-high transition-colors">
    <div class="flex items-center justify-between gap-xs">
        <span>رقم الصفحة</span>
        <span class="material-symbols-outlined text-sm font-bold text-outline opacity-60" id="sortHeaderIcon_pageNumber">unfold_more</span>
    </div>
</th>
<th onclick="toggleHeaderSort('balance')" class="px-lg py-md font-label-md text-label-md text-secondary cursor-pointer hover:bg-surface-container-high transition-colors">
    <div class="flex items-center justify-between gap-xs">
        <span>الرصيد الحالي</span>
        <span class="material-symbols-outlined text-sm font-bold text-outline opacity-60" id="sortHeaderIcon_balance">unfold_more</span>
    </div>
</th>
<th onclick="toggleHeaderSort('createdAt')" class="px-lg py-md font-label-md text-label-md text-secondary cursor-pointer hover:bg-surface-container-high transition-colors">
    <div class="flex items-center justify-between gap-xs">
        <span>تاريخ الإضافة</span>
        <span class="material-symbols-outlined text-sm font-bold text-primary" id="sortHeaderIcon_createdAt">arrow_downward</span>
    </div>
</th>
<th class="px-lg py-md font-label-md text-label-md text-secondary text-center">الإجراءات</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant" id="clientsTableBody">
<tr><td colspan="7" class="p-xl text-center text-secondary">جاري التحميل...</td></tr>

</tbody>
</table>
</div>
<!-- Pagination Footer -->
<div class="px-md py-sm border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-sm text-xs text-secondary" id="clientsPaginationContainer">
    <div class="flex items-center gap-md w-full sm:w-auto justify-between sm:justify-start">
        <div class="flex items-center gap-xs">
            <span>عرض:</span>
            <!-- Custom Page Size Dropdown -->
            <div class="relative" id="clientsPageSizeContainer">
                <button id="clientsPageSizeBtn" type="button" class="h-8 px-2.5 bg-surface-container-low border border-outline-variant hover:border-primary/60 focus:border-primary rounded-lg flex items-center justify-between gap-1 text-on-surface text-xs font-bold transition-all shadow-xs active:scale-98">
                    <span id="clientsPageSizeLabel">10</span>
                    <span class="material-symbols-outlined text-outline text-base transition-transform duration-200" id="clientsPageSizeArrow">expand_less</span>
                </button>
                
                <!-- Dropdown Menu (opens upward) -->
                <div id="clientsPageSizeMenu" class="hidden absolute bottom-[calc(100%+4px)] right-0 w-28 bg-surface border border-outline-variant/80 rounded-xl shadow-xl z-50 py-1 overflow-hidden transition-all duration-150 transform opacity-0 scale-95 origin-bottom">
                    <button type="button" onclick="selectClientsPageSize(10)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>10 سجلات</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold size-check" id="size-check-10">check</span>
                    </button>
                    <button type="button" onclick="selectClientsPageSize(25)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>25 سجل</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold size-check hidden" id="size-check-25">check</span>
                    </button>
                    <button type="button" onclick="selectClientsPageSize(50)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>50 سجل</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold size-check hidden" id="size-check-50">check</span>
                    </button>
                    <button type="button" onclick="selectClientsPageSize(100)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>100 سجل</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold size-check hidden" id="size-check-100">check</span>
                    </button>
                </div>
            </div>
            <span>عميل لكل صفحة</span>
        </div>
        <div class="text-secondary font-medium" id="clientsPaginationInfo">
            عرض 0 - 0 من أصل 0 عميل
        </div>
    </div>
    <div id="clientsPaginationControls">
        <!-- Rendered dynamically -->
    </div>
</div>
</div>

<!-- End Client Search Results Section -->
<div id="endClientResultsSection" class="hidden mt-lg space-y-md">
    <div class="flex items-center gap-sm border-b border-outline-variant pb-xs">
        <span class="material-symbols-outlined text-primary text-xl">person_search</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">نتائج عن عملاء نهائيين</h3>
    </div>
    <div id="endClientResultsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md">
        <!-- Rendered dynamically on search -->
    </div>
</div>

</div>
<%- include('partials/bottom-nav', { active: 'clients' }) %>
</main>
</div>

<!-- Add Client Modal -->
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="addClientModal">
<div class="bg-white rounded-xl shadow-lg w-full max-w-md p-md md:p-xl">
<div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
<h2 class="font-headline-md text-headline-md font-bold text-on-surface">إضافة عميل جديد</h2>
<button class="text-secondary hover:text-on-surface" onclick="closeAddClientModal()" type="button">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<form id="addClientForm" class="space-y-lg" novalidate>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">اسم العميل</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">person</span>
<input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all text-right" id="newClientName" placeholder="مثال: أحمد محمد" type="text" required autocomplete="off"/>
<div id="newClientNameDropdown" class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-outline-variant rounded-xl shadow-xl z-[999] max-h-[200px] overflow-y-auto custom-scrollbar"></div>
</div>
<p id="newClientNameError" class="hidden text-error text-[11px] mt-1 pr-1 font-bold">العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة</p>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">رقم الصفحة</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">book</span>
<input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all text-right" id="newClientPageNumber" placeholder="مثل: 42" type="number" min="0" step="1"/>
</div>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">رقم الهاتف</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">call</span>
<input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all text-right" id="newClientPhone" placeholder="01XXXXXXXXX" type="tel"/>
</div>
<p id="newClientPhoneError" class="hidden text-error text-[11px] mt-1 pr-1 font-bold">يجب إدخال أرقام فقط في رقم الهاتف</p>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">العنوان (اختياري)</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
<input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all text-right" id="newClientAddress" placeholder="الحي، الشارع..." type="text"/>
</div>
</div>
<div class="flex flex-col md:flex-row items-center gap-md pt-md border-t border-outline-variant">
<button class="w-full md:w-auto bg-primary text-on-primary h-12 px-xl rounded-full font-label-md text-label-md hover:opacity-90 active:scale-95 transition-all" type="submit">حفظ العميل</button>
<button class="w-full md:w-auto border border-outline-variant text-on-surface h-12 px-xl rounded-full font-label-md text-label-md hover:bg-surface-container-low transition-all" type="button" onclick="closeAddClientModal()">إلغاء</button>
</div>
</form>
</div>
</div>

<!-- Edit Client Modal -->
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="editClientModal">
<div class="bg-white rounded-xl shadow-lg w-full max-w-md p-md md:p-xl">
<div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
<h2 class="font-headline-md text-headline-md font-bold text-on-surface">تعديل بيانات العميل</h2>
<button class="text-secondary hover:text-on-surface" onclick="closeEditClientModal()" type="button">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<form id="editClientForm" class="space-y-lg" novalidate>
<input id="editClientId" type="hidden" />
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">اسم العميل</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">person</span>
<input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all text-right" id="editClientName" placeholder="مثال: أحمد محمد" type="text" required autocomplete="off"/>
</div>
<p id="editClientNameError" class="hidden text-error text-[11px] mt-1 pr-1 font-bold">العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة</p>
</div>
