<button class="w-full md:w-auto border border-outline-variant text-on-surface h-12 px-xl rounded-full font-label-md text-label-md hover:bg-surface-container-low transition-all" type="button" onclick="closeEditClientModal()">إلغاء</button>
</div>
</form>
