<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>سجل الديون - العملاء</title>
<meta name="description" content="إدارة ومتابعة ديون العملاء المسجلين"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="js/tailwind-config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link href="css/styles.css" rel="stylesheet"/>
</head>
<body class="bg-background text-on-surface overflow-hidden max-w-[100vw]">
<!-- Shell Container -->
<div class="flex h-screen w-full">
<%- include('partials/aside', { active: 'clients' }) %>
<!-- Main Content Area -->
<main class="flex-1 min-w-0 flex flex-col md:mr-64 h-full relative">

<!-- Page Canvas -->
<div class="flex-1 overflow-y-auto p-container-margin pb-24 md:pb-xl md:p-xl custom-scrollbar">
<%- include('partials/header', { title: 'العملاء' }) %>
<!-- Content Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-md mb-xl">
<div class="flex flex-col">
<h2 class="font-headline-md text-headline-md text-on-surface">العملاء</h2>
<p class="font-body-md text-body-md text-secondary">إدارة ومتابعة ديون العملاء المسجلين</p>
</div>
<div class="flex gap-sm">
    <a href="/api/export/clients/excel" class="bg-surface-container-low text-on-surface px-md py-sm md:px-lg md:py-md rounded-full flex items-center justify-center gap-sm font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm shadow-sm hover:shadow transition-all active:scale-95 border border-outline-variant">
        <span class="material-symbols-outlined text-xl md:text-2xl">download</span>
        تصدير
    </a>
    <button onclick="openAddClientModal()" class="bg-primary text-on-primary px-md py-sm md:px-lg md:py-md rounded-full flex items-center justify-center gap-sm font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm shadow-md hover:shadow-lg transition-all active:scale-95">
        <span class="material-symbols-outlined text-xl md:text-2xl">person_add</span>
        + عميل جديد
    </button>
</div>
</div>
<!-- Stats Row -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-md mb-xl">
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm">
<div class="flex flex-col">
<span class="font-label-md text-label-md text-secondary">إجمالي العملاء</span>
<span class="font-headline-md text-headline-md text-primary" id="statTotal">--</span>
</div>
<div class="w-12 h-12 rounded-lg bg-primary-fixed flex items-center justify-center text-on-primary-fixed">
<span class="material-symbols-outlined">group</span>
</div>
</div>
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm">
<div class="flex flex-col">
<span class="font-label-md text-label-md text-secondary">ديون مستحقة</span>
<span class="font-headline-md text-headline-md text-tertiary" id="statDebt">--</span>
</div>
<div class="w-12 h-12 rounded-lg bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed">
<span class="material-symbols-outlined">payments</span>
</div>
</div>
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center justify-between shadow-sm">
<div class="flex flex-col">
<span class="font-label-md text-label-md text-secondary">عملاء بدون ديون</span>
<span class="font-headline-md text-headline-md text-primary-container" id="statClear">--</span>
</div>
<div class="w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center text-on-primary-container">
<span class="material-symbols-outlined">trending_up</span>
</div>
</div>
</div>
<!-- Search -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md mb-md shadow-sm">
<div class="relative w-full">
<span class="material-symbols-outlined absolute right-md top-1/2 -translate-y-1/2 text-outline">search</span>
<input class="w-full h-12 pr-12 pl-md rounded-xl bg-background border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none font-body-md text-body-md transition-all" placeholder="البحث باسم العميل أو رقم الهاتف..." type="text" id="searchInput"/>
</div>
</div>
<!-- Table Container -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
<div class="overflow-x-auto w-full max-w-[100vw]">
<table class="w-full text-right whitespace-nowrap">
<thead>
<tr class="bg-surface-container-low border-b border-outline-variant">
<th class="px-lg py-md font-label-md text-label-md text-secondary">اسم العميل</th>
<th class="px-lg py-md font-label-md text-label-md text-secondary">الرصيد الحالي</th>
<th class="px-lg py-md font-label-md text-label-md text-secondary">رقم الهاتف</th>
<th class="px-lg py-md font-label-md text-label-md text-secondary">آخر معاملة</th>
<th class="px-lg py-md font-label-md text-label-md text-secondary text-center">الإجراءات</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant" id="clientsTableBody">
<tr><td colspan="5" class="p-xl text-center text-secondary">جاري التحميل...</td></tr>
</tbody>
</table>
</div>
</div>
</div>
<%- include('partials/bottom-nav', { active: 'clients' }) %>
</main>
</div>

<!-- Add Client Modal -->
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="addClientModal">
<div class="bg-white rounded-xl shadow-lg w-full max-w-md p-md md:p-xl">
<div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
<h2 class="font-headline-md text-headline-md font-bold text-on-surface">إضافة عميل جديد</h2>
<button class="text-secondary hover:text-on-surface" onclick="closeAddClientModal()" type="button">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<form id="addClientForm" class="space-y-lg" novalidate>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">اسم العميل</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">person</span>
<input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all text-right" id="newClientName" placeholder="مثال: أحمد محمد" type="text" required autocomplete="off"/>
</div>
<p id="newClientNameError" class="hidden text-error text-[11px] mt-1 pr-1 font-bold">العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة</p>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">رقم الهاتف</label>
<div class="relative">
<span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">call</span>
<input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all text-right" id="newClientPhone" placeholder="01XXXXXXXXX" type="tel" required/>
</div>
<p id="newClientPhoneError" class="hidden text-error text-[11px] mt-1 pr-1 font-bold">يجب إدخال أرقام فقط في رقم الهاتف</p>
</div>
<div class="flex flex-col md:flex-row items-center gap-md pt-md border-t border-outline-variant">
<button class="w-full md:w-auto bg-primary text-on-primary h-12 px-xl rounded-full font-label-md text-label-md hover:opacity-90 active:scale-95 transition-all" type="submit">حفظ العميل</button>
<button class="w-full md:w-auto border border-outline-variant text-on-surface h-12 px-xl rounded-full font-label-md text-label-md hover:bg-surface-container-low transition-all" type="button" onclick="closeAddClientModal()">إلغاء</button>
</div>
</form>
</div>
</div>

<script src="/js/shared-ui.js"></script>
<script>
let allClients = [];

// Load clients from API
async function loadClients() {
    const user = await checkAuth();
    if (!user) return;
    
    // Update user display names
    document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
    document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');

    // Setup Validation
    setupPhoneValidation('newClientPhone', 'newClientPhoneError');

    try {
        const res = await fetch('/api/clients?limit=1000');
        const responseData = await res.json();
        allClients = responseData.data || [];
        renderClients(allClients);
        updateStats(allClients);
    } catch (err) {
        console.error('Failed to load clients:', err);
        showToast('فشل في تحميل بيانات العملاء', 'error');
    }
}

function updateStats(clients) {
    document.getElementById('statTotal').textContent = clients.length;
    const totalDebt = clients.reduce((sum, c) => sum + (c.balance > 0 ? c.balance : 0), 0);
    document.getElementById('statDebt').textContent = formatCurrency(totalDebt);
    const clearClients = clients.filter(c => c.balance <= 0).length;
    document.getElementById('statClear').textContent = clearClients;
}

function renderClients(clients) {
    const tbody = document.getElementById('clientsTableBody');
    const query = document.getElementById('searchInput').value;
    if (clients.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-xl text-center text-secondary">لا يوجد عملاء مسجلين</td></tr>';
        return;
    }
    tbody.innerHTML = clients.map((client, index) => {
        const initial = client.name.charAt(0);
        const balanceColor = client.balance > 0 ? 'text-tertiary' : 'text-primary-container';
        return `
            <tr class="hover:bg-primary-container/5 transition-colors group" style="opacity:0;transform:translateY(10px);animation:fadeInRow 0.4s ease ${index * 0.05}s forwards;">
                <td class="px-lg py-md">
                    <div class="flex items-center gap-md">
                        <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container font-bold">${initial}</div>
                        <span class="font-body-md text-body-md text-on-surface">${highlightArabic(client.name, query)}</span>
                    </div>
                </td>
                <td class="px-lg py-md">
                    <span class="font-headline-sm text-headline-sm ${balanceColor}">${formatCurrency(client.balance)}</span>
                </td>
                <td class="px-lg py-md font-body-md text-body-md text-secondary" dir="ltr">${highlightArabic(client.phone, query)}</td>
                <td class="px-lg py-md">
                    <div class="flex flex-col">
                        <span class="font-body-md text-body-md text-on-surface">${formatDate(client.lastTransaction)}</span>
                        <span class="font-label-sm text-label-sm text-outline">${client.lastTransactionNote || ''}</span>
                    </div>
                </td>
                <td class="px-lg py-md">
                    <div class="flex items-center justify-center gap-sm">
                        <a href="/client-details?id=${client.id}" class="p-sm rounded-lg hover:bg-surface-container-highest text-primary transition-all active:scale-90" title="عرض">
                            <span class="material-symbols-outlined">visibility</span>
                        </a>
                        <button onclick="deleteClient('${client.id}', '${client.name}')" class="p-sm rounded-lg hover:bg-error-container/20 text-error transition-all active:scale-90" title="حذف">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

// Multi-term OR Search with Relevance Ranking
document.getElementById('searchInput').addEventListener('input', (e) => {
    const rawVal = e.target.value || '';
    const terms = [...new Set(rawVal.trim().split(/\s+/).filter(Boolean))];

    if (terms.length === 0) {
        renderClients(allClients);
        return;
    }

    const scoredClients = [];

    for (const client of allClients) {
        const normName = normalizeArabic(client.name || '');
        const phone = client.phone || '';
        let score = 0;

        for (const term of terms) {
            const normTerm = normalizeArabic(term);
            const nameMatches = normTerm && normName.includes(normTerm);
            const phoneMatches = phone && phone.includes(term);

            if (nameMatches || phoneMatches) {
                score++;
            }
        }

        if (score > 0) {
            scoredClients.push({ client, score });
        }
    }

    // Sort by relevance score (descending), preserving original sort within the same tier (stable sort)
    scoredClients.sort((a, b) => b.score - a.score);

    const filtered = scoredClients.map(item => item.client);
    renderClients(filtered);
});

// Delete client
async function deleteClient(id, name) {
    const confirmed = await showConfirm(`هل أنت متأكد من حذف العميل "${name}"؟ سيتم حذف جميع فواتيره أيضاً.`);
    if (!confirmed) return;
    try {
        const res = await fetch(`/api/clients/${id}`, { method: 'DELETE' });
        if (res.ok) {
            showToast(`تم حذف العميل "${name}" بنجاح`, 'success');
            loadClients();
        } else {
            showToast('فشل في حذف العميل', 'error');
        }
    } catch (err) {
        showToast('فشل في حذف العميل', 'error');
    }
}

// Add Client Modal & Validation
const newClientNameInput = document.getElementById('newClientName');
const newClientNameError = document.getElementById('newClientNameError');
const newClientPhoneInput = document.getElementById('newClientPhone');
const newClientPhoneError = document.getElementById('newClientPhoneError');
const submitBtn = document.querySelector('#addClientForm button[type="submit"]');

function validateClientNameDuplicate() {
    const rawVal = (newClientNameInput.value || '').trim();
    const val = normalizeArabic(rawVal);
    
    if (!val) {
        newClientNameError.classList.add('hidden');
        newClientNameInput.classList.remove('border-error');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        return false;
    }
    
    const exists = allClients.some(c => normalizeArabic(c.name || '') === val);
    
    if (exists) {
        newClientNameError.textContent = 'العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة';
        newClientNameError.classList.remove('hidden');
        newClientNameInput.classList.add('border-error');
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        return true;
    } else {
        newClientNameError.classList.add('hidden');
        newClientNameInput.classList.remove('border-error');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        return false;
    }
}

newClientNameInput.addEventListener('input', validateClientNameDuplicate);
newClientNameInput.addEventListener('blur', validateClientNameDuplicate);

function openAddClientModal() {
    const modal = document.getElementById('addClientModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    
    // Reset form and clear error states
    document.getElementById('addClientForm').reset();
    newClientNameError.classList.add('hidden');
    newClientNameInput.classList.remove('border-error');
    newClientPhoneError.classList.add('hidden');
    newClientPhoneInput.classList.remove('border-error');
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    setTimeout(() => newClientNameInput.focus(), 50);
}

function closeAddClientModal() {
    const modal = document.getElementById('addClientModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    document.getElementById('addClientForm').reset();
    newClientNameError.classList.add('hidden');
    newClientNameInput.classList.remove('border-error');
    newClientPhoneError.classList.add('hidden');
    newClientPhoneInput.classList.remove('border-error');
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
}

document.getElementById('addClientForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = newClientNameInput.value.trim();
    const phone = newClientPhoneInput.value.trim();
    
    if (validateFormFields('addClientForm')) {
        showToast('الرجاء إكمال جميع الحقول الإجبارية', 'warning');
        return;
    }
    
    if (validateClientNameDuplicate()) {
        showToast('العميل مسجل مسبقاً، الرجاء تغيير الاسم للمتابعة', 'error');
        newClientNameInput.focus();
        return;
    }
    
    try {
        submitBtn.disabled = true;
        const res = await fetch('/api/clients', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, phone })
        });
        
        if (res.ok) {
            showToast(`تمت إضافة العميل "${name}" بنجاح`, 'success');
            closeAddClientModal();
            await loadClients();
        } else {
            const err = await res.json();
            showToast(err.error || 'فشل في إضافة العميل', 'error');
            if (err.error && err.error.includes('مسجل')) {
                newClientNameError.textContent = err.error;
                newClientNameError.classList.remove('hidden');
                newClientNameInput.classList.add('border-error');
            }
        }
    } catch (err) {
        showToast('فشل في إضافة العميل', 'error');
    } finally {
        submitBtn.disabled = false;
    }
});

// Close modal on outside click
document.getElementById('addClientModal').addEventListener('click', function(e) {
    if (e.target === this) closeAddClientModal();
});

// Add row animation keyframes
const style = document.createElement('style');
style.textContent = `@keyframes fadeInRow { to { opacity: 1; transform: translateY(0); } }`;
document.head.appendChild(style);

// Initialize
document.addEventListener('DOMContentLoaded', loadClients);
</script>
</body></html>