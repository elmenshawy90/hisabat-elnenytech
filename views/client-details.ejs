// Load client data from API
async function loadClientDetails() {
    const user = await checkAuth();
    if (!user) return;
    
    // Update user display names
    document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
    document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');

    const clientId = getClientId();
    if (!clientId) {
        showToast('لم يتم تحديد العميل', 'error');
        setTimeout(() => window.location.href = '/clients', 1500);
        return;
    }

    // Set export links immediately
    const excelBtn = document.getElementById('exportExcelBtn');
    const pdfBtn = document.getElementById('exportPdfBtn');
    if (excelBtn) excelBtn.href = `/api/export/client/${clientId}/excel`;
    if (pdfBtn) pdfBtn.href = `/api/export/client/${clientId}/pdf`;

    try {
        const res = await fetch(`/api/clients/${clientId}`);
        if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            showToast(errData.error || 'العميل غير موجود', 'error');
            setTimeout(() => window.location.href = '/clients', 1500);
            return;
        }

        const client = await res.json();

        // Hide loading, show content
        document.getElementById('loadingState').classList.add('hidden');
        document.getElementById('clientContent').classList.remove('hidden');

        // Populate profile
        const initials = client.name.split(' ').slice(0, 2).map(w => w[0]).join(' ');
        document.getElementById('clientInitials').textContent = initials;
        document.getElementById('clientName').textContent = client.name;
        document.getElementById('breadcrumbName').textContent = client.name;
        document.getElementById('clientPhone').textContent = client.phone;
        document.getElementById('clientBalance').textContent = formatCurrency(client.balance);
        document.title = `${client.name} - سجل الديون`;

        // Set Export links
        const excelBtn = document.getElementById('exportExcelBtn');
        const pdfBtn = document.getElementById('exportPdfBtn');
        if (excelBtn) excelBtn.href = `/api/export/client/${clientId}/excel`;
        if (pdfBtn) pdfBtn.href = `/api/export/client/${clientId}/pdf`;

        // Status badge
        const statusEl = document.getElementById('clientStatus');
        if (client.balance <= 0) {
            statusEl.textContent = 'مسدد';
            statusEl.className = 'bg-green-100 text-green-700 px-md py-xs rounded-full font-label-sm text-label-sm';
        } else if (client.balance > 10000) {
            statusEl.textContent = 'رصيد مرتفع';
            statusEl.className = 'bg-error-container text-on-error-container px-md py-xs rounded-full font-label-sm text-label-sm';
        } else {
            statusEl.textContent = 'نشط';
            statusEl.className = 'bg-orange-100 text-orange-700 px-md py-xs rounded-full font-label-sm text-label-sm';
        }

        // Last transaction
        document.getElementById('clientLastTx').textContent = formatDate(client.lastTransaction);

        // Invoices
        clientInvoices = client.invoices || [];
        const invoices = clientInvoices;
        document.getElementById('clientTotalTx').textContent = invoices.length + ' معاملة';
        document.getElementById('statTxCount').textContent = invoices.length;

        const totalPurchases = invoices.filter(i => i.type === 'purchase').reduce((s, i) => s + i.amount, 0);
        const totalPayments = invoices.filter(i => i.type === 'payment').reduce((s, i) => s + i.amount, 0);
        document.getElementById('statPurchases').textContent = formatCurrency(totalPurchases);
        document.getElementById('statPayments').textContent = formatCurrency(totalPayments);

        // Render transaction rows
        renderTransactions(invoices);

        // Render breakdown by End Client
        renderEndClientBreakdown(invoices);

    } catch (err) {
        console.error('Failed to load client:', err);
        showToast('فشل في تحميل بيانات العميل', 'error');
    }
}

function renderEndClientBreakdown(invoices) {
    const container = document.getElementById('endClientsBreakdownContainer');
    const grid = document.getElementById('endClientsCardsGrid');
    const badge = document.getElementById('endClientsCountBadge');

    const normalizedInvoices = invoices.map(inv => {
        const rawName = (inv.endClientName || '').trim();
        return {
            ...inv,
            effectiveEndClientName: rawName && rawName !== '-' ? rawName : 'شخصي'
        };
    });

    const taggedInvoices = normalizedInvoices.filter(i => i.effectiveEndClientName);

    if (taggedInvoices.length === 0) {
        container.classList.add('hidden');
        return;
    }

    const groupsMap = new Map();

    for (const inv of taggedInvoices) {
        const name = inv.effectiveEndClientName;
        const key = inv.endClientId ? `id_${inv.endClientId}` : `name_${normalizeArabic(name)}`;
        if (!groupsMap.has(key)) {
            groupsMap.set(key, {
                id: inv.endClientId || null,
                name,
                invoiceCount: 0,
                totalPurchases: 0,
                totalPayments: 0,
                net: 0
            });
        }
        const g = groupsMap.get(key);
        g.invoiceCount++;
        if (inv.type === 'purchase') {
            g.totalPurchases += inv.amount;
        } else if (inv.type === 'payment') {
            g.totalPayments += inv.amount;
        }
        g.net = g.totalPurchases - g.totalPayments;
    }

    const groups = Array.from(groupsMap.values());
    groups.sort((a, b) => b.net - a.net);

    badge.textContent = `${groups.length} ${groups.length === 1 ? 'عميل' : 'عملاء'}`;

    grid.innerHTML = groups.map(item => {
        const netColor = item.net <= 0 ? 'text-green-600' : 'text-tertiary';
        return `
            <div class="bg-white rounded-xl border border-outline-variant p-md shadow-sm flex flex-col justify-between gap-sm">
                <div class="flex items-center justify-between border-b border-outline-variant/50 pb-xs">
                    <div class="flex items-center gap-xs font-bold text-on-surface font-body-md">
                        <span class="material-symbols-outlined text-primary text-lg">person_pin</span>
                        <span class="truncate max-w-[150px]" title="${item.name}">${item.name}</span>
                    </div>
                    <span class="bg-surface-container text-secondary text-xs px-2 py-0.5 rounded-full font-bold">${item.invoiceCount} معاملة</span>
                </div>
                <div class="space-y-xs text-xs">
                    <div class="flex justify-between text-secondary">
                        <span>إجمالي المشتريات:</span>
                        <span class="font-bold text-on-surface">${formatCurrency(item.totalPurchases)}</span>
                    </div>
                    <div class="flex justify-between text-secondary">
                        <span>إجمالي المدفوعات:</span>
                        <span class="font-bold text-primary">${formatCurrency(item.totalPayments)}</span>
                    </div>
                </div>
                <div class="flex justify-between items-center border-t border-outline-variant/50 pt-xs">
                    <span class="text-xs font-bold text-secondary">الاجمالي:</span>
                    <span class="font-bold text-sm ${netColor}">${formatCurrency(item.net)}</span>
                </div>
            </div>
        `;
    }).join('');

    container.classList.remove('hidden');
}

