let cachedActiveItems = [];
let isFetchingItems = false;

async function fetchActiveItemsCatalog() {
    if (cachedActiveItems.length === 0) {
        isFetchingItems = true;
        populateItemDropdowns();
    }
    try {
        const res = await fetch('/api/items');
        const data = await res.json();
        if (res.ok) {
            const itemsList = Array.isArray(data) ? data : (Array.isArray(data.data) ? data.data : []);
            cachedActiveItems = itemsList.filter(item => item.isActive !== false);
        } else {
            console.error('فشل في جلب الأصناف:', data.error);
        }
    } catch (err) {
        console.error('فشل في جلب كتالوج الأصناف:', err);
    } finally {
        isFetchingItems = false;
        populateItemDropdowns();
    }
}

function populateItemDropdowns() {
    const itemSelects = document.querySelectorAll('.line-item-select');
    itemSelects.forEach(select => {
        const currentVal = select.value;
        if (isFetchingItems && cachedActiveItems.length === 0) {
            select.innerHTML = '<option value="">⏳ جاري تحميل الأصناف...</option>';
            select.disabled = true;
        } else if (!isFetchingItems && cachedActiveItems.length === 0) {
            select.innerHTML = '<option value="">⚠️ لا توجد أصناف متاحة في الكتالوج</option>';
            select.disabled = true;
        } else {
            const options = ['<option value="">-- اختر الصنف --</option>'];
            cachedActiveItems.forEach(item => {
                const idStr = String(item.id || item._id);
                const isSelected = idStr === String(currentVal) ? 'selected' : '';
                options.push(`<option value="${idStr}" ${isSelected}>${item.name}</option>`);
            });
            select.innerHTML = options.join('');
            select.disabled = false;
        }
    });
}

