<script>
// Add spinner animation
const style = document.createElement('style');
style.textContent = `@keyframes spin { to { transform: rotate(360deg); } } @keyframes fadeInRow { to { opacity: 1; transform: translateY(0); } }`;
document.head.appendChild(style);

let allClientsList = []; // For invoice form dropdown
let allEndClientsList = []; // For end client autocomplete
let clientInvoices = [];
let currentClientData = null;

async function loadEndClients() {
    try {
        const res = await fetch('/api/end-clients');
        const data = await res.json();
        allEndClientsList = data.data || [];
    } catch (err) {
        console.error('Failed to load end clients:', err);
    }
}

function goBack() {
    if (window.history.length > 1) {
        window.history.back();
    } else {
        window.location.href = '/clients';
    }
}

// Get client ID from URL
function getClientId() {
    const params = new URLSearchParams(window.location.search);
    return params.get('id');
}

async function exportClientPdf(e) {
    if (e) e.preventDefault();
    const id = getClientId();
    if (!id) {
        showToast('لم يتم تحديد العميل', 'error');
        return;
    }

    try {
        showToast('جاري تحميل كشف الحساب بصيغة PDF...', 'info');
        const res = await fetch(`/api/export/client/${id}/pdf`);
        if (!res.ok) {
            const text = await res.text();
            throw new Error(text || 'فشل في تصدير PDF');
        }

        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `client-statement-${Date.now()}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
    } catch (err) {
        console.error('PDF export failed:', err);
        showToast(err.message || 'فشل في تصدير PDF', 'error');
    }
}

function exportClientExcel(e) {
    if (e) e.preventDefault();
    const id = getClientId();
    if (!id) {
        showToast('لم يتم تحديد العميل', 'error');
        return;
    }
    showToast('جاري تحميل كشف الحساب بصيغة Excel...', 'info');
    window.location.href = `/api/export/client/${id}/excel`;
    const menu = document.getElementById('exportDropdownMenu');
    if (menu) menu.classList.add('hidden');
}

function toggleExportDropdown(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('exportDropdownMenu');
    const arrow = document.getElementById('exportDropdownArrow');
    if (!menu) return;
    const isHidden = menu.classList.contains('hidden');
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        if (arrow) arrow.classList.add('rotate-180');
    } else {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        if (arrow) arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

document.addEventListener('click', (e) => {
    const container = document.getElementById('exportDropdownContainer');
    if (container && !container.contains(e.target)) {
        const menu = document.getElementById('exportDropdownMenu');
        const arrow = document.getElementById('exportDropdownArrow');
        if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('opacity-0', 'scale-95');
            menu.classList.remove('opacity-100', 'scale-100');
            if (arrow) arrow.classList.remove('rotate-180');
            setTimeout(() => menu.classList.add('hidden'), 150);
        }
    }
});

async function exportClientImage(e) {
    if (e) e.preventDefault();
    const id = getClientId();
    if (!id) {
        showToast('لم يتم تحديد العميل', 'error');
        return;
    }

    try {
        showToast('جاري استخراج كشف الحساب بصيغة صورة (PNG)...', 'info');
        const res = await fetch(`/api/export/client/${id}/image`);
        if (!res.ok) {
            const text = await res.text();
            throw new Error(text || 'فشل في تصدير الصورة');
        }

        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        const clientNameStr = currentClientData?.name || id;
        a.download = `client-statement-${clientNameStr}.png`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
    } catch (err) {
        console.error('Image export failed:', err);
        showToast(err.message || 'فشل في تصدير الصورة', 'error');
    } finally {
        const menu = document.getElementById('exportDropdownMenu');
        if (menu) menu.classList.add('hidden');
