<!-- Name Match Merge Choice Modal -->
<div class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/50 p-4" id="convertNameMatchModal">
    <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-lg p-lg space-y-md border border-outline-variant/60">
        <div class="flex items-center justify-between border-b border-outline-variant/60 pb-sm">
            <div class="flex items-center gap-sm text-amber-600">
                <div class="w-10 h-10 rounded-full bg-amber-500/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">group</span>
                </div>
                <h3 class="font-headline-sm font-bold text-on-surface">عميل مستقل موجود بنفس الاسم</h3>
            </div>
            <button type="button" onclick="closeConvertNameMatchModal()" class="text-secondary hover:text-on-surface">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        
        <p class="font-body-md text-on-surface font-bold text-base">
            لقينا عميل مستقل موجود بنفس الاسم: <span id="matchedClientNameDisplay" class="text-primary underline font-bold"></span>
        </p>
        
        <!-- Step 1: Initial Choice Container -->
