function renderTransactions(invoices, resetPage = false) {
    currentTxList = invoices;
    if (resetPage) txCurrentPage = 1;

    const tbody = document.getElementById('transactionsBody');
    const totalRecords = invoices.length;

    if (totalRecords === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-xl text-center text-secondary">لا توجد معاملات لهذا العميل</td></tr>';
        renderPaginationControls({
            containerId: 'txPaginationControls',
            infoId: 'txPaginationInfo',
            currentPage: 1,
            pageSize: txPageSize,
            totalRecords: 0,
            unitLabel: 'معاملة',
            onPageChange: () => {}
        });
        return;
    }

    // 1. Calculate true chronological running balance (from oldest to newest)
    const chronological = [...invoices].sort((a, b) => {
        const dateA = new Date(a.date || 0).getTime();
        const dateB = new Date(b.date || 0).getTime();
        if (dateA !== dateB) return dateA - dateB;
        const createdA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
        const createdB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
        if (createdA !== createdB) return createdA - createdB;
        return (Number(a._id || a.id) || 0) - (Number(b._id || b.id) || 0);
    });

    let running = 0;
    const balanceMap = new Map();
    for (const inv of chronological) {
        if (inv.type === 'purchase') {
            running += (Number(inv.amount) || 0);
        } else if (inv.type === 'payment') {
            running -= (Number(inv.amount) || 0);
        }
        const key = String(inv._id || inv.id);
        balanceMap.set(key, running);
        inv.runningBalance = running;
    }

    // 2. Apply user selected sorting
    invoices.sort((a, b) => {
        let diff = 0;
        if (currentTxSortField === 'createdAt') {
            const timeA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
            const timeB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
            diff = timeA - timeB;
        } else {
            const dateA = new Date(a.date || 0).getTime();
            const dateB = new Date(b.date || 0).getTime();
            diff = dateA - dateB;
        }

        if (diff === 0) {
            const timeA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
            const timeB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
            diff = timeA - timeB;
        }

        return currentTxSortOrder === 'asc' ? diff : -diff;
    });

    const totalPages = Math.ceil(totalRecords / txPageSize) || 1;
    if (txCurrentPage > totalPages) txCurrentPage = totalPages;
    if (txCurrentPage < 1) txCurrentPage = 1;

    const startIndex = (txCurrentPage - 1) * txPageSize;
    const endIndex = Math.min(startIndex + txPageSize, totalRecords);
    const pagedInvoices = invoices.slice(startIndex, endIndex);

    tbody.innerHTML = pagedInvoices.map(inv => {
        const isPurchase = inv.type === 'purchase';
        const typeBadge = isPurchase
            ? '<span class="px-sm py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm">شراء</span>'
            : '<span class="px-sm py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm">دفع</span>';
        const amountClass = isPurchase ? 'font-bold' : 'text-primary font-bold';
        const amountPrefix = isPurchase ? '+' : '-';

        const runBal = inv.runningBalance !== undefined ? inv.runningBalance : (balanceMap.get(String(inv._id || inv.id)) || 0);
        let balanceBadge = '';
        if (runBal <= 0) {
            balanceBadge = `<span class="text-green-600 font-bold dir-ltr inline-block">${formatCurrency(runBal)}</span>`;
        } else {
            balanceBadge = `<span class="text-primary font-bold dir-ltr inline-block">${formatCurrency(runBal)}</span>`;
        }

        return `
            <tr class="cursor-pointer hover:bg-primary/5 transition-colors group" onclick="openTransactionDetails(${inv._id})">
                <td class="px-md py-md font-body-md text-body-md">${formatDate(inv.date)}</td>
                <td class="px-md py-md">${typeBadge}</td>
                <td class="px-md py-md font-body-md text-body-md">${inv.details || '-'}</td>
                <td class="px-md py-md font-body-md text-body-md text-secondary">${inv.endClientName || '-'}</td>
                <td class="px-md py-md font-body-md text-body-md ${amountClass}">${amountPrefix}${formatCurrency(inv.amount)}</td>
                <td class="px-md py-md font-body-md text-body-md">${balanceBadge}</td>
            </tr>
        `;
    }).join('');

    renderPaginationControls({
        containerId: 'txPaginationControls',
        infoId: 'txPaginationInfo',
        currentPage: txCurrentPage,
        pageSize: txPageSize,
        totalRecords: totalRecords,
        unitLabel: 'معاملة',
        onPageChange: (newPage) => {
            txCurrentPage = newPage;
            renderTransactions(currentTxList);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
}

