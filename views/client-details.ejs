<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>تفاصيل العميل - سجل الديون</title>
<meta name="description" content="عرض تفاصيل العميل وسجل المعاملات"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="js/tailwind-config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
<link href="css/styles.css" rel="stylesheet"/>
</head>
<body class="bg-background text-on-surface min-h-screen overflow-x-hidden">

<!-- Side Navigation (Desktop Only) -->
<%- include('partials/aside', { active: 'clients' }) %>
<!-- Main Content Canvas -->
<main class="pt-md pb-32 px-container-margin md:mr-64 min-h-screen">
<!-- TopNavBar (Mobile & Tablet) -->
<%- include('partials/header', { title: 'تفاصيل العميل' }) %>
<div class="max-w-5xl mx-auto space-y-lg" id="mainContent">
<!-- Loading State -->
<div class="flex flex-col items-center justify-center py-20 gap-md" id="loadingState">
<div style="width:40px;height:40px;border:3px solid #becabf;border-top-color:#006840;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
<span class="text-secondary">جاري تحميل بيانات العميل...</span>
</div>
<!-- Customer Profile Header (hidden until loaded) -->
<div class="hidden" id="clientContent">
<!-- Breadcrumb -->
<div class="flex items-center gap-sm flex-row mb-lg">
<a href="/clients" class="text-secondary hover:text-primary transition-colors font-body-md text-body-md">العملاء</a>
<span class="material-symbols-outlined text-outline text-sm">chevron_left</span>
<span class="font-bold text-on-surface font-body-md text-body-md" id="breadcrumbName">تفاصيل العميل</span>
</div>
<!-- Profile Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
<div class="flex items-center gap-md flex-row">
<div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center text-primary font-bold text-headline-md" id="clientInitials">--</div>
<div class="text-right">
<h2 class="font-headline-md text-headline-md text-on-surface" id="clientName">--</h2>
<p class="font-body-md text-body-md text-secondary flex items-center gap-xs justify-end">
<span id="clientPhone">--</span>
<span class="material-symbols-outlined text-sm">call</span>
</p>
</div>
</div>
<div class="flex flex-wrap gap-xs sm:gap-sm w-full md:w-auto mt-sm md:mt-0">
<a href="#" onclick="exportClientExcel(event)" id="exportExcelBtn" class="flex-1 sm:flex-none px-md py-sm border border-outline-variant bg-surface hover:bg-surface-container-high text-on-surface rounded-full font-label-md text-label-md hover:text-primary transition-all flex items-center justify-center gap-xs shadow-xs" title="تصدير كشف حساب إلى Excel">
<span class="material-symbols-outlined text-green-600 text-xl">description</span>
تصدير Excel
</a>
<a href="#" onclick="exportClientPdf(event)" id="exportPdfBtn" class="flex-1 sm:flex-none px-md py-sm border border-outline-variant bg-surface hover:bg-surface-container-high text-on-surface rounded-full font-label-md text-label-md hover:text-error transition-all flex items-center justify-center gap-xs shadow-xs" title="تصدير / طباعة كشف حساب PDF">
<span class="material-symbols-outlined text-error text-xl">picture_as_pdf</span>
تصدير PDF
</a>
<a href="#" onclick="event.preventDefault(); openInvoiceModal('payment');" class="flex-1 sm:flex-none px-md py-sm md:px-lg md:py-md bg-green-600 text-white rounded-full font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm hover:opacity-90 transition-all flex items-center justify-center gap-xs shadow-sm">
<span class="material-symbols-outlined text-xl md:text-2xl">payments</span>
تسديد دفعة
</a>
<a href="#" onclick="event.preventDefault(); openInvoiceModal('purchase');" class="flex-1 sm:flex-none px-md py-sm md:px-lg md:py-md bg-primary text-on-primary rounded-full font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm hover:opacity-90 transition-all flex items-center justify-center gap-xs shadow-sm">
<span class="material-symbols-outlined text-xl md:text-2xl">add_circle</span>
+ عملية شراء
</a>
</div>
</div>
<!-- Bento Layout -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-md">
<!-- Outstanding Balance Card -->
<div class="md:col-span-2 bg-white rounded-xl border border-outline-variant p-lg shadow-sm flex flex-col justify-between relative overflow-hidden">
<div class="absolute -left-8 -top-8 w-32 h-32 bg-primary/5 rounded-full blur-3xl"></div>
<div class="relative z-10">
<div class="flex justify-between items-start mb-lg">
<div class="text-right">
<span class="font-label-md text-label-md text-secondary uppercase tracking-wider">الرصيد المستحق الحالي</span>
<div class="font-display-lg text-display-lg text-primary mt-xs" id="clientBalance">-- ج.م</div>
</div>
<span class="bg-error-container text-on-error-container px-md py-xs rounded-full font-label-sm text-label-sm" id="clientStatus">--</span>
</div>
<div class="grid grid-cols-2 gap-md border-t border-outline-variant pt-md">
<div>
<span class="font-label-sm text-label-sm text-secondary">آخر معاملة</span>
<p class="font-body-md text-body-md" id="clientLastTx">--</p>
</div>
<div class="text-left">
<span class="font-label-sm text-label-sm text-secondary">إجمالي المعاملات</span>
<p class="font-body-md text-body-md" id="clientTotalTx">--</p>
</div>
</div>
</div>
</div>
<!-- Quick Stats -->
<div class="bg-surface-container-high rounded-xl p-lg flex flex-col gap-md">
<h3 class="font-headline-sm text-headline-sm text-on-surface">إحصاءات سريعة</h3>
<div class="space-y-sm">
<div class="flex justify-between items-center p-sm bg-white/50 rounded-lg">
<span class="font-label-md text-label-md text-secondary">عدد العمليات</span>
<span class="font-label-md text-label-md font-bold text-on-surface" id="statTxCount">--</span>
</div>
<div class="flex justify-between items-center p-sm bg-white/50 rounded-lg">
<span class="font-label-md text-label-md text-secondary">إجمالي المشتريات</span>
<span class="font-label-md text-label-md font-bold text-on-surface" id="statPurchases">--</span>
</div>
<div class="flex justify-between items-center p-sm bg-white/50 rounded-lg">
<span class="font-label-md text-label-md text-secondary">إجمالي المدفوعات</span>
<span class="font-label-md text-label-md font-bold text-primary" id="statPayments">--</span>
</div>
</div>
</div>
</div>
<!-- End Clients Breakdown Section (computed dynamically) -->
<div id="endClientsBreakdownContainer" class="hidden bg-surface-container-high rounded-xl p-lg flex flex-col gap-md mt-lg">
    <div class="flex justify-between items-center border-b border-outline-variant pb-sm">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-primary">groups</span>
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">العملاء تحت هذا المقاول</h3>
        </div>
        <span class="bg-primary/10 text-primary font-bold px-md py-xs rounded-full font-label-sm text-label-sm" id="endClientsCountBadge">0 عملاء</span>
    </div>
    <div id="endClientsCardsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
        <!-- Rendered dynamically by renderEndClientBreakdown -->
    </div>
    <p class="text-[11px] text-secondary mt-xs">* هذه الأرقام محسوبة تقريبياً من الفواتير المحددة لكل عميل وليست رصيداً رسمياً منفصلاً.</p>
</div>

<!-- Transaction History Table -->
<div class="bg-white rounded-xl border border-outline-variant overflow-hidden shadow-sm mt-lg">
<div class="p-md border-b border-outline-variant flex flex-col sm:flex-row justify-between items-start sm:items-center gap-sm">
    <div class="flex items-center gap-xs">
        <span class="material-symbols-outlined text-primary text-xl">receipt_long</span>
        <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">سجل المعاملات</h3>
    </div>
    <div class="flex items-center gap-xs">
        <!-- Custom Tx Sort Dropdown -->
        <div class="relative" id="txSortDropdownContainer">
            <button id="txSortDropdownBtn" type="button" class="h-9 px-sm bg-surface-container-low border border-outline-variant hover:border-primary/60 focus:border-primary rounded-lg flex items-center justify-between gap-xs text-on-surface text-xs transition-all shadow-sm active:scale-98">
                <div class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-primary text-base">sort</span>
                    <span class="text-[11px] text-secondary whitespace-nowrap">الترتيب:</span>
                    <span id="txSortSelectedLabel" class="font-bold text-on-surface text-xs whitespace-nowrap">تاريخ المعاملة</span>
                </div>
                <span class="material-symbols-outlined text-outline text-base transition-transform duration-200" id="txSortDropdownArrow">expand_more</span>
            </button>
            
            <!-- Custom Dropdown Menu -->
            <div id="txSortDropdownMenu" class="hidden absolute top-[calc(100%+4px)] left-0 w-44 bg-surface border border-outline-variant/80 rounded-xl shadow-xl z-50 py-1.5 overflow-hidden transition-all duration-150 transform opacity-0 scale-95 origin-top">
                <button type="button" onclick="selectTxSortOption('date', 'تاريخ المعاملة')" class="tx-sort-option w-full px-sm py-2 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="date">
                    <span class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm text-secondary">event</span>
                        تاريخ المعاملة
                    </span>
                    <span class="material-symbols-outlined text-primary text-base font-bold tx-sort-check" id="tx-check-date">check</span>
                </button>
                <button type="button" onclick="selectTxSortOption('createdAt', 'تاريخ الإضافة')" class="tx-sort-option w-full px-sm py-2 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface" data-value="createdAt">
                    <span class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm text-secondary">schedule</span>
                        تاريخ الإضافة
                    </span>
                    <span class="material-symbols-outlined text-primary text-base font-bold tx-sort-check hidden" id="tx-check-createdAt">check</span>
                </button>
            </div>
        </div>

        <!-- Sort Direction Toggle Button -->
        <button id="txSortOrderToggle" class="h-9 w-9 flex-shrink-0 flex items-center justify-center bg-surface-container-low border border-outline-variant hover:border-primary/60 rounded-lg hover:bg-primary/5 text-primary transition-all active:scale-95 shadow-sm" title="تبديل الترتيب تصاعدي / تنازلي" type="button">
            <span class="material-symbols-outlined text-base transition-transform duration-200" id="txSortOrderIcon">arrow_upward</span>
        </button>
    </div>
</div>
<div class="overflow-x-auto w-full max-w-[100vw]">
<table class="w-full text-right border-collapse whitespace-nowrap">
<thead>
<tr class="bg-surface-container-low font-label-md text-label-md text-secondary">
<th class="px-md py-sm">التاريخ</th>
<th class="px-md py-sm">النوع</th>
<th class="px-md py-sm">الوصف</th>
<th class="px-md py-sm">العميل النهائي</th>
<th class="px-md py-sm">المبلغ</th>
<th class="px-md py-sm font-bold text-on-surface">الرصيد بعد العملية</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant" id="transactionsBody">
<tr><td colspan="6" class="p-xl text-center text-secondary">جاري التحميل...</td></tr>
</tbody>
</table>
</div>
<!-- Pagination Footer -->
<div class="px-md py-sm border-t border-outline-variant bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-sm text-xs text-secondary" id="txPaginationContainer">
    <div class="flex items-center gap-md w-full sm:w-auto justify-between sm:justify-start">
        <div class="flex items-center gap-xs">
            <span>عرض:</span>
            <!-- Custom Page Size Dropdown -->
            <div class="relative" id="txPageSizeContainer">
                <button id="txPageSizeBtn" type="button" class="h-8 px-2.5 bg-surface-container-low border border-outline-variant hover:border-primary/60 focus:border-primary rounded-lg flex items-center justify-between gap-1 text-on-surface text-xs font-bold transition-all shadow-xs active:scale-98">
                    <span id="txPageSizeLabel">10</span>
                    <span class="material-symbols-outlined text-outline text-base transition-transform duration-200" id="txPageSizeArrow">expand_less</span>
                </button>
                
                <!-- Dropdown Menu (opens upward) -->
                <div id="txPageSizeMenu" class="hidden absolute bottom-[calc(100%+4px)] right-0 w-28 bg-surface border border-outline-variant/80 rounded-xl shadow-xl z-50 py-1 overflow-hidden transition-all duration-150 transform opacity-0 scale-95 origin-bottom">
                    <button type="button" onclick="selectTxPageSize(10)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>10 سجلات</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold tx-size-check" id="tx-size-check-10">check</span>
                    </button>
                    <button type="button" onclick="selectTxPageSize(25)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>25 سجل</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold tx-size-check hidden" id="tx-size-check-25">check</span>
                    </button>
                    <button type="button" onclick="selectTxPageSize(50)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>50 سجل</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold tx-size-check hidden" id="tx-size-check-50">check</span>
                    </button>
                    <button type="button" onclick="selectTxPageSize(100)" class="w-full px-sm py-1.5 flex items-center justify-between text-xs hover:bg-primary/10 transition-colors text-right font-medium text-on-surface">
                        <span>100 سجل</span>
                        <span class="material-symbols-outlined text-primary text-base font-bold tx-size-check hidden" id="tx-size-check-100">check</span>
                    </button>
                </div>
            </div>
            <span>معاملة لكل صفحة</span>
        </div>
        <div class="text-secondary font-medium" id="txPaginationInfo">
            عرض 0 - 0 من أصل 0 معاملة
        </div>
    </div>
    <div id="txPaginationControls">
        <!-- Rendered dynamically -->
    </div>
</div>
</div>
</div>
</div>
</main>
<!-- Mobile Bottom Navigation -->
<%- include('partials/bottom-nav', { active: 'clients' }) %>

<!-- Invoice Modal -->
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="invoiceModal">
    <div class="bg-surface rounded-xl shadow-lg w-full max-w-lg max-h-[90vh] overflow-y-auto p-md md:p-xl">
        <div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
            <h2 id="modalTitle" class="font-headline-md text-headline-md font-bold text-on-surface">إضافة فاتورة جديدة</h2>
            <button class="text-secondary hover:text-on-surface" onclick="closeInvoiceModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form class="space-y-lg" id="invoiceForm" novalidate>
            <input type="hidden" id="endClientId">
            <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant mb-xs">تاريخ الفاتورة <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">calendar_today</span>
                    <input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right cursor-pointer" id="invoiceDate" type="text" placeholder="اختر التاريخ" required />
                </div>
            </div>
            <div class="flex flex-col gap-xs relative">
                <label class="font-label-md text-label-md text-on-surface-variant mb-xs">اسم العميل النهائي (اختياري)</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">person_pin</span>
                    <input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right" id="endClientName" placeholder="مثال: محمد إبراهيم (اختياري)" type="text" autocomplete="off" />
                </div>
                <!-- End Client Dropdown -->
                <div id="endClientDropdown" class="hidden absolute top-[72px] left-0 right-0 mt-1 bg-surface border border-outline-variant rounded-xl shadow-lg z-[110] max-h-[220px] overflow-y-auto custom-scrollbar">
                </div>
            </div>
            <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant mb-xs">المبلغ (جنيه) <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">payments</span>
                    <input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right font-bold text-primary" id="invoiceAmount" placeholder="0.00" type="number" step="0.01" required />
                </div>
            </div>
            <div class="flex flex-col gap-xs">
                <label id="addressLabel" class="font-label-md text-label-md text-on-surface-variant mb-xs">عنوان التوصيل</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
                    <input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right" id="deliveryAddress" placeholder="الحي، الشارع، رقم المبنى..." type="text" />
                </div>
            </div>
            <div class="flex flex-col gap-xs">
                <label id="detailsLabel" class="font-label-md text-label-md text-on-surface-variant mb-xs">التفاصيل / المشتريات</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-4 text-outline">inventory_2</span>
                    <textarea class="w-full h-24 pr-10 pl-md py-sm rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right resize-none" id="invoiceDetails" placeholder="اكتب التفاصيل..."></textarea>
                </div>
            </div>
            <div class="flex flex-row gap-sm pt-md border-t border-outline-variant mt-lg">
                <button class="flex-1 bg-surface-container-low text-on-surface rounded-full py-md font-label-md text-label-md hover:bg-surface-container transition-colors" onclick="closeInvoiceModal()" type="button">إلغاء</button>
                <button id="submitBtn" class="flex-1 bg-primary text-on-primary rounded-full py-md font-label-md text-label-md hover:opacity-90 transition-opacity" type="submit">حفظ الفاتورة</button>
            </div>
        </form>
    </div>
</div>

<!-- Transaction Details Modal -->
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="transactionDetailsModal">
    <div class="bg-surface rounded-xl shadow-lg w-full max-w-lg max-h-[90vh] overflow-y-auto p-md md:p-xl">
        <div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
            <h2 class="font-headline-md text-headline-md font-bold text-on-surface">تفاصيل المعاملة</h2>
            <button class="text-secondary hover:text-on-surface" onclick="closeTransactionDetails()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="space-y-md">
            <div class="flex justify-between border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">تاريخ المعاملة</span>
                <span class="font-body-md text-on-surface font-bold" id="tdDate"></span>
            </div>
            <div class="flex justify-between border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">العميل النهائي</span>
                <span class="font-body-md text-on-surface font-bold" id="tdEndClient"></span>
            </div>
            <div class="flex justify-between border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">نوع المعاملة</span>
                <span class="font-body-md text-on-surface font-bold" id="tdType"></span>
            </div>
            <div class="flex justify-between border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">المبلغ المستحق</span>
                <span class="font-body-md font-bold" id="tdAmount"></span>
            </div>
            <div class="flex flex-col gap-xs border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">عنوان التوصيل</span>
                <span class="font-body-md text-on-surface" id="tdAddress"></span>
            </div>
            <div class="flex flex-col gap-xs pb-xs">
                <span class="text-secondary font-label-md">التفاصيل / المشتريات</span>
                <span class="font-body-md text-on-surface whitespace-pre-wrap" id="tdNotes"></span>
            </div>
        </div>
        <div class="pt-md mt-lg text-center">
            <button class="bg-surface-container-low text-on-surface px-xl rounded-full py-sm font-label-md hover:bg-surface-container transition-colors" onclick="closeTransactionDetails()" type="button">إغلاق</button>
        </div>
    </div>
</div>
<script src="/js/shared-ui.js"></script>
<script>
// Add spinner animation
const style = document.createElement('style');
style.textContent = `@keyframes spin { to { transform: rotate(360deg); } } @keyframes fadeInRow { to { opacity: 1; transform: translateY(0); } }`;
document.head.appendChild(style);

let allClientsList = []; // For invoice form dropdown
let allEndClientsList = []; // For end client autocomplete
let clientInvoices = [];

async function loadEndClients() {
    try {
        const res = await fetch('/api/end-clients');
        const data = await res.json();
        allEndClientsList = data.data || [];
    } catch (err) {
        console.error('Failed to load end clients:', err);
