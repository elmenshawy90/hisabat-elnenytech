// Load client data from API
async function loadClientDetails(skipAuth = false) {
    if (!skipAuth) {
        const user = await checkAuth();
        if (!user) return;
        
        // Update user display names
        document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
        document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');
    }

    const clientId = getClientId();
    if (!clientId) {
        showToast('لم يتم تحديد العميل', 'error');
        setTimeout(() => window.location.href = '/clients', 1500);
        return;
    }

    // Set export links immediately
    const excelBtn = document.getElementById('exportExcelBtn');
    const pdfBtn = document.getElementById('exportPdfBtn');
    if (excelBtn) excelBtn.href = `/api/export/client/${clientId}/excel`;
    if (pdfBtn) pdfBtn.href = `/api/export/client/${clientId}/pdf`;

    try {
        const res = await fetch(`/api/clients/${clientId}`);
        if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            showToast(errData.error || 'العميل غير موجود', 'error');
            setTimeout(() => window.location.href = '/clients', 1500);
            return;
        }

        const client = await res.json();
        currentClientData = client;

        // Hide loading, show content
        document.getElementById('loadingState').classList.add('hidden');
        document.getElementById('clientContent').classList.remove('hidden');

        // Populate profile
        const initials = client.name.split(' ').slice(0, 2).map(w => w[0]).join(' ');
        document.getElementById('clientInitials').textContent = initials;
        document.getElementById('clientName').textContent = client.name;
        document.getElementById('breadcrumbName').textContent = client.name;
        document.getElementById('clientPhone').textContent = (client.phone && client.phone !== '-') ? client.phone : 'لا يوجد هاتف';
        
        const addressEl = document.getElementById('clientAddress');
        const addressContainer = document.getElementById('clientAddressContainer');
        if (addressEl && addressContainer) {
            if (client.address && client.address.trim() && client.address !== '-') {
                addressEl.textContent = client.address;
                addressContainer.classList.remove('hidden');
            } else {
                addressContainer.classList.add('hidden');
            }
        }
        
        document.title = `${client.name} - سجل الديون`;

        // Set Export links
        const excelBtn = document.getElementById('exportExcelBtn');
        const pdfBtn = document.getElementById('exportPdfBtn');
        if (excelBtn) excelBtn.href = `/api/export/client/${clientId}/excel`;
        if (pdfBtn) pdfBtn.href = `/api/export/client/${clientId}/pdf`;

        // Outstanding Balance
        const balanceEl = document.getElementById('clientBalance');
        if (balanceEl) {
            const balanceResult = formatBalanceLabel(client.balance);
            balanceEl.textContent = balanceResult.text;
            balanceEl.className = `font-display-lg text-display-lg mt-xs ${balanceResult.colorClass}`;
        }

        // Status badge
        const statusEl = document.getElementById('clientStatus');
        if (client.balance <= 0) {
            statusEl.textContent = 'مسدد';
            statusEl.className = 'bg-green-100 text-green-700 px-md py-xs rounded-full font-label-sm text-label-sm';
        } else if (client.balance > 10000) {
            statusEl.textContent = 'رصيد مرتفع';
            statusEl.className = 'bg-error-container text-on-error-container px-md py-xs rounded-full font-label-sm text-label-sm';
        } else {
            statusEl.textContent = 'نشط';
            statusEl.className = 'bg-orange-100 text-orange-700 px-md py-xs rounded-full font-label-sm text-label-sm';
        }

        // Last transaction
        document.getElementById('clientLastTx').textContent = formatDate(client.lastTransaction);

        // Invoices
        clientInvoices = client.invoices || [];
        const invoices = clientInvoices;
        document.getElementById('clientTotalTx').textContent = invoices.length + ' معاملة';
        document.getElementById('statTxCount').textContent = invoices.length;

        const totalPurchases = invoices.filter(i => i.type === 'purchase').reduce((s, i) => s + i.amount, 0);
        const totalPayments = invoices.filter(i => i.type === 'payment').reduce((s, i) => s + i.amount, 0);
        document.getElementById('statPurchases').textContent = formatCurrency(totalPurchases);
        document.getElementById('statPayments').textContent = formatCurrency(totalPayments);

        // Render breakdown by End Client and apply transaction filtering
        renderEndClientBreakdown(invoices);

        const params = new URLSearchParams(window.location.search);
        const filterParam = params.get('filterEndClient');
        if (filterParam) {
            const normParam = normalizeArabic(filterParam);
            const matchedGroup = currentEndClientGroups.find(g =>
                (g.id && String(g.id) === filterParam) ||
                (normalizeArabic(g.name) === normParam)
            );
            if (matchedGroup) {
                selectedEndClientFilter = { id: matchedGroup.id || null, name: matchedGroup.name };
            } else {
                selectedEndClientFilter = { id: null, name: filterParam };
            }
        }

        applyEndClientFilter();


    } catch (err) {
        console.error('Failed to load client:', err);
        showToast('فشل في تحميل بيانات العميل', 'error');
    }
}

let selectedEndClientFilter = null;

function renderEndClientBreakdown(invoices) {
    const container = document.getElementById('endClientsBreakdownContainer');
    const grid = document.getElementById('endClientsCardsGrid');
    const badge = document.getElementById('endClientsCountBadge');

    const activeInvoices = invoices || [];
    const taggedInvoices = activeInvoices.filter(inv => {
        const rawName = (inv.endClientName || (inv.endClient?.name || '')).trim();
        return rawName && rawName !== '-';
    }).map(inv => {
        const rawName = (inv.endClientName || (inv.endClient?.name || '')).trim();
        return {
            ...inv,
            effectiveEndClientName: rawName
        };
    });

    if (taggedInvoices.length === 0) {
        container.classList.add('hidden');
        return;
    }

    const groupsMap = new Map();

    for (const inv of taggedInvoices) {
        const name = inv.effectiveEndClientName;
        const key = inv.endClientId ? `id_${inv.endClientId}` : `name_${normalizeArabic(name)}`;
        if (!groupsMap.has(key)) {
            groupsMap.set(key, {
                id: inv.endClientId || null,
                name,
                invoiceCount: 0,
                totalPurchases: 0,
                totalPayments: 0,
                net: 0
            });
        }
        const g = groupsMap.get(key);
        if (!g.id && inv.endClientId) {
            g.id = inv.endClientId;
        }
        g.invoiceCount++;
        if (inv.type === 'purchase') {
            g.totalPurchases += (Number(inv.amount) || 0);
        } else if (inv.type === 'payment') {
            g.totalPayments += (Number(inv.amount) || 0);
        }
        g.net = g.totalPurchases - g.totalPayments;
    }

    const groups = Array.from(groupsMap.values());
    groups.sort((a, b) => b.net - a.net);
    currentEndClientGroups = groups;

    badge.textContent = `${groups.length} ${groups.length === 1 ? 'عميل' : 'عملاء'}`;

    grid.innerHTML = groups.map((item, index) => {
        const netColor = item.net <= 0 ? 'text-green-600' : 'text-tertiary';
        const isSelected = selectedEndClientFilter && (
            (selectedEndClientFilter.id && item.id && String(selectedEndClientFilter.id) === String(item.id)) ||
            (normalizeArabic(selectedEndClientFilter.name) === normalizeArabic(item.name))
        );

        const cardBorderClass = isSelected
            ? 'border-2 border-primary ring-2 ring-primary/20 bg-primary/[0.04] shadow-md'
            : 'border border-outline-variant bg-white hover:border-primary/60 hover:shadow-md';

        return `
            <div onclick="toggleEndClientFilterByIndex(${index})"
                 data-name="${normalizeArabic(item.name)}"
                 class="end-client-card w-full text-right rounded-xl p-md shadow-sm flex flex-col justify-between gap-sm transition-all active:scale-[0.99] cursor-pointer select-none ${cardBorderClass}">
                <div class="flex items-center justify-between border-b border-outline-variant/50 pb-xs">
                    <div class="flex items-center gap-xs font-bold text-on-surface font-body-md">
                        <span class="material-symbols-outlined text-primary text-lg">person_pin</span>
                        <span class="truncate max-w-[140px]" title="${item.name}">${item.name}</span>
                    </div>
                    <div class="flex items-center gap-1">
                        ${isSelected ? `<span class="bg-primary text-white text-[11px] px-2 py-0.5 rounded-full font-bold">محدد</span>` : ''}
                        <span class="bg-surface-container text-secondary text-xs px-2 py-0.5 rounded-full font-bold">${item.invoiceCount} معاملة</span>
                    </div>
                </div>
                <div class="space-y-xs text-xs">
                    <div class="flex justify-between text-secondary">
                        <span>إجمالي المشتريات:</span>
                        <span class="font-bold text-on-surface">${formatCurrency(item.totalPurchases)}</span>
                    </div>
                    <div class="flex justify-between text-secondary">
                        <span>إجمالي المدفوعات:</span>
                        <span class="font-bold text-primary">${formatCurrency(item.totalPayments)}</span>
                    </div>
                </div>
                <div class="flex justify-between items-center border-t border-outline-variant/50 pt-xs">
                    <span class="text-xs font-bold text-secondary">الاجمالي:</span>
                    <span class="font-bold text-sm ${netColor}">${formatCurrency(item.net)}</span>
                </div>
                <div class="pt-xs flex justify-end">
                    <button type="button" onclick="event.stopPropagation(); handleConvertToClientClick(${index})" class="w-full flex items-center justify-center gap-1 text-xs text-secondary hover:text-primary bg-surface-container hover:bg-primary/10 py-1.5 px-2 rounded-lg font-bold transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-sm">person_add</span>
                        <span>تحويل لعميل مستقل</span>
                    </button>
                </div>
            </div>
        `;
    }).join('');

    container.classList.remove('hidden');
    filterEndClientCards();
}

function filterEndClientCards() {
    const searchInput = document.getElementById('endClientSearchInput');
    const rawVal = searchInput ? searchInput.value : '';
    const normSearch = normalizeArabic(rawVal);
    const grid = document.getElementById('endClientsCardsGrid');
    if (!grid) return;
    const cards = grid.querySelectorAll('.end-client-card');
    cards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        if (!normSearch || name.includes(normSearch)) {
            card.classList.remove('hidden');
        } else {
            card.classList.add('hidden');
        }
    });
}


let currentEndClientGroups = [];

function toggleEndClientFilterByIndex(index) {
    const item = currentEndClientGroups[index];
    if (!item) return;
    toggleEndClientFilter(item.id, item.name);
}

function openConvertToClientModalByIndex(index) {
    handleConvertToClientClick(index);
}

function toggleEndClientFilter(id, name) {
    if (selectedEndClientFilter && (
        (id && selectedEndClientFilter.id && String(selectedEndClientFilter.id) === String(id)) ||
        (normalizeArabic(selectedEndClientFilter.name) === normalizeArabic(name))
    )) {
        selectedEndClientFilter = null;
    } else {
        selectedEndClientFilter = { id: id || null, name };
    }
    applyEndClientFilter();
}

function clearEndClientFilter() {
    selectedEndClientFilter = null;
    applyEndClientFilter();
}

function applyEndClientFilter() {
    const banner = document.getElementById('activeEndClientFilterBanner');
    const nameEl = document.getElementById('filteredEndClientName');

    if (selectedEndClientFilter) {
        if (banner) {
            banner.classList.remove('hidden');
            banner.classList.add('flex');
        }
        if (nameEl) {
            nameEl.textContent = selectedEndClientFilter.name;
        }
    } else {
        if (banner) {
            banner.classList.add('hidden');
            banner.classList.remove('flex');
        }
    }

    renderEndClientBreakdown(clientInvoices);

    let filteredInvoices = clientInvoices;
    if (selectedEndClientFilter) {
        const filterId = selectedEndClientFilter.id ? String(selectedEndClientFilter.id) : null;
        const normFilterName = normalizeArabic(selectedEndClientFilter.name);

        filteredInvoices = clientInvoices.filter(inv => {
            if (filterId && inv.endClientId) {
                return String(inv.endClientId) === filterId;
            }
            const normInvName = normalizeArabic(inv.endClientName || (inv.endClient?.name || ''));
            return normInvName === normFilterName;
        });
    }

    txCurrentPage = 1;
    renderTransactions(filteredInvoices);
}

let currentTxSortField = 'date'; // 'date' or 'createdAt'
let currentTxSortOrder = 'asc'; // oldest first

let currentTxList = [];
let txCurrentPage = 1;
let txPageSize = 10;

// Custom Transaction Page Size Dropdown Functions
function toggleTxPageSizeDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('txPageSizeMenu');
    const arrow = document.getElementById('txPageSizeArrow');
    const isHidden = menu.classList.contains('hidden');
    
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        arrow.classList.add('rotate-180');
    } else {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

function selectTxPageSize(val) {
    txPageSize = Number(val);
    document.getElementById('txPageSizeLabel').textContent = val;
    
    // Update checkmarks
    [10, 25, 50, 100].forEach(size => {
        const check = document.getElementById(`tx-size-check-${size}`);
        if (check) check.classList.toggle('hidden', size !== txPageSize);
    });
    
    // Close menu
    const menu = document.getElementById('txPageSizeMenu');
    const arrow = document.getElementById('txPageSizeArrow');
    menu.classList.add('opacity-0', 'scale-95');
    menu.classList.remove('opacity-100', 'scale-100');
    arrow.classList.remove('rotate-180');
    setTimeout(() => menu.classList.add('hidden'), 150);
    
    txCurrentPage = 1;
    renderTransactions(currentTxList);
}

document.getElementById('txPageSizeBtn').addEventListener('click', toggleTxPageSizeDropdown);

document.addEventListener('click', (e) => {
    const container = document.getElementById('txPageSizeContainer');
    if (container && !container.contains(e.target)) {
        const menu = document.getElementById('txPageSizeMenu');
        const arrow = document.getElementById('txPageSizeArrow');
        if (menu && !menu.classList.contains('hidden')) {
            menu.classList.add('opacity-0', 'scale-95');
            menu.classList.remove('opacity-100', 'scale-100');
            arrow.classList.remove('rotate-180');
            setTimeout(() => menu.classList.add('hidden'), 150);
        }
    }
});

function renderTransactions(invoices, resetPage = false) {
    currentTxList = invoices;
    if (resetPage) txCurrentPage = 1;

    const tbody = document.getElementById('transactionsBody');
    const totalRecords = invoices.length;

    if (totalRecords === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-xl text-center text-secondary">لا توجد معاملات لهذا العميل</td></tr>';
        renderPaginationControls({
            containerId: 'txPaginationControls',
            infoId: 'txPaginationInfo',
            currentPage: 1,
            pageSize: txPageSize,
            totalRecords: 0,
            unitLabel: 'معاملة',
            onPageChange: () => {}
        });
        return;
    }

    // 1. Calculate true chronological running balance (from oldest to newest)
    const chronological = [...invoices].sort((a, b) => {
        const dateA = new Date(a.date || 0).getTime();
        const dateB = new Date(b.date || 0).getTime();
        if (dateA !== dateB) return dateA - dateB;
        const createdA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
        const createdB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
        if (createdA !== createdB) return createdA - createdB;
        return (Number(a._id || a.id) || 0) - (Number(b._id || b.id) || 0);
    });

    let running = 0;
    const balanceMap = new Map();
    for (const inv of chronological) {
        const isIncrease = inv.balanceEffect === 'increase' || (!inv.balanceEffect && inv.type === 'purchase');
        if (isIncrease) {
            running += (Number(inv.amount) || 0);
        } else {
            running -= (Number(inv.amount) || 0);
        }
        const key = String(inv._id || inv.id);
        balanceMap.set(key, running);
        inv.runningBalance = running;
    }

    // 2. Apply user selected sorting
    invoices.sort((a, b) => {
        let diff = 0;
        if (currentTxSortField === 'createdAt') {
            const timeA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
            const timeB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
            diff = timeA - timeB;
        } else {
            const dateA = new Date(a.date || 0).getTime();
            const dateB = new Date(b.date || 0).getTime();
            diff = dateA - dateB;
        }

        if (diff === 0) {
            const timeA = new Date(a.createdAt || 0).getTime() || (Number(a._id || a.id) || 0);
            const timeB = new Date(b.createdAt || 0).getTime() || (Number(b._id || b.id) || 0);
            diff = timeA - timeB;
        }

        return currentTxSortOrder === 'asc' ? diff : -diff;
    });

    const totalPages = Math.ceil(totalRecords / txPageSize) || 1;
    if (txCurrentPage > totalPages) txCurrentPage = totalPages;
    if (txCurrentPage < 1) txCurrentPage = 1;

    const startIndex = (txCurrentPage - 1) * txPageSize;
    const endIndex = Math.min(startIndex + txPageSize, totalRecords);
    const pagedInvoices = invoices.slice(startIndex, endIndex);

    tbody.innerHTML = pagedInvoices.map(inv => {
        const isOpening = inv.type === 'opening_balance';
        const isPurchase = inv.type === 'purchase';
        const isIncrease = inv.balanceEffect === 'increase' || (!inv.balanceEffect && isPurchase);

        let typeBadge = '';
        if (isOpening) {
            typeBadge = '<span class="px-sm py-1 rounded-full bg-blue-100 text-blue-800 font-label-sm text-label-sm font-bold">رصيد افتتاحي</span>';
        } else if (isPurchase) {
            typeBadge = '<span class="px-sm py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm">شراء</span>';
        } else {
            typeBadge = '<span class="px-sm py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm">دفع</span>';
        }

        const amountClass = isIncrease ? 'font-bold' : 'text-primary font-bold';
        const amountPrefix = isIncrease ? '+' : '-';

        const runBal = inv.runningBalance !== undefined && inv.runningBalance !== null ? inv.runningBalance : (balanceMap.get(String(inv._id || inv.id)) ?? 0);
        const balanceBadge = runBal <= 0
            ? `<span class="text-green-600 font-bold dir-ltr inline-block">${formatCurrency(runBal)}</span>`
            : `<span class="text-primary font-bold dir-ltr inline-block">${formatCurrency(runBal)}</span>`;

        return `
            <tr class="cursor-pointer transition-colors group hover:bg-primary/5" onclick="openTransactionDetails(${inv._id})">
                <td class="px-md py-md font-body-md text-body-md">
                    <div class="flex flex-col">
                        <span>${formatDate(inv.date)}</span>
                        ${inv.invoiceCode ? `<span class="text-[11px] font-mono text-secondary font-medium">${inv.invoiceCode}</span>` : ''}
                    </div>
                </td>
                <td class="px-md py-md">${typeBadge}</td>
                <td class="px-md py-md font-body-md text-body-md">${inv.details || '-'}</td>
                <td class="px-md py-md font-body-md text-body-md text-secondary">${inv.endClientName || '-'}</td>
                <td class="px-md py-md font-body-md text-body-md ${amountClass}">${amountPrefix}${formatCurrency(inv.amount)}</td>
                <td class="px-md py-md font-body-md text-body-md">${balanceBadge}</td>
                <td class="px-md py-md text-center" onclick="event.stopPropagation()">
                    <a href="/api/export/invoice/${inv._id || inv.id}/image" target="_blank" class="p-1.5 rounded-lg hover:bg-primary/10 text-secondary hover:text-primary transition-all inline-flex items-center justify-center cursor-pointer" title="تصدير إيصال الفاتورة كصورة">
                        <span class="material-symbols-outlined text-lg">receipt_long</span>
                    </a>
                </td>
            </tr>
        `;
    }).join('');

    renderPaginationControls({
        containerId: 'txPaginationControls',
        infoId: 'txPaginationInfo',
        currentPage: txCurrentPage,
        pageSize: txPageSize,
        totalRecords: totalRecords,
        unitLabel: 'معاملة',
        onPageChange: (newPage) => {
            txCurrentPage = newPage;
            renderTransactions(currentTxList);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
}

// Custom Transaction Sort Dropdown Functions
function toggleTxSortDropdown(e) {
    e.stopPropagation();
    const menu = document.getElementById('txSortDropdownMenu');
    const arrow = document.getElementById('txSortDropdownArrow');
    const isHidden = menu.classList.contains('hidden');
    
    if (isHidden) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
        });
        arrow.classList.add('rotate-180');
    } else {
        menu.classList.add('opacity-0', 'scale-95');
        menu.classList.remove('opacity-100', 'scale-100');
        arrow.classList.remove('rotate-180');
        setTimeout(() => menu.classList.add('hidden'), 150);
    }
}

