    }
    
    try {
        const res = await fetch('/api/invoices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                client: getClientId(),
                clientName: document.getElementById('clientName').textContent,
                clientPhone: document.getElementById('clientPhone').textContent,
                endClientId: endClientId || undefined,
                endClientName: endName || undefined,
                date: date || undefined,
                amount: parseFloat(amount) || 0,
                details: details || (currentTransactionType === 'payment' ? 'سداد دفعة' : '-'),
                address: address || '-',
                type: currentTransactionType
            })
        });

        if (res.ok) {
            showToast('تم إضافة المعاملة بنجاح ✓', 'success');
            closeInvoiceModal();
            loadClientDetails();
        } else {
            const err = await res.json();
            showToast(err.error || 'فشل في حفظ المعاملة', 'error');
        }
    } catch (err) {
        showToast('حدث خطأ في الاتصال بالخادم', 'error');
    }
});

// Initialize
document.addEventListener('DOMContentLoaded', () => {
    loadClientDetails();
});
</script>
</body></html>