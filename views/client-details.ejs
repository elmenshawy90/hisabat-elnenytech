});

// End Client Auto-complete Logic
const endClientNameInput = document.getElementById('endClientName');
const endClientDropdown = document.getElementById('endClientDropdown');
const endClientIdInput = document.getElementById('endClientId');

endClientNameInput.addEventListener('input', (e) => {
    const rawVal = e.target.value || '';
    const terms = [...new Set(rawVal.trim().split(/\s+/).filter(Boolean))];

    endClientIdInput.value = '';

    if (terms.length === 0) {
        endClientDropdown.classList.add('hidden');
        return;
    }

    const scoredEndClients = [];
    for (const ec of allEndClientsList) {
        const normName = normalizeArabic(ec.name || '');
        const phone = ec.phone || '';
        let score = 0;
        for (const term of terms) {
            const normTerm = normalizeArabic(term);
            const nameMatches = normTerm && normName.includes(normTerm);
            const phoneMatches = phone && phone.includes(term);
            if (nameMatches || phoneMatches) {
                score++;
            }
        }
        if (score > 0) {
            scoredEndClients.push({ client: ec, score });
        }
    }

    scoredEndClients.sort((a, b) => b.score - a.score);
    const matches = scoredEndClients.map(item => item.client);

    if (matches.length > 0) {
        endClientDropdown.innerHTML = matches.map(ec => {
            const id = String(ec.id || ec._id);
            const safeName = (ec.name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
            return `
        <div class="px-md py-sm hover:bg-surface-container-highest cursor-pointer border-b border-outline-variant/30 last:border-0 transition-colors"
             onclick="selectEndClient('${id}', '${safeName}')">
            <div class="font-body-md text-on-surface font-bold">${highlightArabic(ec.name, rawVal)}</div>
            ${ec.phone && ec.phone !== '-' ? `<div class="font-label-sm text-secondary dir-ltr text-right">${highlightArabic(ec.phone, rawVal)}</div>` : ''}
        </div>
    `}).join('');
        endClientDropdown.classList.remove('hidden');
    } else {
        endClientDropdown.classList.add('hidden');
    }
});

function selectEndClient(id, name) {
    endClientIdInput.value = id;
    endClientNameInput.value = name;
    endClientDropdown.classList.add('hidden');
}

document.addEventListener('click', (e) => {
    if (!endClientNameInput.contains(e.target) && !endClientDropdown.contains(e.target)) {
        endClientDropdown.classList.add('hidden');
    }
});

// Form Submit
document.getElementById('invoiceForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    
    const date = document.getElementById('invoiceDate').value;
    const amount = document.getElementById('invoiceAmount').value;
    const details = document.getElementById('invoiceDetails').value.trim();
    const address = document.getElementById('deliveryAddress').value.trim();
    const endName = endClientNameInput.value.trim();
    const endClientId = endClientIdInput.value;
    
    let itemsPayload = undefined;
    let discountType = undefined;
    let discountValue = undefined;

    if (currentTransactionType === 'purchase') {
        const rows = Array.from(document.querySelectorAll('#invoiceLineRowsContainer .invoice-line-row'));

        itemsPayload = [];
        for (let i = 0; i < rows.length; i++) {
            const row = rows[i];
            const itemSelect = row.querySelector('.line-item-select');
            const unitSelect = row.querySelector('.line-unit-select');
            const qtyInput = row.querySelector('.line-qty-input');
            const priceInput = row.querySelector('.line-price-input');

            const itemId = itemSelect ? parseInt(itemSelect.value) : 0;
            const itemUnitId = unitSelect ? parseInt(unitSelect.value) : 0;
            const quantity = qtyInput ? parseFloat(qtyInput.value) || 0 : 0;
            const unitPrice = priceInput ? parseFloat(priceInput.value) || 0 : 0;

            // Skip empty rows (where no item is selected)
            if (!itemId) continue;

            if (!itemUnitId || quantity <= 0) {
                showToast(`الرجاء استكمال بيانات الوحدة والكمية للبند رقم ${i + 1}`, 'warning');
                return;
            }

            itemsPayload.push({ itemId, itemUnitId, quantity, unitPrice });
        }

        if (itemsPayload.length === 0) {
            showToast('يجب إدخال بند واحد على الأقل بفاتورة الشراء', 'warning');
            return;
        }

        const discountTypeRadio = document.querySelector('input[name="discountType"]:checked');
        discountType = discountTypeRadio ? discountTypeRadio.value : 'percentage';
        const discountValInput = document.getElementById('discountValue');
        discountValue = discountValInput ? parseFloat(discountValInput.value) || 0 : 0;
    } else {
        if (validateFormFields('invoiceForm')) {
            showToast('الرجاء إكمال الحقول الإجبارية', 'warning');
            return;
        }
        const payDiscountTypeRadio = document.querySelector('input[name="paymentDiscountType"]:checked');
        discountType = payDiscountTypeRadio ? payDiscountTypeRadio.value : 'percentage';
        const payDiscountValInput = document.getElementById('paymentDiscountValue');
        discountValue = payDiscountValInput ? parseFloat(payDiscountValInput.value) || 0 : 0;
    }
    
    const submitBtn = document.getElementById('submitBtn');
    const originalBtnContent = submitBtn ? submitBtn.innerHTML : '';
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري الحفظ...</span>';
    }

    try {
        const clientPhoneVal = (currentClientData && currentClientData.phone && currentClientData.phone !== '-' && currentClientData.phone !== 'لا يوجد هاتف') 
            ? currentClientData.phone 
            : undefined;

        const paidAmountVal = document.getElementById('paidAmount') ? parseFloat(document.getElementById('paidAmount').value) || 0 : 0;
        const paymentMethodVal = document.querySelector('input[name="paymentMethod"]:checked') ? document.querySelector('input[name="paymentMethod"]:checked').value : 'cash';
        const notesVal = document.getElementById('invoiceNotes') ? document.getElementById('invoiceNotes').value.trim() : '';

        const res = await fetch('/api/invoices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                client: getClientId(),
                clientName: (currentClientData && currentClientData.name) ? currentClientData.name : document.getElementById('clientName').textContent,
                clientPhone: clientPhoneVal,
                endClientId: endClientId || undefined,
                endClientName: endName || undefined,
                date: date || undefined,
                amount: parseFloat(amount) || 0,
                details: details || (currentTransactionType === 'payment' ? 'سداد دفعة' : '-'),
                address: address || '-',
                type: currentTransactionType,
                items: itemsPayload,
                discountType,
                discountValue,
                paidAmount: paidAmountVal,
                paymentMethod: paymentMethodVal,
                notes: notesVal
            })
        });

        const jsonRes = await res.json().catch(() => ({}));

        if (res.ok) {
            closeInvoiceModal();
            await loadClientDetails(true);

            if (Array.isArray(jsonRes.stockWarnings) && jsonRes.stockWarnings.length > 0) {
                const warnNames = jsonRes.stockWarnings.map(w => w.itemName).join('، ');
                showToast(`تم حفظ الفاتورة بنجاح ✓ لكن تم تجاوز المخزون المتاح في: [${warnNames}]`, 'warning');
            } else {
                showToast(currentTransactionType === 'payment' ? 'تم تسجيل الدفعة بنجاح ✓' : 'تم إضافة الفاتورة بنجاح ✓', 'success');
            }
        } else {
            const serverError = jsonRes.error || jsonRes.message || 'فشل في حفظ المعاملة';
            showToast(`خطأ في حفظ المعاملة: ${serverError}`, 'error');
        }
    } catch (err) {
        showToast(err.message ? `خطأ في الاتصال بالخادم: ${err.message}` : 'حدث خطأ في الاتصال بالخادم', 'error');
    } finally {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnContent;
        }
    }
});

// Client Edit Modal Functions
function openEditClientDetailsModal() {
    if (!currentClientData) return;
    const modal = document.getElementById('editClientModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';

    document.getElementById('editClientName').value = currentClientData.name || '';
    document.getElementById('editClientPhone').value = (currentClientData.phone && currentClientData.phone !== '-') ? currentClientData.phone : '';
    document.getElementById('editClientAddress').value = (currentClientData.address && currentClientData.address !== '-') ? currentClientData.address : '';
    
    document.getElementById('editClientPhoneError').classList.add('hidden');
    document.getElementById('editClientPhone').classList.remove('border-error');
    setTimeout(() => document.getElementById('editClientName').focus(), 50);
}

function closeEditClientModal() {
    const modal = document.getElementById('editClientModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
}

document.getElementById('editClientModal').addEventListener('click', function(e) {
    if (e.target === this) closeEditClientModal();
});

document.getElementById('editClientForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const clientId = getClientId();
    if (!clientId) return;

    const name = document.getElementById('editClientName').value.trim();
    const phone = document.getElementById('editClientPhone').value.trim();
    const address = document.getElementById('editClientAddress').value.trim();
    const phoneError = document.getElementById('editClientPhoneError');
    const phoneInput = document.getElementById('editClientPhone');

    if (!name) {
        showToast('الرجاء إدخال اسم العميل', 'warning');
        document.getElementById('editClientName').focus();
        return;
    }

    if (phone && !/^\d+$/.test(phone.replace(/\s+/g, '').replace(/\+/g, ''))) {
        phoneError.classList.remove('hidden');
        phoneInput.classList.add('border-error');
        showToast('يجب إدخال أرقام فقط في رقم الهاتف', 'error');
        phoneInput.focus();
        return;
    }

    const editSubmitBtn = document.getElementById('editClientSubmitBtn') || document.querySelector('#editClientForm button[type="submit"]');
    const originalEditBtnHtml = editSubmitBtn ? editSubmitBtn.innerHTML : 'حفظ التعديلات';
    if (editSubmitBtn) {
        editSubmitBtn.disabled = true;
        editSubmitBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري الحفظ...</span>';
    }

    try {
        const res = await fetch(`/api/clients/${clientId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name,
                phone: phone || '-',
                address: address || ''
            })
        });

        if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || 'فشل في تحديث بيانات العميل');
        }

        const updatedClient = await res.json();
        currentClientData = { ...currentClientData, ...updatedClient };

        // Update DOM immediately without reloading
        const initials = updatedClient.name.split(' ').slice(0, 2).map(w => w[0]).join(' ');
        document.getElementById('clientInitials').textContent = initials;
        document.getElementById('clientName').textContent = updatedClient.name;
        document.getElementById('breadcrumbName').textContent = updatedClient.name;
        document.getElementById('clientPhone').textContent = (updatedClient.phone && updatedClient.phone !== '-') ? updatedClient.phone : 'لا يوجد هاتف';
        
        const addressEl = document.getElementById('clientAddress');
        const addressContainer = document.getElementById('clientAddressContainer');
        if (addressEl && addressContainer) {
            if (updatedClient.address && updatedClient.address.trim() && updatedClient.address !== '-') {
                addressEl.textContent = updatedClient.address;
                addressContainer.classList.remove('hidden');
            } else {
                addressContainer.classList.add('hidden');
            }
        }
        document.title = `${updatedClient.name} - سجل الديون`;

        closeEditClientModal();
        showToast('تم تحديث بيانات العميل بنجاح ✓', 'success');
    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تحديث بيانات العميل', 'error');
    } finally {
        if (editSubmitBtn) {
            editSubmitBtn.disabled = false;
            editSubmitBtn.innerHTML = originalEditBtnHtml;
        }
    }
});

// Convert To Client Modal Logic
let pendingConvertData = null;
let currentMatchedClient = null;

async function handleConvertToClientClick(index) {
    const item = currentEndClientGroups[index];
    if (!item) return;

    pendingConvertData = {
        id: item.id || null,
        name: item.name,
        txCount: item.invoiceCount || 0,
        netAmount: item.net || 0,
        mergeWithClientId: null
    };

    try {
        const res = await fetch(`/api/end-clients/check-name-match?name=${encodeURIComponent(item.name)}`);
        const data = await res.json();

        if (res.ok && data.matches && data.matches.length > 0) {
            currentMatchedClient = data.matches[0];
            openConvertNameMatchModal(item.name, currentMatchedClient);
        } else {
            currentMatchedClient = null;
            openConvertToClientModal();
        }
    } catch (err) {
        console.error('Error checking name match:', err);
        currentMatchedClient = null;
        openConvertToClientModal();
    }
}

function openConvertNameMatchModal(endClientName, matchedClient) {
    const nameDisplay = document.getElementById('matchedClientNameDisplay');
    if (nameDisplay) nameDisplay.textContent = matchedClient.name;

    const nameBold = document.getElementById('matchedClientNameBold');
    if (nameBold) nameBold.textContent = matchedClient.name;

    const balDisplay = document.getElementById('matchedClientBalanceDisplay');
    if (balDisplay) balDisplay.textContent = formatCurrency(matchedClient.balance);

    const endNameDisplay = document.getElementById('matchedEndClientName');
    if (endNameDisplay) endNameDisplay.textContent = endClientName;

    // Reset step state
    backToChoiceStep();

    const modal = document.getElementById('convertNameMatchModal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
}

function closeConvertNameMatchModal() {
    const modal = document.getElementById('convertNameMatchModal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }
}

function showCreateSeparateClientNameInput() {
    const choiceContainer = document.getElementById('matchStepChoiceContainer');
    const inputContainer = document.getElementById('matchStepNameInputContainer');
    const nameInput = document.getElementById('newSeparateClientNameInput');

    if (choiceContainer) choiceContainer.classList.add('hidden');
    if (inputContainer) inputContainer.classList.remove('hidden');

    if (nameInput && pendingConvertData) {
        nameInput.value = pendingConvertData.name || '';
        validateNewNameInput();
        nameInput.focus();

        nameInput.oninput = validateNewNameInput;
    }
}

function backToChoiceStep() {
    const choiceContainer = document.getElementById('matchStepChoiceContainer');
    const inputContainer = document.getElementById('matchStepNameInputContainer');
    if (choiceContainer) choiceContainer.classList.remove('hidden');
    if (inputContainer) inputContainer.classList.add('hidden');
}

function validateNewNameInput() {
    const nameInput = document.getElementById('newSeparateClientNameInput');
    const confirmBtn = document.getElementById('confirmNewNameBtn');
    const hint = document.getElementById('nameInputHint');

    if (!nameInput || !confirmBtn || !pendingConvertData) return;

    const currentVal = nameInput.value.trim();
    const origNorm = normalizeArabic(pendingConvertData.name || '');
    const matchedNorm = currentMatchedClient ? normalizeArabic(currentMatchedClient.name || '') : '';
    const newNorm = normalizeArabic(currentVal);

    const isValid = newNorm.length > 0 && newNorm !== origNorm && newNorm !== matchedNorm;

    confirmBtn.disabled = !isValid;
    if (hint) {
        if (!isValid && currentVal.length > 0) {
            hint.classList.remove('hidden');
        } else {
            hint.classList.add('hidden');
        }
    }
}

function confirmNewSeparateClientName() {
    const nameInput = document.getElementById('newSeparateClientNameInput');
    if (!nameInput || !pendingConvertData) return;

    const val = nameInput.value.trim();
    if (!val) return;

    pendingConvertData.newClientName = val;
    pendingConvertData.mergeWithClientId = null;

    closeConvertNameMatchModal();
    openConvertToClientModal();
}

function chooseMergeClient() {
    if (pendingConvertData && currentMatchedClient) {
        pendingConvertData.mergeWithClientId = currentMatchedClient.id;
        pendingConvertData.newClientName = null;
    }
    closeConvertNameMatchModal();
    openConvertToClientModal();
}

function chooseCreateNewClient() {
    showCreateSeparateClientNameInput();
}

function openConvertToClientModal() {
    if (!pendingConvertData) return;

    const name = pendingConvertData.newClientName || pendingConvertData.name;
    const txCount = pendingConvertData.txCount;
    const netAmount = pendingConvertData.netAmount;

    const clientNameEl = document.getElementById('convertModalClientName');
    if (clientNameEl) clientNameEl.textContent = name || '';

    const clientNameBoldEl = document.getElementById('convertModalClientNameBold');
    if (clientNameBoldEl) clientNameBoldEl.textContent = name || '';

    const txCountEl = document.getElementById('convertModalTxCount');
    if (txCountEl) txCountEl.textContent = txCount || 0;

    const amountEl = document.getElementById('convertModalAmount');
    if (amountEl) amountEl.textContent = formatCurrency(Math.abs(netAmount || 0));

    const contractorNameEl = document.getElementById('convertModalContractorName');
    if (contractorNameEl) contractorNameEl.textContent = currentClientData?.name || 'المقاول';

    const targetAccountText = document.getElementById('convertModalTargetAccountText');
    if (targetAccountText) {
        if (pendingConvertData.mergeWithClientId && currentMatchedClient) {
            targetAccountText.textContent = `حساب ${currentMatchedClient.name} الموجود بالفعل`;
        } else if (pendingConvertData.newClientName) {
            targetAccountText.textContent = `حساب مستقل جديد باسم "${pendingConvertData.newClientName}"`;
        } else {
            targetAccountText.textContent = 'حساب مستقل جديد';
        }
    }

    const modal = document.getElementById('convertToClientModal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
}

function closeConvertToClientModal() {
    const modal = document.getElementById('convertToClientModal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }
    pendingConvertData = null;
    currentMatchedClient = null;
}

async function confirmConvertToClient() {
    if (!pendingConvertData) return;

    const confirmBtn = document.getElementById('confirmConvertBtn');
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> <span>جاري النقل...</span>';

    try {
        const endClientId = pendingConvertData.id || 0;

        const res = await fetch(`/api/end-clients/${endClientId}/convert-to-client`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                mergeWithClientId: pendingConvertData.mergeWithClientId || undefined,
                newClientName: pendingConvertData.newClientName || undefined,
                name: pendingConvertData.name,
                contractorName: currentClientData?.name || ''
            })
        });

        const data = await res.json();

        if (!res.ok) {
            throw new Error(data.error || 'فشل في نقل الفواتير وتحويل العميل');
        }

        closeConvertToClientModal();

        const targetId = data.id || data._id;
        const toastMsg = `تم نقل الفواتير بنجاح إلى "${data.name}". <a href="/client-details?id=${targetId}" class="underline font-bold mr-1">عرض صفحة العميل المستقل ←</a>`;
        showToast(toastMsg, 'success');

        await loadClientDetails();

    } catch (err) {
        console.error(err);
        showToast(err.message || 'فشل في تحويل العميل', 'error');
    } finally {
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span> <span>تأكيد النقل</span>';
    }
}

document.getElementById('convertNameMatchModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeConvertNameMatchModal();
});

document.getElementById('convertToClientModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeConvertToClientModal();
});

// Initialize
document.addEventListener('DOMContentLoaded', () => {
    loadClientDetails();
    fetchActiveItemsCatalog();
});
