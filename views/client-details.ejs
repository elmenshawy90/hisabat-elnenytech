<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>تفاصيل العميل - سجل الديون</title>
<meta name="description" content="عرض تفاصيل العميل وسجل المعاملات"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="js/tailwind-config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<link href="css/styles.css" rel="stylesheet"/>
</head>
<body class="bg-background text-on-surface min-h-screen overflow-x-hidden">

<!-- Side Navigation (Desktop Only) -->
<%- include('partials/aside', { active: 'clients' }) %>
<!-- Main Content Canvas -->
<main class="pt-md pb-32 px-container-margin md:mr-64 min-h-screen">
<!-- TopNavBar (Mobile & Tablet) -->
<%- include('partials/header', { title: 'تفاصيل العميل' }) %>
<div class="max-w-5xl mx-auto space-y-lg" id="mainContent">
<!-- Loading State -->
<div class="flex flex-col items-center justify-center py-20 gap-md" id="loadingState">
<div style="width:40px;height:40px;border:3px solid #becabf;border-top-color:#006840;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
<span class="text-secondary">جاري تحميل بيانات العميل...</span>
</div>
<!-- Customer Profile Header (hidden until loaded) -->
<div class="hidden" id="clientContent">
<!-- Breadcrumb -->
<div class="flex items-center gap-sm flex-row mb-lg">
<a href="/clients" class="text-secondary hover:text-primary transition-colors font-body-md text-body-md">العملاء</a>
<span class="material-symbols-outlined text-outline text-sm">chevron_left</span>
<span class="font-bold text-on-surface font-body-md text-body-md" id="breadcrumbName">تفاصيل العميل</span>
</div>
<!-- Profile Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
<div class="flex items-center gap-md flex-row">
<div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center text-primary font-bold text-headline-md" id="clientInitials">--</div>
<div class="text-right">
<h2 class="font-headline-md text-headline-md text-on-surface" id="clientName">--</h2>
<p class="font-body-md text-body-md text-secondary flex items-center gap-xs justify-end">
<span id="clientPhone">--</span>
<span class="material-symbols-outlined text-sm">call</span>
</p>
</div>
</div>
<div class="flex gap-sm w-full md:w-auto mt-sm md:mt-0">
<a href="#" onclick="event.preventDefault(); openInvoiceModal('payment');" class="flex-1 md:flex-none px-md py-sm md:px-lg md:py-md bg-green-600 text-white rounded-full font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm hover:opacity-90 transition-all flex items-center justify-center gap-xs shadow-sm">
<span class="material-symbols-outlined text-xl md:text-2xl">payments</span>
تسديد دفعة
</a>
<a href="#" onclick="event.preventDefault(); openInvoiceModal('purchase');" class="flex-1 md:flex-none px-md py-sm md:px-lg md:py-md bg-primary text-on-primary rounded-full font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm hover:opacity-90 transition-all flex items-center justify-center gap-xs shadow-sm">
<span class="material-symbols-outlined text-xl md:text-2xl">add_circle</span>
+ عملية شراء
</a>
<button onclick="goBack()" class="flex-1 md:flex-none px-md py-sm md:px-lg md:py-md border border-outline text-on-surface rounded-full font-label-lg text-label-lg md:font-headline-sm md:text-headline-sm hover:bg-surface-container transition-all flex items-center justify-center gap-xs shadow-sm">
<span class="material-symbols-outlined text-xl md:text-2xl">arrow_forward</span>
رجوع
</button>
</div>
</div>
<!-- Bento Layout -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-md">
<!-- Outstanding Balance Card -->
<div class="md:col-span-2 bg-white rounded-xl border border-outline-variant p-lg shadow-sm flex flex-col justify-between relative overflow-hidden">
<div class="absolute -left-8 -top-8 w-32 h-32 bg-primary/5 rounded-full blur-3xl"></div>
<div class="relative z-10">
<div class="flex justify-between items-start mb-lg">
<div class="text-right">
<span class="font-label-md text-label-md text-secondary uppercase tracking-wider">الرصيد المستحق الحالي</span>
<div class="font-display-lg text-display-lg text-primary mt-xs" id="clientBalance">-- ج.م</div>
</div>
<span class="bg-error-container text-on-error-container px-md py-xs rounded-full font-label-sm text-label-sm" id="clientStatus">--</span>
</div>
<div class="grid grid-cols-2 gap-md border-t border-outline-variant pt-md">
<div>
<span class="font-label-sm text-label-sm text-secondary">آخر معاملة</span>
<p class="font-body-md text-body-md" id="clientLastTx">--</p>
</div>
<div class="text-left">
<span class="font-label-sm text-label-sm text-secondary">إجمالي المعاملات</span>
<p class="font-body-md text-body-md" id="clientTotalTx">--</p>
</div>
</div>
</div>
</div>
<!-- Quick Stats -->
<div class="bg-surface-container-high rounded-xl p-lg flex flex-col gap-md">
<h3 class="font-headline-sm text-headline-sm text-on-surface">إحصاءات سريعة</h3>
<div class="space-y-sm">
<div class="flex justify-between items-center p-sm bg-white/50 rounded-lg">
<span class="font-label-md text-label-md text-secondary">عدد العمليات</span>
<span class="font-label-md text-label-md font-bold text-on-surface" id="statTxCount">--</span>
</div>
<div class="flex justify-between items-center p-sm bg-white/50 rounded-lg">
<span class="font-label-md text-label-md text-secondary">إجمالي المشتريات</span>
<span class="font-label-md text-label-md font-bold text-on-surface" id="statPurchases">--</span>
</div>
<div class="flex justify-between items-center p-sm bg-white/50 rounded-lg">
<span class="font-label-md text-label-md text-secondary">إجمالي المدفوعات</span>
<span class="font-label-md text-label-md font-bold text-primary" id="statPayments">--</span>
</div>
</div>
</div>
</div>
<!-- Transaction History Table -->
<div class="bg-white rounded-xl border border-outline-variant overflow-hidden shadow-sm mt-lg">
<div class="p-md border-b border-outline-variant flex justify-between items-center">
<h3 class="font-headline-sm text-headline-sm">سجل المعاملات</h3>
</div>
<div class="overflow-x-auto w-full max-w-[100vw]">
<table class="w-full text-right border-collapse whitespace-nowrap">
<thead>
<tr class="bg-surface-container-low font-label-md text-label-md text-secondary">
<th class="px-md py-sm">التاريخ</th>
<th class="px-md py-sm">النوع</th>
<th class="px-md py-sm">الوصف</th>
<th class="px-md py-sm">المبلغ</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant" id="transactionsBody">
<tr><td colspan="4" class="p-xl text-center text-secondary">جاري التحميل...</td></tr>
</tbody>
</table>
</div>
</div>
</div>
</div>
</main>
<!-- Mobile Bottom Navigation -->
<%- include('partials/bottom-nav', { active: 'clients' }) %>

<!-- Invoice Modal -->
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="invoiceModal">
    <div class="bg-surface rounded-xl shadow-lg w-full max-w-lg max-h-[90vh] overflow-y-auto p-md md:p-xl">
        <div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
            <h2 id="modalTitle" class="font-headline-md text-headline-md font-bold text-on-surface">إضافة فاتورة جديدة</h2>
            <button class="text-secondary hover:text-on-surface" onclick="closeInvoiceModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form class="space-y-lg" id="invoiceForm" novalidate>
            <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant mb-xs">تاريخ الفاتورة <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">calendar_today</span>
                    <input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right cursor-pointer" id="invoiceDate" type="date" required />
                </div>
            </div>
            <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant mb-xs">المبلغ المستحق (جنيه) <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">payments</span>
                    <input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right font-bold text-primary" id="invoiceAmount" placeholder="0.00" type="number" step="0.01" required />
                </div>
            </div>
            <div class="flex flex-col gap-xs">
                <label id="addressLabel" class="font-label-md text-label-md text-on-surface-variant mb-xs">عنوان التوصيل <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
                    <input class="w-full h-12 pr-10 pl-md rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right" id="deliveryAddress" placeholder="الحي، الشارع، رقم المبنى..." type="text" required />
                </div>
            </div>
            <div class="flex flex-col gap-xs">
                <label id="detailsLabel" class="font-label-md text-label-md text-on-surface-variant mb-xs">التفاصيل / المشتريات <span class="text-error">*</span></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute right-3 top-4 text-outline">inventory_2</span>
                    <textarea class="w-full h-24 pr-10 pl-md py-sm rounded-xl bg-surface-container-low border border-outline-variant form-input-focus transition-all text-right resize-none" id="invoiceDetails" placeholder="اكتب التفاصيل..." required></textarea>
                </div>
            </div>
            <div class="flex flex-row gap-sm pt-md border-t border-outline-variant mt-lg">
                <button class="flex-1 bg-surface-container-low text-on-surface rounded-full py-md font-label-md text-label-md hover:bg-surface-container transition-colors" onclick="closeInvoiceModal()" type="button">إلغاء</button>
                <button id="submitBtn" class="flex-1 bg-primary text-on-primary rounded-full py-md font-label-md text-label-md hover:opacity-90 transition-opacity" type="submit">حفظ الفاتورة</button>
            </div>
        </form>
    </div>
</div>

<!-- Transaction Details Modal -->
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4" id="transactionDetailsModal">
    <div class="bg-surface rounded-xl shadow-lg w-full max-w-lg max-h-[90vh] overflow-y-auto p-md md:p-xl">
        <div class="flex flex-row justify-between items-center mb-lg border-b border-outline-variant pb-sm">
            <h2 class="font-headline-md text-headline-md font-bold text-on-surface">تفاصيل المعاملة</h2>
            <button class="text-secondary hover:text-on-surface" onclick="closeTransactionDetails()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="space-y-md">
            <div class="flex justify-between border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">تاريخ المعاملة</span>
                <span class="font-body-md text-on-surface font-bold" id="tdDate"></span>
            </div>
            <div class="flex justify-between border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">نوع المعاملة</span>
                <span class="font-body-md text-on-surface font-bold" id="tdType"></span>
            </div>
            <div class="flex justify-between border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">المبلغ المستحق</span>
                <span class="font-body-md font-bold" id="tdAmount"></span>
            </div>
            <div class="flex flex-col gap-xs border-b border-outline-variant pb-xs">
                <span class="text-secondary font-label-md">عنوان التوصيل</span>
                <span class="font-body-md text-on-surface" id="tdAddress"></span>
            </div>
            <div class="flex flex-col gap-xs pb-xs">
                <span class="text-secondary font-label-md">التفاصيل / المشتريات</span>
                <span class="font-body-md text-on-surface whitespace-pre-wrap" id="tdNotes"></span>
            </div>
        </div>
        <div class="pt-md mt-lg text-center">
            <button class="bg-surface-container-low text-on-surface px-xl rounded-full py-sm font-label-md hover:bg-surface-container transition-colors" onclick="closeTransactionDetails()" type="button">إغلاق</button>
        </div>
    </div>
</div>
<script src="js/shared-ui.js"></script>
<script>
// Add spinner animation
const style = document.createElement('style');
style.textContent = `@keyframes spin { to { transform: rotate(360deg); } } @keyframes fadeInRow { to { opacity: 1; transform: translateY(0); } }`;
document.head.appendChild(style);

let allClientsList = []; // For invoice form dropdown
let clientInvoices = [];

function goBack() {
    if (window.history.length > 1) {
        window.history.back();
    } else {
        window.location.href = '/clients';
    }
}

// Get client ID from URL
function getClientId() {
    const params = new URLSearchParams(window.location.search);
    return params.get('id');
}

// Load client data from API
async function loadClientDetails() {
    const user = await checkAuth();
    if (!user) return;
    
    // Update user display names
    document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.displayName || user.username);
    document.querySelectorAll('.user-role-name').forEach(el => el.textContent = user.role === 'admin' ? 'المدير' : 'مستخدم');

    const clientId = getClientId();
    if (!clientId) {
        showToast('لم يتم تحديد العميل', 'error');
        setTimeout(() => window.location.href = '/clients', 1500);
        return;
    }

    try {
        const res = await fetch(`/api/clients/${clientId}`);
        if (!res.ok) {
            showToast('العميل غير موجود', 'error');
            setTimeout(() => window.location.href = '/clients', 1500);
            return;
        }

        const client = await res.json();

        // Hide loading, show content
        document.getElementById('loadingState').classList.add('hidden');
        document.getElementById('clientContent').classList.remove('hidden');

        // Populate profile
        const initials = client.name.split(' ').slice(0, 2).map(w => w[0]).join(' ');
        document.getElementById('clientInitials').textContent = initials;
        document.getElementById('clientName').textContent = client.name;
        document.getElementById('breadcrumbName').textContent = client.name;
        document.getElementById('clientPhone').textContent = client.phone;
        document.getElementById('clientBalance').textContent = formatCurrency(client.balance);
        document.title = `${client.name} - سجل الديون`;

        // Status badge
        const statusEl = document.getElementById('clientStatus');
        if (client.balance <= 0) {
            statusEl.textContent = 'مسدد';
            statusEl.className = 'bg-green-100 text-green-700 px-md py-xs rounded-full font-label-sm text-label-sm';
        } else if (client.balance > 10000) {
            statusEl.textContent = 'رصيد مرتفع';
            statusEl.className = 'bg-error-container text-on-error-container px-md py-xs rounded-full font-label-sm text-label-sm';
        } else {
            statusEl.textContent = 'نشط';
            statusEl.className = 'bg-orange-100 text-orange-700 px-md py-xs rounded-full font-label-sm text-label-sm';
        }

        // Last transaction
        document.getElementById('clientLastTx').textContent = formatDate(client.lastTransaction);

        // Invoices
        clientInvoices = client.invoices || [];
        const invoices = clientInvoices;
        document.getElementById('clientTotalTx').textContent = invoices.length + ' معاملة';
        document.getElementById('statTxCount').textContent = invoices.length;

        const totalPurchases = invoices.filter(i => i.type === 'purchase').reduce((s, i) => s + i.amount, 0);
        const totalPayments = invoices.filter(i => i.type === 'payment').reduce((s, i) => s + i.amount, 0);
        document.getElementById('statPurchases').textContent = formatCurrency(totalPurchases);
        document.getElementById('statPayments').textContent = formatCurrency(totalPayments);

        // Render transaction rows
        renderTransactions(invoices);

    } catch (err) {
        console.error('Failed to load client:', err);
        showToast('فشل في تحميل بيانات العميل', 'error');
    }
}

function renderTransactions(invoices) {
    const tbody = document.getElementById('transactionsBody');
    if (invoices.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="p-xl text-center text-secondary">لا توجد معاملات لهذا العميل</td></tr>';
        return;
    }

    // Sort by date descending
    invoices.sort((a, b) => new Date(b.date) - new Date(a.date));

    tbody.innerHTML = invoices.map(inv => {
        const isPurchase = inv.type === 'purchase';
        const typeBadge = isPurchase
            ? '<span class="px-sm py-1 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm">شراء</span>'
            : '<span class="px-sm py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm">دفع</span>';
        const amountClass = isPurchase ? 'font-bold' : 'text-primary font-bold';
        const amountPrefix = isPurchase ? '+' : '-';

        return `
            <tr class="cursor-pointer hover:bg-primary/5 transition-colors group" onclick="openTransactionDetails('${inv._id}')">
                <td class="px-md py-md font-body-md text-body-md">${formatDate(inv.date)}</td>
                <td class="px-md py-md">${typeBadge}</td>
                <td class="px-md py-md font-body-md text-body-md">${inv.details || '-'}</td>
                <td class="px-md py-md font-body-md text-body-md ${amountClass}">${amountPrefix}${formatCurrency(inv.amount)}</td>
            </tr>
        `;
    }).join('');
}

// Ripple effect for buttons
document.querySelectorAll('button').forEach(button => {
    button.addEventListener('mousedown', function() { this.classList.add('scale-95'); });
    button.addEventListener('mouseup', function() { this.classList.remove('scale-95'); });
    button.addEventListener('mouseleave', function() { this.classList.remove('scale-95'); });
});

// Modal Functions
function openTransactionDetails(id) {
    const inv = clientInvoices.find(i => i._id === id);
    if (!inv) return;
    
    document.getElementById('tdDate').textContent = formatDate(inv.date);
    document.getElementById('tdType').textContent = inv.type === 'payment' ? 'دفعة' : 'عملية شراء';
    
    const amountEl = document.getElementById('tdAmount');
    amountEl.textContent = formatCurrency(inv.amount);
    amountEl.className = `font-body-md font-bold ${inv.type === 'payment' ? 'text-green-600' : 'text-primary'}`;
    
    document.getElementById('tdAddress').textContent = inv.address || '-';
    document.getElementById('tdNotes').textContent = inv.details || '-';
    
    const modal = document.getElementById('transactionDetailsModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeTransactionDetails() {
    const modal = document.getElementById('transactionDetailsModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
}

document.getElementById('transactionDetailsModal').addEventListener('click', function(e) {
    if (e.target === this) closeTransactionDetails();
});

let currentTransactionType = 'purchase';

function openInvoiceModal(type = 'purchase') {
    currentTransactionType = type;
    const modal = document.getElementById('invoiceModal');
    
    // Update labels
    const title = document.getElementById('modalTitle');
    const addressLabel = document.getElementById('addressLabel');
    const detailsLabel = document.getElementById('detailsLabel');
    const submitBtn = document.getElementById('submitBtn');
    
    if (type === 'payment') {
        title.textContent = 'تسديد دفعة';
        addressLabel.innerHTML = 'المستلم / ملاحظات <span class="text-error">*</span>';
        detailsLabel.innerHTML = 'تفاصيل السداد <span class="text-error">*</span>';
        submitBtn.textContent = 'حفظ السداد';
    } else {
        title.textContent = 'إضافة فاتورة جديدة';
        addressLabel.innerHTML = 'عنوان التوصيل <span class="text-error">*</span>';
        detailsLabel.innerHTML = 'التفاصيل / المشتريات <span class="text-error">*</span>';
        submitBtn.textContent = 'حفظ الفاتورة';
    }
    
    document.getElementById('invoiceForm').reset();
    document.getElementById('invoiceDate').valueAsDate = new Date();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

function closeInvoiceModal() {
    const modal = document.getElementById('invoiceModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    document.getElementById('invoiceForm').reset();
}

document.getElementById('invoiceModal').addEventListener('click', function (e) {
    if (e.target === this) closeInvoiceModal();
});

// Form Submit
document.getElementById('invoiceForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    
    const date = document.getElementById('invoiceDate').value;
    const amount = document.getElementById('invoiceAmount').value;
    const details = document.getElementById('invoiceDetails').value.trim();
    const address = document.getElementById('deliveryAddress').value.trim();
    
    if (validateFormFields('invoiceForm')) {
        showToast('الرجاء إكمال جميع الحقول الإجبارية', 'warning');
        return;
    }
    
    try {
        const res = await fetch('/api/invoices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                client: getClientId(),
                clientName: document.getElementById('clientName').textContent,
                clientPhone: document.getElementById('clientPhone').textContent,
                date: date,
                amount: parseFloat(amount),
                details: details,
                address: address,
                type: currentTransactionType
            })
        });

        if (res.ok) {
            showToast('تم إضافة المعاملة بنجاح ✓', 'success');
            closeInvoiceModal();
            loadClientDetails();
        } else {
            const err = await res.json();
            showToast(err.error || 'فشل في حفظ المعاملة', 'error');
        }
    } catch (err) {
        showToast('حدث خطأ في الاتصال بالخادم', 'error');
    }
});

// Initialize
document.addEventListener('DOMContentLoaded', loadClientDetails);
</script>
</body></html>