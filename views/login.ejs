<%- include('partials/page-head', { title: 'تسجيل الدخول - سجل الديون', description: 'تسجيل الدخول إلى نظام سجل الديون لإدارة مواد البناء' }) %>
<body class="auth-bg">

<main class="auth-card">
    <div class="flex flex-col items-center text-center mb-6">
        <img src="/images/logo.svg" alt="سجل الديون" class="auth-logo mb-3" />
        <h1 class="text-2xl font-bold text-ink">سجل الديون</h1>
        <p class="ui-page-sub mt-1">سجّل الدخول للوصول إلى لوحة القيادة وإدارة حساباتك</p>
    </div>

    <form id="loginForm" class="space-y-4" autocomplete="on">
        <div class="text-right">
            <label for="username" class="ui-label">اسم المستخدم</label>
            <div class="relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <span class="material-symbols-outlined text-outline text-xl">person</span>
                </div>
                <input type="text" id="username" name="username" required autocomplete="username"
                    class="ui-input pr-10"
                    placeholder="أدخل اسم المستخدم">
            </div>
        </div>

        <div class="text-right">
            <label for="password" class="ui-label">كلمة المرور</label>
            <div class="relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <span class="material-symbols-outlined text-outline text-xl">lock</span>
                </div>
                <input type="password" id="password" name="password" required autocomplete="current-password"
                    class="ui-input px-10"
                    placeholder="أدخل كلمة المرور">
                <button type="button" id="togglePassword" class="absolute inset-y-0 left-0 pl-3 flex items-center text-outline hover:text-on-surface transition-colors focus:outline-none" aria-label="إظهار أو إخفاء كلمة المرور">
                    <span class="material-symbols-outlined text-xl">visibility</span>
                </button>
            </div>
        </div>

        <div id="errorMessage" class="hidden bg-error-container text-on-error-container p-3 rounded-xl text-sm text-right flex items-center gap-2 flex-row" role="alert">
            <span class="material-symbols-outlined text-lg shrink-0">error</span>
            <span id="errorText"></span>
        </div>

        <button type="submit" id="loginButton" class="ui-btn ui-btn-primary w-full !py-3">
            <span id="buttonText">تسجيل الدخول</span>
            <span id="buttonLoader" class="hidden material-symbols-outlined animate-spin text-xl">progress_activity</span>
        </button>
    </form>

    <p class="text-center text-[11px] text-muted mt-6">إدارة مواد البناء — نظام الحسابات والديون</p>
</main>

<script>
    // Toggle password visibility
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');

    togglePassword.addEventListener('click', () => {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        togglePassword.querySelector('span').textContent = type === 'password' ? 'visibility' : 'visibility_off';
    });

    // Handle form submission
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const username = document.getElementById('username').value.trim();
        const password = passwordInput.value;
        const errorDiv = document.getElementById('errorMessage');
        const errorText = document.getElementById('errorText');
        const submitBtn = document.getElementById('loginButton');
        const btnText = document.getElementById('buttonText');
        const btnLoader = document.getElementById('buttonLoader');

        // Reset state
        errorDiv.classList.add('hidden');
        submitBtn.disabled = true;
        btnText.textContent = 'جاري التحقق...';
        btnLoader.classList.remove('hidden');

        try {
            const response = await fetch('/api/auth/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ username, password })
            });

            const data = await response.json();

            if (response.ok) {
                // Success - redirect to dashboard
                btnText.textContent = 'تم بنجاح! جاري التحويل...';
                btnLoader.textContent = 'check_circle';
                btnLoader.classList.remove('animate-spin');

                setTimeout(() => {
                    window.location.href = '/dashboard';
                }, 800);
            } else {
                // Show error
                errorText.textContent = data.error || 'فشل في تسجيل الدخول';
                errorDiv.classList.remove('hidden');

                // Reset button
                submitBtn.disabled = false;
                btnText.textContent = 'تسجيل الدخول';
                btnLoader.classList.add('hidden');
                passwordInput.value = ''; // clear password on error
                passwordInput.focus();
            }
        } catch (error) {
            console.error('Error:', error);
            errorText.textContent = 'حدث خطأ في الاتصال بالخادم. تأكد من اتصالك بالإنترنت.';
            errorDiv.classList.remove('hidden');

            // Reset button
            submitBtn.disabled = false;
            btnText.textContent = 'تسجيل الدخول';
            btnLoader.classList.add('hidden');
        }
    });

    // Check if already logged in
    window.addEventListener('DOMContentLoaded', async () => {
        try {
            const res = await fetch('/api/auth/me');
            if (res.ok) {
                const data = await res.json();
                if (data.authenticated) {
                    window.location.href = '/dashboard';
                }
            }
        } catch (e) {
            console.log('Not authenticated');
        }
    });
</script>
</body>
</html>
