// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                    Int      @id @default(autoincrement())
  username              String   @unique
  password              String
  displayName           String   @default("مستخدم")
  role                  String   @default("user") // 'admin' or 'user'
  failedLoginAttempts   Int      @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Client {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String
  address     String    @default("")
  notes       String    @default("")
  pageNumber  Int?      @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]

  @@index([name])
  @@index([phone])
}

model EndClient {
  id                  Int       @id @default(autoincrement())
  name                String
  phone               String    @default("-")
  address             String    @default("")
  notes               String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invoices            Invoice[]

  @@index([name])
  @@index([phone])
}

model Invoice {
  id                Int           @id @default(autoincrement())
  invoiceCode       String?       @unique
  clientId          Int
  client            Client        @relation(fields: [clientId], references: [id])
  clientName        String
  clientPhone       String        @default("")
  endClientId       Int?
  endClient         EndClient?    @relation(fields: [endClientId], references: [id])
  endClientName     String?       @default("")
  // Allowed values: 'purchase', 'payment', 'opening_balance', 'adjustment'
  type              String
  // 'increase' (عليه / مدين / يزود الدين) or 'decrease' (له / دائن / يقلل الدين)
  balanceEffect     String        @default("increase")
  amount            Float
  discountAmount    Float         @default(0)
  paidAmount        Float         @default(0)
  paymentMethod     String        @default("cash") // 'cash' or 'transfer'
  notes             String        @default("")
  details           String
  address           String
  date              DateTime      @default(now())
  status            String        @default("pending") // 'pending', 'paid', 'overdue'
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             InvoiceItem[]

  @@index([clientId])
  @@index([endClientId])
  @@index([date])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Item {
  id                  Int           @id @default(autoincrement())
  name                String        // مثال: "أسمنت مسيرة"
  notes               String        @default("")
  defaultSellingPrice Float?        // سعر البيع الافتراضي بالوحدة الأساسية للصنف
  isActive            Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  units        ItemUnit[]
  stockLogs    StockLog[]
  invoiceItems InvoiceItem[]

  @@index([name])
}

model ItemUnit {
  id             Int           @id @default(autoincrement())
  itemId         Int
  item           Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name           String        // مثال: "طن"، "شكارة"، "كيلو"
  isBaseUnit     Boolean       @default(false) // الوحدة الأساسية اللي المخزون متخزن بيها فعليًا
  conversionRate Float         // كام وحدة أساسية = 1 من الوحدة دي
  createdAt      DateTime      @default(now())
  invoiceItems   InvoiceItem[]

  @@index([itemId])
  @@unique([itemId, name])
}

model StockLog {
  id            Int      @id @default(autoincrement())
  itemId        Int
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changeType    String   // 'restock' (توريد) أو 'sale' (خصم بيع) أو 'adjustment' (تصحيح)
  quantityBase  Float    // التغيير بوحدة القياس الأساسية
  balanceAfter  Float    // رصيد المخزون بعد العملية بالوحدة الأساسية
  invoiceId     Int?     // الفاتورة المربوطة
  notes         String   @default("")
  createdAt     DateTime @default(now())

  @@index([itemId])
}

model InvoiceItem {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId        Int
  item          Item     @relation(fields: [itemId], references: [id])
  itemUnitId    Int
  itemUnit      ItemUnit @relation(fields: [itemUnitId], references: [id])
  quantity      Float    // الكمية بالوحدة المختارة
  quantityBase  Float    // الكمية محوّلة للوحدة الأساسية
  unitPrice     Float    // سعر الوحدة المختارة وقت البيع
  lineTotal     Float    // quantity * unitPrice
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([itemId])
}

model Setting {
  key   String @id
  value String
}
