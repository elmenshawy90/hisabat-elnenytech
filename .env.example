# MongoDB Connection String
# Option 1: MongoDB Atlas (cloud) — Get yours at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hisabat?retryWrites=true&w=majority

# Option 2: Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/hisabat

# Session Secret (change this to any random string)
SESSION_SECRET=hisabat-secret-change-me-2024

# Server Port
PORT=3000
