# MongoDB Connection String
# Option 1: MongoDB Atlas (cloud) — Get yours at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hisabat?retryWrites=true&w=majority

# Option 2: Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/hisabat

# Session Secret (change this to any random string)
SESSION_SECRET=hisabat-secret-change-me-2024

# Server Port
PORT=3000

# Vercel API & Status Page Integration
# Create a token at https://vercel.com/account/tokens
VERCEL_API_TOKEN=your_vercel_api_token_here
# Find Project ID in Vercel Project Settings -> General -> Project ID
VERCEL_PROJECT_ID=prj_your_project_id_here
# Optional: Find Team ID in Vercel Team Settings -> General (leave empty if personal account)
VERCEL_TEAM_ID=

